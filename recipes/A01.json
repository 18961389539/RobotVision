{
  // 示例配方一：关键点模式。cam_basler 必须在 appsettings 填写真实序列号（多台时不会自动绑第一台）。
  "cameraId": "cam_basler",
  "serialNumber": 1,
  "stationId": "",
  "angleMode": "KeyPointLine",
  "models": [ "a01_kpt.onnx" ],
  "confidence": 0.5,
  "iou": 0.7,
  // 策略专属参数收敛为子对象：旧版平铺字段（keypointIndexA 等）仍可读取（自动迁移）
  "keypoint": {
    "indexA": 0,
    "indexB": 1,
    "minConfidence": 0.3
  }
  // 光源（可选，缺省不亮灯）：取图前点亮 1 号通道 200 亮度，稳定 10ms 后取图
  // "lightControllerId": "light_none",
  // "lighting": {
  //   "channels": [ { "channel": 1, "brightness": 200 } ],
  //   "stabilizeDelayMs": 10
  // }
}
