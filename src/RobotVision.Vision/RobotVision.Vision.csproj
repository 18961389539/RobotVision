<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 纯视觉算法库：模板匹配/卡尺/SIFT/形状匹配/壳体几何，零硬件与推理会话依赖 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RobotVision.Core\RobotVision.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" />
  </ItemGroup>

  <!-- rectangle2 对外仅 RotatedRectPipeline（通用）与 LineFitRefine（LineFit 业务）；
       RotatedRectFitter/Subpixel 等为程序集内实现。其余内部成员供 Infrastructure/Teach/Tests。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="RobotVision.Infrastructure" />
    <InternalsVisibleTo Include="RobotVision.Teach" />
    <InternalsVisibleTo Include="RobotVision.Tests" />
  </ItemGroup>

</Project>
