{
  // 安全提示（默认配置仅限可信内网使用）：
  // 1) IpAddress=0.0.0.0 会监听所有网卡，任何机器可访问 TCP 端口；
  // 2) 未配置 IpWhitelist（空 = 允许所有来源），配合上述监听范围等于完全开放；
  // 3) MaxConnections 未配置（默认 0 = 不限并发连接），易被资源耗尽。
  // 生产部署建议：改为具体网卡 IP、配置白名单（如 192.168.* 或精确 IP），
  // 并在下方追加 "IpWhitelist": ["192.168.*"]、 "MaxConnections": 8 等条目。
  "IpAddress": "0.0.0.0",
  "TcpPort": 9999,
  "TimeoutMs": 5000,
  "MaxQueueDepth": 4,
  "MaxConcurrent": 2,
  "FileLogging": {
    "Enabled": true,
    "Folder": "logs",
    "RetainedDays": 30
  },
  "RecipesFolder": "recipes",
  "ModelsFolder": "models",
  "CalibrationFolder": "data/calibration",
  "FailureImage": {
    "Enabled": true,
    "Folder": "data/failures",
    "RetainedCount": 200
  },
  "Cameras": [
    {
      "Id": "cam_basler",
      "Type": "Basler",
      "DeviceId": "",
      "ExposureTimeUs": null,
      "Gain": null,
      "GrabTimeoutMs": 3000
    },
    {
      "Id": "cam_file",
      "Type": "File",
      "Folder": "data/replay"
    },
    {
      "Id": "cam_virtual",
      "Type": "Virtual",
      "Width": 1280,
      "Height": 960,
      "Pattern": "Chessboard",
      "ChessCellPx": 40,
      "IntervalMs": 0,
      "NoiseSigma": 0
    }
  ],
  "LightControllers": [
    {
      "Id": "light_none",
      "Type": "None"
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
