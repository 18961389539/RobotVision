<Application x:Class="RobotVision.WpfHost.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/TypographyAliases.xaml" />
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/TypographyOverrides.xaml" />
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/DarkPaletteResources.xaml" />
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/DarkComboBoxResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <local:InverseBoolConverter x:Key="InverseBoolConverter"
                                        xmlns:local="clr-namespace:RobotVision.WpfHost.Shared" />

            <!-- WPF-UI NavigationView 会在 Page 外包一层 DynamicScrollViewer；                 全屏图像页（相机/配方/监控等）须同时禁用外层滚动，否则参数栏内容过高时整页（含 ImageViewer）会一起滚"                 CanContentScroll=False 关闭动态滚动；VerticalScrollBarVisibility=Disabled 禁止外层滚动条与滚轮链式传递；                 设置/关于等表单页不要用 Disabled，保留整页滚动"-->
            <Style TargetType="Page" BasedOn="{StaticResource DefaultPageStyle}">
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </Style>

            <Style x:Key="AppLightTextBlockStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource AppLightTextBlockStyle}" />
            <Style TargetType="{x:Type ui:TextBlock}" BasedOn="{StaticResource AppLightTextBlockStyle}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="AppSectionTitleStyle" TargetType="{x:Type ui:TextBlock}"
                   BasedOn="{StaticResource AppLightTextBlockStyle}">
                <Setter Property="FontTypography" Value="Subtitle" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- CardExpander string Header：用 DataType 模板着色；object Header 仍由 ContentPresenter 原样呈现"-->
            <DataTemplate DataType="{x:Type sys:String}">
                <TextBlock Text="{Binding}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DataTemplate>

            <Style TargetType="{x:Type ui:CardExpander}" BasedOn="{StaticResource DefaultUiCardExpanderStyle}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AppLightTextBlockStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Style>
                                    <Style TargetType="{x:Type ui:TextBlock}" BasedOn="{StaticResource AppLightTextBlockStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== 全局 DataGrid 风格（隐式样式：所有页面表格自动生效，无需逐页修改）=====
                 BasedOn WPF-UI 主题样式，仅做可读性增强：斑马纹、行高、垂直居中、表头强化"-->

            <Style x:Key="AppDataGridStyle" TargetType="{x:Type DataGrid}"
                   BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AlternationCount" Value="2" />
                <!-- 表格主体背景/前景：WPF-UI 3.x 未覆盖 DataGrid 默认白底，这里补深色 -->
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="RowBackground" Value="Transparent" />
                <!-- 斑马纹：用主题的次级控件填充色，深浅主题下均与背景协"-->
                <Setter Property="AlternatingRowBackground"
                        Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="HorizontalGridLinesBrush"
                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource AppDataGridStyle}" />

            <Style x:Key="AppDataGridRowStyle" TargetType="{x:Type DataGridRow}"
                   BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource AppDataGridRowStyle}" />

            <Style x:Key="AppDataGridCellStyle" TargetType="{x:Type DataGridCell}"
                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="BorderThickness" Value="0" />
                <!-- 焦点格不画虚线框（选中行高亮已足够指示，虚线在暗色下很突兀"-->
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource AppDataGridCellStyle}" />

            <Style x:Key="AppDataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}"
                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource AppDataGridColumnHeaderStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
