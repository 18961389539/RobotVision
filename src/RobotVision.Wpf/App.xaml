<Application x:Class="RobotVision.WpfHost.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <local:InverseBoolConverter x:Key="InverseBoolConverter"
                                        xmlns:local="clr-namespace:RobotVision.WpfHost.Shared" />

            <!-- WPF-UI NavigationView 会在 Page 外包一层 DynamicScrollViewer。
                 全屏图像页（相机/配方/监控等）须同时禁用外层滚动，否则参数栏内容过高时整页（含 ImageViewer）会一起滚。
                 CanContentScroll=False 关闭动态滚动；VerticalScrollBarVisibility=Disabled 禁止外层滚动条与滚轮链式传递。
                 设置/关于等表单页不要设 Disabled，保留整页滚动。 -->
            <Style TargetType="Page">
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </Style>

            <!-- 原生 TextBlock 默认前景为黑色（WPF-UI 主题只作用于 ui:TextBlock）。
                 应用级隐式样式统一为浅色；元素上已写 Foreground 的不受影响
                 （色块徽标深色字、图像 HUD 白字、次级/三级说明文字等）。 -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- ===== 全局 DataGrid 风格（隐式样式：所有页面表格自动生效，无需逐页修改） =====
                 BasedOn WPF-UI 主题样式，仅做可读性增强：斑马纹、行高、垂直居中、表头强化。 -->

            <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AlternationCount" Value="2" />
                <!-- 表格主体背景/前景：WPF-UI 3.x 未覆盖 DataGrid 默认白底，这里补深色 -->
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="RowBackground" Value="Transparent" />
                <!-- 斑马纹：用主题的次级控件填充色，深浅主题下均与背景协调 -->
                <Setter Property="AlternatingRowBackground"
                        Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="HorizontalGridLinesBrush"
                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="BorderThickness" Value="0" />
                <!-- 焦点格不画虚线框（选中行高亮已足够指示，虚线在暗色下很突兀） -->
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>

            <Style TargetType="{x:Type DataGridColumnHeader}"
                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <!-- ToolTip：系统默认是 InfoBrush 浅色底。本应用 TextBlock 已统一浅色字，
                 浅底+浅字看不清；WPF-UI 暗色主题也不覆盖 Popup 铬。必须用不透明深色底板替换模板。 -->
            <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource {x:Type ToolTip}}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="#FF2D2D2D" />
                <Setter Property="Foreground" Value="#FFF3F3F3" />
                <Setter Property="BorderBrush" Value="#FF5C5C5C" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MaxWidth" Value="420" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
                <Setter Property="ToolTipService.ShowDuration" Value="10000" />
                <Setter Property="ToolTipService.Placement" Value="MousePoint" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolTip}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFF3F3F3" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="TextAlignment" Value="Left" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
