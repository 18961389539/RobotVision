<Page x:Class="RobotVision.WpfHost.Features.Calibration.CalibrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      xmlns:calibration="clr-namespace:RobotVision.WpfHost.Features.Calibration"
      Title="标定档案"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <host:StringToVisibilityConverter x:Key="NonEmptyToVisibilityConverter" />
    </Page.Resources>
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Page.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="BodyStrong" Text="标定档案（启动时从 data/calibration 加载"
                              VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="2" Content="刷新" ToolTip="F5" Command="{Binding RefreshCommand}" />
                <ui:Button Grid.Column="3" Content="打开标定目录" Margin="8,0,0,0"
                           Command="{Binding OpenFolderCommand}" />
            </Grid>
        </ui:Card>

        <!-- 方案 A：三类档案 TabControl + 卡片流（替代 DataGrid，天然深色） -->
        <TabControl Grid.Row="1">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="内参" />
                        <TextBlock Text="{Binding Intrinsics.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding Intrinsics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="230" Margin="0,0,8,8" Padding="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <ui:TextBlock Grid.Column="1" Text="{Binding CameraId}" FontTypography="BodyStrong"
                                                          TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                                          VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Quality}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.AppBadgeText}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Resolution}" FontSize="11" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                            <Run Text="畸变: " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Distortion, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="RMS " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Rms, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CalibratedAt}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:Button Content="删除" FontSize="11" Padding="8,3" Margin="0,8,0,0"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.DeleteIntrinsicCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding CameraId}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="外参" />
                        <TextBlock Text="{Binding Extrinsics.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding Extrinsics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="260" Margin="0,0,8,8" Padding="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <ui:TextBlock Grid.Column="1" Text="{Binding StationId}" FontTypography="BodyStrong"
                                                          TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                                          VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Quality}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.AppBadgeText}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock FontSize="11" Margin="0,6,0,0">
                                            <Run Text="相机 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding CameraId, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="仿射 " />
                                            <Run Text="{Binding AffineRow0, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="     " />
                                            <Run Text="{Binding AffineRow1, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,4,0,0">
                                            <Run Text="RMS " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Rms, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · 最大残差 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding MaxResidual, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CalibratedAt}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:Button Content="删除" FontSize="11" Padding="8,3" Margin="0,8,0,0"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.DeleteExtrinsicCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding StationId}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="旋转中心" />
                        <TextBlock Text="{Binding RotationCenters.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding RotationCenters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250" Margin="0,0,8,8" Padding="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <ui:TextBlock Grid.Column="1" Text="{Binding StationId}" FontTypography="BodyStrong"
                                                          TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                                          VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Quality}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.AppBadgeText}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock FontSize="11" Margin="0,6,0,0">
                                            <Run Text="相机 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding CameraId, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="轴心 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Center, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="半径 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Radius, Mode=OneWay}" />
                                            <Run Text=" · RMS " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Rms, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="轴比 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding AxisRatio, Mode=OneWay}" />
                                            <Run Text=" · 点数 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding PointCount, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CalibratedAt}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:Button Content="删除" FontSize="11" Padding="8,3" Margin="0,8,0,0"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.DeleteRotationCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding StationId}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="多项式" />
                        <TextBlock Text="{Binding Polynomials.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding Polynomials}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="260" Margin="0,0,8,8" Padding="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <ui:TextBlock Grid.Column="1" Text="{Binding StationId}" FontTypography="BodyStrong"
                                                          TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                                          VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Quality}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.AppBadgeText}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock FontSize="11" Margin="0,6,0,0">
                                            <Run Text="相机 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding CameraId, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="分辨率" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Resolution, Mode=OneWay}" />
                                            <Run Text=" · " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Order, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="坐标 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Space, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,4,0,0">
                                            <Run Text="RMS " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Rms, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · 最大残差 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding MaxResidual, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CalibratedAt}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:Button Content="删除" FontSize="11" Padding="8,3" Margin="0,8,0,0"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.DeletePolynomialCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding StationId}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="比例" />
                        <TextBlock Text="{Binding Scales.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <calibration:CalibrationScaleWorkspace />
            </TabItem>
        </TabControl>
    </Grid>
</Page>
