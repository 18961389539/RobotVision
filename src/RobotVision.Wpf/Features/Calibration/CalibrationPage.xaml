<Page x:Class="RobotVision.WpfHost.Features.Calibration.CalibrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="标定档案"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <host:StringToVisibilityConverter x:Key="NonEmptyToVisibilityConverter" />
    </Page.Resources>
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Page.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="BodyStrong" Text="标定档案（启动时从 data/calibration 加载）"
                              VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="2" Content="刷新" ToolTip="F5" Command="{Binding RefreshCommand}" />
                <ui:Button Grid.Column="3" Content="打开标定目录" Margin="8,0,0,0"
                           Command="{Binding OpenFolderCommand}" />
            </Grid>
        </ui:Card>

        <!-- 方案 A：三类档案 TabControl + 卡片流（替代 DataGrid，天然深色） -->
        <TabControl Grid.Row="1">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="内参" />
                        <TextBlock Text="{Binding Intrinsics.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding Intrinsics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="230" Margin="0,0,8,8" Padding="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <ui:TextBlock Grid.Column="1" Text="{Binding CameraId}" FontTypography="BodyStrong"
                                                          TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                                          VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Quality}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#0D1117" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Resolution}" FontSize="11" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                            <Run Text="畸变: " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Distortion}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="RMS " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Rms}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CalibratedAt}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:Button Content="删除" FontSize="11" Padding="8,3" Margin="0,8,0,0"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.DeleteIntrinsicCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding CameraId}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="外参" />
                        <TextBlock Text="{Binding Extrinsics.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding Extrinsics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="260" Margin="0,0,8,8" Padding="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <ui:TextBlock Grid.Column="1" Text="{Binding StationId}" FontTypography="BodyStrong"
                                                          TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                                          VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Quality}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#0D1117" />
                                            </Border>
                                        </Grid>
                                        <TextBlock FontSize="11" Margin="0,6,0,0">
                                            <Run Text="相机 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding CameraId}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="仿射 " />
                                            <Run Text="{Binding AffineRow0}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="     " />
                                            <Run Text="{Binding AffineRow1}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,4,0,0">
                                            <Run Text="RMS " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Rms}" FontWeight="SemiBold" />
                                            <Run Text=" · 最大残差 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding MaxResidual}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CalibratedAt}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:Button Content="删除" FontSize="11" Padding="8,3" Margin="0,8,0,0"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.DeleteExtrinsicCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding StationId}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="旋转中心" />
                        <TextBlock Text="{Binding RotationCenters.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding RotationCenters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250" Margin="0,0,8,8" Padding="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <ui:TextBlock Grid.Column="1" Text="{Binding StationId}" FontTypography="BodyStrong"
                                                          TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                                          VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Quality}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#0D1117" />
                                            </Border>
                                        </Grid>
                                        <TextBlock FontSize="11" Margin="0,6,0,0">
                                            <Run Text="相机 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding CameraId}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="轴心 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Center}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="半径 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Radius}" />
                                            <Run Text=" · RMS " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Rms}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="轴比 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding AxisRatio}" />
                                            <Run Text=" · 点数 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding PointCount}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CalibratedAt}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:Button Content="删除" FontSize="11" Padding="8,3" Margin="0,8,0,0"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.DeleteRotationCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding StationId}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="多项式" />
                        <TextBlock Text="{Binding Polynomials.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding Polynomials}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="260" Margin="0,0,8,8" Padding="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <ui:TextBlock Grid.Column="1" Text="{Binding StationId}" FontTypography="BodyStrong"
                                                          TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                                          VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Quality}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#0D1117" />
                                            </Border>
                                        </Grid>
                                        <TextBlock FontSize="11" Margin="0,6,0,0">
                                            <Run Text="相机 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding CameraId}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="分辨率 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Resolution}" />
                                            <Run Text=" · " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Order}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="坐标 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Space}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,4,0,0">
                                            <Run Text="RMS " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding Rms}" FontWeight="SemiBold" />
                                            <Run Text=" · 最大残差 " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Run Text="{Binding MaxResidual}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding CalibratedAt}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:Button Content="删除" FontSize="11" Padding="8,3" Margin="0,8,0,0"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.DeletePolynomialCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding StationId}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="比例" />
                        <TextBlock Text="{Binding Scales.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,4,0,0">
                    <!-- 主导图像区：取图后全屏预览，便于量像素填换算助手 -->
                    <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <ivc:ImageViewer ImageSource="{Binding ScalePreviewImage}" />
                            <Border Background="#66000000" CornerRadius="3" Padding="6,2" Margin="10,10,10,10"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="10"
                                    Visibility="{Binding ScalePreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding ScalePreviewCaption}" FontSize="11" Foreground="White" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,12,10,10"
                                    Background="#66000000" CornerRadius="3" Padding="8,4" Panel.ZIndex="10"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScaleParamPanelVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ScaleFormMessage}" FontSize="11" Foreground="White"
                                           MaxWidth="360" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ScaleFormMessage}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 列表收起时重新打开 -->
                    <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                            Content="比例档案" Padding="14,8" FontWeight="SemiBold" Panel.ZIndex="30"
                            Command="{Binding ToggleScaleListPanelCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScaleListPanelVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 左：比例档案列表（浮动窄栏，可折叠） -->
                    <Border Width="220" Margin="12" VerticalAlignment="Top" MaxHeight="640" Panel.ZIndex="20"
                            HorizontalAlignment="Left" Background="#F01E2836"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding IsScaleListPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MaxHeight="480" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="10,10,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="比例档案" FontTypography="BodyStrong" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="刷新" Padding="8,3" FontSize="11" ToolTip="F5"
                                           Command="{Binding RefreshCommand}" />
                                <Button Grid.Column="2" Content="收起" Padding="10,4" FontSize="12" Margin="6,0,0,0"
                                        Command="{Binding ToggleScaleListPanelCommand}" />
                            </Grid>
                            <ListBox Grid.Row="1" Margin="4,0,4,4" ItemsSource="{Binding Scales}"
                                     SelectedItem="{Binding SelectedScale}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2" Width="178">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock Text="{Binding StationId, Mode=OneWay}" FontTypography="BodyStrong"
                                                              TextTrimming="CharacterEllipsis" />
                                                <Border Margin="6,2,0,0" Padding="4,1" CornerRadius="3"
                                                        Background="{DynamicResource SystemFillColorSuccessBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Quality, Mode=OneWay}" Value="近似">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Quality, Mode=OneWay}" FontSize="9"
                                                               Foreground="#0D1117" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="10" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <Run Text="{Binding CameraId, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding ScaleX, Mode=OneWay, StringFormat={}{0:0.######}}" />
                                                <Run Text="/" />
                                                <Run Text="{Binding ScaleY, Mode=OneWay, StringFormat={}{0:0.######}}" />
                                                <Run Text=" mm/px" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="10,4,10,10">
                                <ui:Button Content="打开标定目录" Padding="8,4" FontSize="11"
                                           Command="{Binding OpenFolderCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 参数收起时重新打开 -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                            Content="参数" Padding="14,8" FontWeight="SemiBold" Panel.ZIndex="30"
                            Command="{Binding ToggleScaleParamPanelCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScaleParamPanelVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 右：比例录入参数（浮动面板 428px，可折叠） -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="428" Margin="12"
                            Panel.ZIndex="20" ClipToBounds="True" Background="#F01E2836"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding IsScaleParamPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="12,12,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="比例标定" FontTypography="BodyStrong" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="收起" Padding="10,4" FontSize="12"
                                        Command="{Binding ToggleScaleParamPanelCommand}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,12,8"
                                          host:ViewportPageLayout.IsolateWheel="True">
                                <StackPanel>
                                    <TextBlock FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="像素 → 毫米线性比例 (mm/px)。取图后在画面上量像素，配合换算助手录入；保存后即时热加载。" />
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="工位 Id" Margin="0,0,0,4" FontSize="12" />
                                            <ui:TextBox Text="{Binding ScaleStationId, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="与配方/外参同名的工位标识" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="相机" Margin="0,0,0,4" FontSize="12" />
                                            <ComboBox ItemsSource="{Binding CameraOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding ScaleCameraId}"
                                                      ToolTip="录入比例所用的相机" />
                                            <TextBlock Text="{Binding ScaleCameraGrabHint}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding ScaleCameraGrabHint,
                                                           Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="分辨率宽 (px)" Margin="0,0,0,4" FontSize="12" />
                                            <ui:NumberBox Value="{Binding ScaleWidth}" Minimum="0" Maximum="65535"
                                                          SmallChange="1" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="分辨率高 (px)" Margin="0,0,0,4" FontSize="12" />
                                            <ui:NumberBox Value="{Binding ScaleHeight}" Minimum="0" Maximum="65535"
                                                          SmallChange="1" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:Button Content="取图显示" Command="{Binding GrabScalePreviewCommand}"
                                                   IsEnabled="{Binding CanUseScaleGrab}"
                                                   ToolTip="取一帧显示在主画面，并同步填入宽高" />
                                        <ui:Button Content="仅读分辨率" Margin="6,0,0,0"
                                                   Command="{Binding ReadCameraResolutionCommand}"
                                                   IsEnabled="{Binding CanUseScaleGrab}"
                                                   ToolTip="只填宽高，不刷新主画面" />
                                    </StackPanel>
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="X 比例 (mm/px)" Margin="0,0,0,4" FontSize="12" />
                                            <ui:NumberBox Value="{Binding ScaleX}" Minimum="0" Maximum="1000"
                                                          SmallChange="0.001" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Y 比例 (mm/px)" Margin="0,0,0,4" FontSize="12" />
                                            <ui:NumberBox Value="{Binding ScaleY}" Minimum="0" Maximum="1000"
                                                          SmallChange="0.001" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4"
                                            Padding="10,8" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="换算助手：物长 mm ÷ 图上 px = 比例" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <ui:NumberBox Value="{Binding RefLengthMm}" Minimum="0" Maximum="100000"
                                                              SmallChange="0.1" SpinButtonPlacementMode="Compact"
                                                              MinWidth="80" ToolTip="参考物实际长度 (mm)" />
                                                <ui:NumberBox Value="{Binding RefLengthPx}" Minimum="0" Maximum="100000"
                                                              SmallChange="1" SpinButtonPlacementMode="Compact"
                                                              MinWidth="80" Margin="6,0,0,0" ToolTip="图上像素长度" />
                                                <ui:Button Content="→ X" Padding="8,3" Margin="6,0,0,0"
                                                           Command="{Binding ApplyRefToXCommand}" />
                                                <ui:Button Content="→ Y" Padding="8,3" Margin="6,0,0,0"
                                                           Command="{Binding ApplyRefToYCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Margin="12,0,12,12">
                                <TextBlock Text="{Binding ScaleFormMessage}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScaleFormMessageIsError}" Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Content="删除" Command="{Binding DeleteCurrentScaleCommand}" />
                                    <ui:Button Grid.Column="2" Content="保存比例档案" Appearance="Primary"
                                               Command="{Binding SaveScaleCommand}"
                                               ToolTip="写入 {工位}.scale.json 并热加载" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
