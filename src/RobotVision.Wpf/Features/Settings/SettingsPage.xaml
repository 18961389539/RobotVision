<Page x:Class="RobotVision.WpfHost.Features.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="服务设置"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <host:FieldErrorBrushConverter x:Key="FieldErrorBrush" />
        <host:BoolToControlAppearanceConverter x:Key="DirtyToAppearance" />

        <!-- 生效方式徽章（组标题右侧）：保存后生效 -->
        <Style x:Key="HotBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>

        <!-- 需重启标注（字段标签旁）：琥珀小字 -->
        <Style x:Key="RestartHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <!-- 字段标签：默认主文本色；命中当前出错字段时由 FieldErrorBrush 转错误红 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 分组锚点：长页面（10 张卡片）里快速跳转，并提示哪几组有未保存改动 / 校验错误 -->
            <Border Grid.Column="0" Width="146" Margin="0,0,8,0" Padding="6"
                    VerticalAlignment="Top"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="分组" FontSize="11" Margin="6,2,0,6"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ListBox x:Name="AnchorList"
                             ItemsSource="{Binding Anchors}"
                             SelectedItem="{Binding SelectedAnchor, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnAnchorSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- 黄点 = 该组有未保存改动；红点 = 该组有校验错误（优先显示红点） -->
                                    <Ellipse Grid.Column="1" Width="7" Height="7" Margin="6,0,0,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="ToolTip" Value="该分组有未保存的改动" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        <Setter Property="ToolTip" Value="该分组有未通过校验的项" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="900">
                    <!-- 界面外观 -->
                    <ui:CardExpander x:Name="anchor_appearance" Padding="12" Margin="0,0,0,8"
                                     IsExpanded="{Binding IsAppearanceExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="界面外观" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="切换后立即预览；与其它参数一并「保存并应用」写入 appsettings"
                                       FontSize="11" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="颜色主题" Margin="0,0,0,4" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding UiThemeChoices}"
                                          SelectedValuePath="Key"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding UiTheme, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 工位数据目录（只读） -->
                    <ui:Card Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <ui:TextBlock FontTypography="Subtitle"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Text="工位数据目录" Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="配方、标定、回放图、失败图、结果库写在此根下，不跟编译输出走。改 appsettings.json 的 DataRoot 后须重启。模型仍在程序目录 models。" />
                            <TextBlock Text="{Binding DataRootPath}" FontSize="12" TextWrapping="Wrap" />
                            <ui:Button Content="打开数据根目录" Padding="10,3" FontSize="11" Margin="0,8,0,0"
                                       HorizontalAlignment="Left" Command="{Binding OpenDataRootCommand}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- 服务状态（常驻不折叠） -->
                    <ui:Card Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="服务状态" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="2" Content="重新载入" ToolTip="丢弃未保存的编辑，回到运行时当前值"
                                           Command="{Binding ReloadCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- 运行参数 -->
                    <ui:CardExpander x:Name="anchor_runparams" Padding="12" Margin="0,0,0,8"
                                     IsExpanded="{Binding IsRunParamsExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="运行参数" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="单次 TRIGGER 总超时（ms）" Style="{StaticResource FieldLabel}"
                                               Foreground="{Binding [RequestTimeoutMs], Converter={StaticResource FieldErrorBrush}}" />
                                    <ui:NumberBox Value="{Binding RequestTimeoutMs}" Minimum="90000" Maximum="600000"
                                                  SmallChange="1000" SpinButtonPlacementMode="Inline"
                                                  ToolTip="须大于相机取图超时（默认 60s）。启动时低于 90s 会被抬到 90s" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="连接空闲超时（ms，0 = 永久）" Style="{StaticResource FieldLabel}"
                                               Foreground="{Binding [IdleTimeoutMs], Converter={StaticResource FieldErrorBrush}}" />
                                    <ui:NumberBox Value="{Binding IdleTimeoutMs}" Minimum="0" Maximum="2592000000.0"
                                                  SmallChange="1000" SpinButtonPlacementMode="Inline"
                                                  ToolTip="0 = PLC 节拍间隙不断开；需要回收死连接可设 30 天。半开连接仍由 KeepAlive 探测" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <ui:Button Content="永久" Appearance="Secondary" FontSize="11"
                                                   Command="{Binding SetIdleNeverCommand}" />
                                        <ui:Button Content="30 天" Appearance="Secondary" FontSize="11" Margin="8,0,0,0"
                                                   Command="{Binding SetIdleThirtyDaysCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="推理队列深度（含执行中）" Style="{StaticResource FieldLabel}"
                                               Foreground="{Binding [MaxQueueDepth], Converter={StaticResource FieldErrorBrush}}" />
                                    <ui:NumberBox Value="{Binding MaxQueueDepth}" Minimum="1" Maximum="64"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="并发执行上限（管线工位）" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [MaxConcurrent], Converter={StaticResource FieldErrorBrush}}" />
                                        <TextBlock Style="{StaticResource RestartHint}" Text="需重启" />
                                    </StackPanel>
                                    <ui:NumberBox Value="{Binding MaxConcurrent}" Minimum="1" Maximum="64"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline"
                                                  ToolTip="同时进入取图/推理的任务数；取图按相机串行、推理按模型串行。首次请求后生效，改动需重启程序" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="监听 backlog（1–1024，默认 16）" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [TcpBacklog], Converter={StaticResource FieldErrorBrush}}" />
                                        <TextBlock Style="{StaticResource RestartHint}" Text="需重启" />
                                    </StackPanel>
                                    <ui:NumberBox Value="{Binding TcpBacklog}" Minimum="1" Maximum="1024"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline"
                                                  ToolTip="内核排队待 accept 的连接数；监听启动时读取，改动需重启程序生效" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="并发连接上限（0 = 不限）" Style="{StaticResource FieldLabel}"
                                               Foreground="{Binding [MaxConnections], Converter={StaticResource FieldErrorBrush}}" />
                                    <ui:NumberBox Value="{Binding MaxConnections}" Minimum="0" Maximum="64"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="推理 Provider" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [InferenceProvider], Converter={StaticResource FieldErrorBrush}}" />
                                        <TextBlock Style="{StaticResource RestartHint}" Text="需重启" />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding InferenceProviderOptions}"
                                              SelectedItem="{Binding InferenceProvider}"
                                              ToolTip="OpenVinoGpu：Intel 核显（失败时自动回退 CPU）；OpenVinoCpu：直连 CPU" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="模型会话 LRU 上限（0 = 不限制）" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [InferenceMaxSessions], Converter={StaticResource FieldErrorBrush}}" />
                                        <TextBlock Style="{StaticResource RestartHint}" Text="需重启" />
                                    </StackPanel>
                                    <ui:NumberBox Value="{Binding InferenceMaxSessions}" Minimum="0" Maximum="64"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding InferenceStatus}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap"
                                          Text="GPU 不可用时运行期会自动回退 OpenVINO CPU 并打警告；改 Provider 或会话上限须重启后重新加载模型" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 末端相机拍照位姿校验（1012/1014） -->
                    <ui:CardExpander x:Name="anchor_pose" Padding="12" Margin="0,0,0,8"
                                     IsExpanded="{Binding IsPoseExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="拍照位姿校验（OnArm）" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <ui:ToggleSwitch Content="启用位姿校验（正式产线应开启）"
                                             IsChecked="{Binding PoseCheckEnabled}" />
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding ShowPoseToleranceFields,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="XY 容差（mm）" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [PoseTolerance], Converter={StaticResource FieldErrorBrush}}" />
                                        <ui:NumberBox Value="{Binding PoseXyToleranceMm}" Minimum="0.01" Maximum="50"
                                                      SmallChange="0.1" SpinButtonPlacementMode="Inline" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="RZ 容差（°）" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [PoseTolerance], Converter={StaticResource FieldErrorBrush}}" />
                                        <ui:NumberBox Value="{Binding PoseRzToleranceDeg}" Minimum="0.01" Maximum="45"
                                                      SmallChange="0.1" SpinButtonPlacementMode="Inline" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap" Margin="0,4,0,0">
                                <ui:TextBlock.Style>
                                    <Style TargetType="ui:TextBlock" BasedOn="{StaticResource {x:Type ui:TextBlock}}">
                                        <Setter Property="Text"
                                                Value="末端相机工位：未上报 X,Y,RZ 返回 1014；超容差返回 1012。关闭后两项均不拦截（仅调试）" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PoseCheckEnabled}" Value="False">
                                                <Setter Property="Text"
                                                        Value="位姿校验已关闭：1012/1014 均不拦截，仅用于台架调试；正式产线请开启" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:TextBlock.Style>
                            </ui:TextBlock>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- PLC TCP 调试应答 -->
                    <ui:CardExpander x:Name="anchor_plcdebug" Padding="12" Margin="0,0,0,8"
                                     IsExpanded="{Binding IsPlcDebugExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="PLC TCP 调试" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <ui:ToggleSwitch Content="启用 PLC 调试模式（TCP 不向 PLC 返回 ERR）"
                                             IsChecked="{Binding PlcDebugAlwaysOk}" />
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap" Margin="0,8,0,0"
                                          Text="开启后视觉仍照常采图推理，仅把 ERR 改写为 OK。通信监控页也有快捷开关；此处保存会写入 appsettings.json。正式产线务必关闭。" />
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding ShowPlcDebugFields,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="伪装成功时的默认坐标（单目标）" Style="{StaticResource FieldLabel}"
                                           Foreground="{Binding [PlcDebugCoordinates], Converter={StaticResource FieldErrorBrush}}" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="X（mm）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding PlcDebugDefaultX}" Minimum="-10000" Maximum="10000"
                                                      SmallChange="1" SpinButtonPlacementMode="Inline" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Y（mm）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding PlcDebugDefaultY}" Minimum="-10000" Maximum="10000"
                                                      SmallChange="1" SpinButtonPlacementMode="Inline" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="RZ（°）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding PlcDebugDefaultRz}" Minimum="-180" Maximum="180"
                                                      SmallChange="1" SpinButtonPlacementMode="Inline" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 失败现场留存 -->
                    <ui:CardExpander x:Name="anchor_retention" Padding="12" Margin="0,0,0,8"
                                     IsExpanded="{Binding IsRetentionExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="失败现场留存" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel Margin="0,0,0,8">
                                <ui:ToggleSwitch Content="保存原图（去畸变现场图）" IsChecked="{Binding FailureEnabled}" />
                                <ui:ToggleSwitch Content="保存绘制图（十字/框/ROI，文件名带 _ov）"
                                                 IsChecked="{Binding FailureSaveOverlay}" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel MaxWidth="480" HorizontalAlignment="Left"
                                        Visibility="{Binding ShowFailureRetention,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="滚动保留数量（0 = 不按数量清理）" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [FailureRetainedCount], Converter={StaticResource FieldErrorBrush}}" />
                                        <ui:NumberBox Value="{Binding FailureRetainedCount}" Minimum="0" Maximum="10000"
                                                      SmallChange="50" SpinButtonPlacementMode="Inline" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="按天保留（0 = 不按天清理）" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [FailureRetainedDays], Converter={StaticResource FieldErrorBrush}}" />
                                        <ui:NumberBox Value="{Binding FailureRetainedDays}" Minimum="0" Maximum="3650"
                                                      SmallChange="1" SpinButtonPlacementMode="Inline" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding FailureFolderPath}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Content="打开失败图目录" Padding="10,3" FontSize="11" Margin="0,6,0,0"
                                           HorizontalAlignment="Left" Command="{Binding OpenFailureFolderCommand}" />
                            </StackPanel>
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap"
                                          Text="仅产线 TRIGGER / 监控触发失败时存图；配方页试触发不入库；绘制图与配方试触发结果图一致；1007 限流与缩图策略见代码默认" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 成功现场留存 -->
                    <ui:CardExpander Padding="12" Margin="0,0,0,8"
                                     IsExpanded="{Binding IsSuccessExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="成功现场留存" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <ui:ToggleSwitch Content="保存原图（去畸变现场图，默认关，高速产线慎用）"
                                             IsChecked="{Binding CaptureSuccessEnabled}" />
                            <ui:ToggleSwitch Content="保存绘制图（十字/框/ROI，文件名带 _ov）"
                                             IsChecked="{Binding CaptureSuccessSaveOverlay}" Margin="0,8,0,0" />
                            <StackPanel Margin="0,8,0,0" MaxWidth="480" HorizontalAlignment="Left"
                                        Visibility="{Binding ShowCaptureSuccessFields,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="按天保留（0 = 不清理）" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [CaptureSuccessRetainedDays], Converter={StaticResource FieldErrorBrush}}" />
                                        <ui:NumberBox Value="{Binding CaptureSuccessRetainedDays}" Minimum="0"
                                                      Maximum="3650" SmallChange="1" SpinButtonPlacementMode="Inline" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="缩图最大宽度（0 = 原图）" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [CaptureSuccessMaxWidth], Converter={StaticResource FieldErrorBrush}}" />
                                        <ui:NumberBox Value="{Binding CaptureSuccessMaxWidth}" Minimum="0" Maximum="8192"
                                                      SmallChange="128" SpinButtonPlacementMode="Inline" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding CaptureSuccessFolderPath}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Content="打开成功图目录" Padding="10,3" FontSize="11" Margin="0,6,0,0"
                                           HorizontalAlignment="Left"
                                           Command="{Binding OpenCaptureSuccessFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 结果留档 -->
                    <ui:CardExpander x:Name="anchor_resultlog" Padding="12" Margin="0,0,0,8"
                                     IsExpanded="{Binding IsResultLogExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="结果留档（结果分析）" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <ui:ToggleSwitch Content="启用检测结果留存" IsChecked="{Binding ResultLogEnabled}" />
                            <StackPanel Margin="0,8,0,0" MaxWidth="480" HorizontalAlignment="Left"
                                        Visibility="{Binding ShowResultLogFields,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <CheckBox Content="写入 JSON Lines（按天滚动）" IsChecked="{Binding ResultLogJsonl}"
                                          FontSize="12" Margin="0,0,0,4"
                                          Foreground="{Binding [ResultLogSink], Converter={StaticResource FieldErrorBrush}}" />
                                <CheckBox Content="写入 SQLite（结果分析页查询）" IsChecked="{Binding ResultLogSqlite}"
                                          FontSize="12" Margin="0,0,0,8"
                                          Foreground="{Binding [ResultLogSink], Converter={StaticResource FieldErrorBrush}}" />
                                <TextBlock Text="按天保留（0 = 不清理）" Style="{StaticResource FieldLabel}"
                                           Foreground="{Binding [ResultLogRetainedDays], Converter={StaticResource FieldErrorBrush}}" />
                                <ui:NumberBox Value="{Binding ResultLogRetainedDays}" Minimum="0" Maximum="3650"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" />
                                <TextBlock Text="{Binding ResultLogFolderPath}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Content="打开结果目录" Padding="10,3" FontSize="11" Margin="0,6,0,0"
                                           HorizontalAlignment="Left" Command="{Binding OpenResultLogFolderCommand}" />
                            </StackPanel>
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap" Margin="0,4,0,0"
                                          Text="配方页试触发不入库；须勾选 SQLite 才能在「结果分析」页查询" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 运行日志 -->
                    <ui:CardExpander x:Name="anchor_filelog" Padding="12" Margin="0,0,0,8"
                                     IsExpanded="{Binding IsFileLogExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="运行日志（文件）" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <ui:ToggleSwitch Content="启用文件日志（logs 目录按天滚动）"
                                             IsChecked="{Binding FileLoggingEnabled}" />
                            <StackPanel Margin="0,8,0,0" MaxWidth="480" HorizontalAlignment="Left"
                                        Visibility="{Binding ShowFileLoggingFields,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="按天保留（0 = 不清理）" Style="{StaticResource FieldLabel}"
                                           Foreground="{Binding [FileLoggingRetainedDays], Converter={StaticResource FieldErrorBrush}}" />
                                <ui:NumberBox Value="{Binding FileLoggingRetainedDays}" Minimum="0" Maximum="3650"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" />
                                <TextBlock Text="{Binding FileLoggingFolderPath}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Content="打开日志目录" Padding="10,3" FontSize="11" Margin="0,6,0,0"
                                           HorizontalAlignment="Left"
                                           Command="{Binding OpenFileLoggingFolderCommand}" />
                            </StackPanel>
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap" Margin="0,4,0,0"
                                          Text="开关与保留天数保存后须重启程序；日志浏览页读取同一目录" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 过程能力与连续失败联锁 -->
                    <ui:CardExpander x:Name="anchor_health" Padding="12" Margin="0,0,0,8"
                                     IsExpanded="{Binding IsHealthExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="过程能力 / 连续失败联锁" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <ui:ToggleSwitch Content="启用统计落盘（data/metrics）"
                                             IsChecked="{Binding ProcessHealthEnabled}" />
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding ShowProcessHealthFields,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="连续失败联锁次数（0 = 不联锁）" Style="{StaticResource FieldLabel}"
                                                   Foreground="{Binding [ConsecutiveFailLimit], Converter={StaticResource FieldErrorBrush}}" />
                                        <ui:NumberBox Value="{Binding ConsecutiveFailLimit}" Minimum="0" Maximum="100"
                                                      SmallChange="1" SpinButtonPlacementMode="Inline"
                                                      ToolTip="同配方连续过程失败（1003/1005/1007/1008 等）达到该次数后返回 1018" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom">
                                        <CheckBox Content="达到次数后禁止触发（1018）"
                                                  IsChecked="{Binding InhibitOnLimit}" FontSize="12"
                                                  Margin="0,0,0,8" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="按天保留 TSV（0 = 不按天清理）" Style="{StaticResource FieldLabel}"
                                           Foreground="{Binding [ProcessHealthRetainedDays], Converter={StaticResource FieldErrorBrush}}" />
                                <ui:NumberBox Value="{Binding ProcessHealthRetainedDays}" Minimum="0" Maximum="3650"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" />
                                <TextBlock Text="{Binding ProcessHealthFolderPath}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Content="打开指标目录" Padding="10,3" FontSize="11" Margin="0,6,0,0"
                                           HorizontalAlignment="Left"
                                           Command="{Binding OpenProcessHealthFolderCommand}" />
                                <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              TextWrapping="Wrap" Margin="0,8,0,0"
                                              Text="排除光源/来料后，在通信页点「解除联锁」或 PLC 发 CLEARINHIBIT。配置类错误（1001/1004/1012/1017）不计入连续失败" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- IP 白名单 -->
                    <ui:CardExpander x:Name="anchor_whitelist" Padding="12" Margin="0,0,0,8"
                                     IsExpanded="{Binding IsWhitelistExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="IP 白名单" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="每行一条；空 = 允许所有；支持前缀通配如 192.168.*（整段通配）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding WhitelistText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     MinHeight="72" MaxHeight="160" FontFamily="Consolas"
                                     BorderBrush="{Binding [IpWhitelist], Converter={StaticResource FieldErrorBrush}, ConverterParameter=border}" />
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Margin="0,6,0,0"
                                          Text="热参数：保存后立即按新名单拒绝接入；仅允许合法 IP（如 192.168.1.10）或整段通配（如 192.168.*）" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 网络端点（保存后热重启监听） -->
                    <ui:CardExpander x:Name="anchor_endpoint" Padding="12"
                                     IsExpanded="{Binding IsEndpointExpanded, Mode=TwoWay}">
                        <ui:CardExpander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="网络端点" VerticalAlignment="Center" />
                                <Border Style="{StaticResource HotBadge}">
                                    <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AppBadgeText}" />
                                </Border>
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="监听 IP 地址" Style="{StaticResource FieldLabel}"
                                               Foreground="{Binding [IpAddress], Converter={StaticResource FieldErrorBrush}}" />
                                    <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="{Binding [IpAddress], Converter={StaticResource FieldErrorBrush}, ConverterParameter=border}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="监听端口（1–65535）" Style="{StaticResource FieldLabel}"
                                               Foreground="{Binding [TcpPort], Converter={StaticResource FieldErrorBrush}}" />
                                    <ui:NumberBox Value="{Binding TcpPort}" Minimum="1" Maximum="65535"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                            </UniformGrid>
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap"
                                          Text="IP 地址与端口保存后热重启监听（无需重启程序，客户端会短暂断开）；端口被占用时自动回滚到旧监听" />
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 固定底部操作栏：脏状态 / 校验错误 / 需重启提示始终可见 -->
        <ui:Card Grid.Row="1" Padding="12" Margin="0,8,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 脏状态徽章：绿=已同步，琥珀=有未保存改动 -->
                    <Border Grid.Column="0" CornerRadius="3" Padding="8,3" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DirtySummary}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <ui:Button Grid.Column="2" Content="放弃改动" Appearance="Secondary" Margin="12,0,0,0"
                               IsEnabled="{Binding CanDiscard}"
                               ToolTip="丢弃未保存的修改，回到上一次载入/保存的状态"
                               Command="{Binding DiscardCommand}" />
                    <ui:Button Grid.Column="3" Content="恢复默认" Appearance="Secondary" Margin="8,0,0,0"
                               ToolTip="填回出厂默认值（不影响已保存配置，需再点保存才生效）"
                               Command="{Binding RestoreDefaultsCommand}" />
                    <ui:Button Grid.Column="4" Content="打开配置目录" Margin="8,0,0,0"
                               Command="{Binding OpenSettingsFolderCommand}" />
                    <ui:Button Grid.Column="5" Content="保存并应用" Margin="8,0,0,0"
                               Appearance="{Binding IsDirty, Converter={StaticResource DirtyToAppearance}}"
                               ToolTip="Ctrl+S（无改动时也可点，用于重载状态）"
                               Command="{Binding SaveCommand}" />
                </Grid>

                <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- 校验失败：具体原因 + 出错字段（该字段标签在卡片内已标红） -->
                <TextBlock Text="{Binding ErrorMessage}" Margin="0,6,0,0" TextWrapping="Wrap"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- 需重启留痕：保存后仍常驻，直到重载或下次保存 -->
                <TextBlock Text="{Binding PendingRestartSummary}" Margin="0,6,0,0" TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding PendingRestartSummary,
                               Converter={StaticResource StringToVisibilityConverter}}" />
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
