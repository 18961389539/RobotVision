<Page x:Class="RobotVision.WpfHost.Features.SystemInfo.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="系统信息"
      VerticalAlignment="Stretch"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- 信息行卡片（替代 DataGrid，与通信监控页同构） -->
        <Style x:Key="InfoRow" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background"
                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 分组面板 -->
        <Style x:Key="SectionPanel" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="ui:TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitleCompact" TargetType="ui:TextBlock" BasedOn="{StaticResource AppSectionTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource AppLightTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="MetricValue" TargetType="ui:TextBlock" BasedOn="{StaticResource AppLightTextBlockStyle}">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Page.Resources>

    <Grid Margin="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
            <StackPanel MaxWidth="920">

            <!-- 运行状态：迷你指标"-->
            <Border Style="{StaticResource SectionPanel}">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="运行状态" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="TCP 服务" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBlock Style="{StaticResource MetricValue}" Text="{Binding TcpStatus}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="推理管线" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBlock Style="{StaticResource MetricValue}" Text="{Binding QueueStatus}" />
                            <TextBlock Text="{Binding HealthStatus}" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="资产" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBlock Style="{StaticResource MetricValue}" Text="{Binding RecipeStatus}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 数据目录 -->
            <Border Style="{StaticResource SectionPanel}">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitleCompact}" Text="数据目录" />
                    <TextBlock Text="点击行末按钮在资源管理器中打开" FontSize="11" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Directories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InfoRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{Binding Key}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   Margin="10,0,10,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Value}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:Button Grid.Column="2" Content="打开" Padding="10,4" FontSize="11"
                                                   CommandParameter="{Binding}"
                                                   Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 配置摘要 -->
            <Border Style="{StaticResource SectionPanel}">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitleCompact}" Text="配置摘要" />
                    <TextBlock Text="可修改项见「服务设置」页" FontSize="11" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Settings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InfoRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="148" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{Binding Key}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 相机资产 -->
            <Border Style="{StaticResource SectionPanel}" Margin="0">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitleCompact}" Text="相机资产" />
                    <TextBlock Text="配置中的全部相机；未注册项以琥珀色标识" FontSize="11" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ItemsControl ItemsSource="{Binding CameraBadges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="10,6" Margin="0,0,8,6"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Registered}" Value="False">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Registered}" Value="False">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                                                Background="{DynamicResource SystemFillColorCautionBrush}"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Registered}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="未注册" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.AppBadgeText}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
