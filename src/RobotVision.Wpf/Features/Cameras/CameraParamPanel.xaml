<UserControl x:Class="RobotVision.WpfHost.Features.Cameras.CameraParamPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:host="clr-namespace:RobotVision.WpfHost.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/PagePanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Width="420" Margin="8,0,0,0" VerticalAlignment="Stretch" ClipToBounds="True"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="6"
            Visibility="{Binding IsParamPanelVisible,
                Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="10,8,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="参数" FontTypography="BodyStrong" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="收起" Padding="8,3" FontSize="11"
                        Command="{Binding ToggleParamPanelCommand}" />
            </Grid>
            <TabControl Grid.Row="1" Margin="6,0,6,8" Style="{StaticResource CockpitTabControl}">
                <TabItem Header="类型">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                  host:ViewportPageLayout.IsolateWheel="True">
                        <StackPanel>
                            <TextBlock Text="{Binding TypeParamsHint}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnknownType}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Visibility="{Binding IsFile,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="回放目录（相对路径以 exe 目录为基准）" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding EditFolder, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0"
                                                   Command="{Binding BrowseFolderCommand}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="回放帧间隔（ms，0 = 不限速）" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsHardwareCamera,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="序列号或 IP（多台时必填）" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditDeviceId, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="序列号或 IP。现场只有一台时可留空；有两台及以上必须填写" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="{Binding EnumerateDevicesLabel}" Margin="8,26,0,0"
                                               Command="{Binding EnumerateBaslerCommand}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanEnumerateDevices}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </Grid>
                                <StackPanel Margin="0,0,0,8"
                                            Visibility="{Binding HasBaslerDevices,
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding EnumeratedDevicesCaption}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding BaslerDevices}"
                                              SelectedItem="{Binding SelectedBaslerDevice}" />
                                </StackPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="曝光（µs，空=不下发）" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditExposureUs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="增益（dB，空=不下发）" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditGain, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Margin="0,0,0,8"
                                            Visibility="{Binding ShowGrabTimeoutField,
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="单帧取图超时（ms）" Margin="0,0,0,4" />
                                    <ui:NumberBox Value="{Binding EditGrabTimeoutMs}" Minimum="1000" Maximum="300000"
                                                  SmallChange="1000" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsVirtual,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="宽（px）" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditWidth, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="高（px）" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditHeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,8"
                                                Visibility="{Binding ShowChessCellField,
                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="棋盘格单元（px）" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditCellPx, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="图案" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding PatternOptions}"
                                                  SelectedItem="{Binding EditPattern}" />
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="模拟曝光延时（ms）" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="高斯噪声 σ" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditNoiseSigma, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsUnknownType,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="该类型由外部相机工厂注册，本页未内置编辑字段。请编辑 appsettings.json 的 Cameras 节点后重启" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="调光">
                    <TabItem.Style>
                        <Style TargetType="TabItem" BasedOn="{StaticResource CockpitTabItem}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLiveExposureControl}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                  host:ViewportPageLayout.IsolateWheel="True">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock FontTypography="BodyStrong" Text="曝光 / 增益" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="读取当前"
                                           Command="{Binding ReadLiveParamsCommand}" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="曝光" VerticalAlignment="Center" Width="40" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1000"
                                        Value="{Binding ExposureSlider}"
                                        IsMoveToPointEnabled="True" SmallChange="1" LargeChange="50"
                                        Margin="8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding ExposureText}" Width="80"
                                           VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="增益" VerticalAlignment="Center" Width="40" />
                                <Slider Grid.Column="1" Minimum="{Binding GainMin}" Maximum="{Binding GainMax}"
                                        Value="{Binding Gain}"
                                        IsMoveToPointEnabled="True" SmallChange="0.1" LargeChange="1"
                                        Margin="8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding GainText}" Width="80"
                                           VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <WrapPanel>
                                <ui:Button Content="应用并取图预览" Appearance="Primary"
                                           Command="{Binding ApplyAndGrabCommand}" />
                                <ui:Button Content="填入编辑框（保存后生效）" Margin="8,0,0,0"
                                           Command="{Binding SaveLiveParamsCommand}" />
                            </WrapPanel>
                            <TextBlock FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="曝光为对数刻度滑块；确认亮度后「填入编辑区」再「保存」持久化到配置" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
