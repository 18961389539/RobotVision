<Page x:Class="RobotVision.WpfHost.Features.Cameras.CamerasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:cameras="clr-namespace:RobotVision.WpfHost.Features.Cameras"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="相机管理"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Page.InputBindings>

    <Grid Margin="8" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <cameras:CameraImageViewport />

        <!-- 列表收起时的「相机」重新打开按钮 -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Content="相机" Padding="14,8" FontWeight="SemiBold"
                Panel.ZIndex="30"
                Command="{Binding ToggleListPanelCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <cameras:CameraListPanel Panel.ZIndex="20" />

        <!-- 面板收起时的「参数」重新打开按钮 -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Content="参数" Padding="14,8" FontWeight="SemiBold"
                Panel.ZIndex="30"
                Command="{Binding ToggleParamPanelCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <cameras:CameraParamPanel Panel.ZIndex="20" />
    </Grid>
</Page>
