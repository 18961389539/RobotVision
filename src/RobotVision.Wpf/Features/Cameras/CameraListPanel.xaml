<UserControl x:Class="RobotVision.WpfHost.Features.Cameras.CameraListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
             xmlns:host="clr-namespace:RobotVision.WpfHost.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/PagePanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Border Width="200" Margin="0,0,8,0" VerticalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6"
                Visibility="{Binding IsListPanelVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="相机" FontTypography="BodyStrong" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="新建" Padding="8,3" FontSize="11"
                               Command="{Binding NewCommand}" />
                    <ui:Button Grid.Column="2" Content="刷新" Margin="6,0,0,0" Padding="8,3" FontSize="11"
                               ToolTip="F5" Command="{Binding RefreshCommand}" />
                    <Button Grid.Column="3" Content="收起" Padding="10,4" FontSize="12" Margin="6,0,0,0"
                            Command="{Binding ToggleListPanelCommand}" />
                </Grid>

                <ListBox Grid.Row="1" Margin="4,0,4,4" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2" Width="178">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  TextTrimming="CharacterEllipsis" />
                                    <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                                             Margin="6,0,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Registered}" Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="3"
                                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontSize="10" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground"
                                                        Value="#FFB8C0CC" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Registered}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="#FFB8C0CC"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                           Foreground="#FFB8C0CC"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding UnregisteredReason}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           ToolTip="{Binding UnregisteredReason}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnregisteredReason}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="10,4,10,10">
                    <TextBlock Text="{Binding UnsavedHint}" FontSize="10" TextWrapping="Wrap"
                               Foreground="#E8A33D" Margin="0,0,0,6"
                               Visibility="{Binding HasUnsavedChanges,
                                   Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
</UserControl>
