<UserControl x:Class="RobotVision.WpfHost.Features.Cameras.CameraImageViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
             xmlns:host="clr-namespace:RobotVision.WpfHost.Shared">
    <Grid>
        <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
            <ivc:ImageViewer ImageSource="{Binding PreviewImage}" />
        </Border>

        <!-- 预览角标（实时预览 / 测试取图 语义） -->
        <Border Background="#66000000" CornerRadius="3" Padding="6,2" Margin="10"
                HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="30"
                Visibility="{Binding PreviewVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding PreviewCaption}" FontSize="11" Foreground="White"
                       ToolTip="{Binding PreviewToolTip}" />
        </Border>
    </Grid>
</UserControl>
