<Page x:Class="RobotVision.WpfHost.Features.Failures.FailuresPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      Title="失败现场"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <vm:NullToCollapsedConverter x:Key="NullToCollapsedConverter" xmlns:vm="clr-namespace:RobotVision.WpfHost.Shared" />
    </Page.Resources>

    <Grid Margin="8">

        <!-- 主导图像区：完整 ImageViewer -->
        <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
            <ivc:ImageViewer ImageSource="{Binding PreviewImage}" />
        </Border>

        <!-- 选中项元数据角标（左上角）-->
        <Border Background="#66000000" CornerRadius="3" Padding="8,4" Margin="10"
                HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="30"
                Visibility="{Binding Selected, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding Selected.MetaText}" FontSize="11" Foreground="White"
                       TextWrapping="Wrap" MaxWidth="520" />
        </Border>

        <!-- 列表收起时的「现场」重新打开按钮 -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Content="现场" Padding="14,8" FontWeight="SemiBold"
                Panel.ZIndex="30"
                Command="{Binding ToggleListPanelCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- 左：失败现场列表浮动面板（可折叠"-->
        <Border Width="300" HorizontalAlignment="Left" VerticalAlignment="Top"
                MaxHeight="640" Margin="12" Panel.ZIndex="20"
                Background="#F01E2836"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsListPanelVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/Shared/OverlayPanelResources.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="360" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="失败现场" FontTypography="BodyStrong" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="刷新" Padding="8,3" FontSize="11"
                               ToolTip="F5" Command="{Binding RefreshCommand}" />
                    <Button Grid.Column="2" Content="收起" Padding="10,4" FontSize="12" Margin="6,0,0,0"
                            Command="{Binding ToggleListPanelCommand}" />
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding Message}" Margin="10,0,10,6"
                           FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"
                           Foreground="#FFD0D8E4" />

                <!-- 筛选：按配方 / 错误"-->
                <Grid Grid.Row="2" Margin="10,0,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="配方" VerticalAlignment="Center" FontSize="11" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding RecipeFilters}"
                              SelectedItem="{Binding RecipeFilter}" Margin="6,0,8,0"
                              FontSize="11" />
                    <TextBlock Grid.Column="2" Text="错误" VerticalAlignment="Center" FontSize="11" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding ErrorCodeFilters}"
                              SelectedItem="{Binding ErrorCodeFilter}" Margin="6,0,0,0"
                              FontSize="11" />
                </Grid>

                <ListBox Grid.Row="3" Margin="4,0,4,4" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="118" Margin="2">
                                <Border Background="#1E1E1E" CornerRadius="3">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Height="82" />
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" FontSize="10"
                                           Foreground="#FFB8C0CC"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="4" Margin="10,4,10,10">
                    <TextBlock Text="{Binding FilterSummary}" FontSize="10" TextWrapping="Wrap"
                               Margin="0,0,0,6"
                               Foreground="#FFB8C0CC" />
                    <WrapPanel Margin="0,0,0,6">
                        <ui:Button Content="打开目录" Padding="8,4" FontSize="11"
                                   Command="{Binding OpenFolderCommand}" />
                        <ui:Button Content="删除选中" Margin="6,0,0,0" Padding="8,4" FontSize="11"
                                   Command="{Binding DeleteSelectedCommand}" />
                        <ui:Button Content="{Binding DeleteAllButtonText}" Margin="6,0,0,0"
                                   Padding="8,4" FontSize="11"
                                   Command="{Binding DeleteAllCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
