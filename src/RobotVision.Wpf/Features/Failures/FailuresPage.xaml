<Page x:Class="RobotVision.WpfHost.Features.Failures.FailuresPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      xmlns:failures="clr-namespace:RobotVision.WpfHost.Features.Failures"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="失败现场"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <host:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="配方筛选" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding RecipeFilters}" SelectedItem="{Binding RecipeFilter}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="错误码" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding ErrorCodeFilters}" SelectedItem="{Binding ErrorCodeFilter}" />
                </StackPanel>
                <Border Grid.Column="2" Padding="8,6" CornerRadius="4" VerticalAlignment="Bottom"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock FontSize="12" Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Message}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <failures:FailuresListPanel Grid.Column="0" />
            <Grid Grid.Column="1" MinWidth="0">
                <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
                    <ivc:ImageViewer ImageSource="{Binding PreviewImage}" />
                </Border>
                <Border Background="#66000000" CornerRadius="3" Padding="8,4" Margin="10"
                        HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                        Visibility="{Binding Selected, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding Selected.MetaText}" FontSize="11" Foreground="White"
                               TextWrapping="Wrap" MaxWidth="520" />
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="现场" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding ToggleListPanelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ui:Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" ToolTip="F5" />
                <ui:Button Grid.Column="2" Content="打开目录" Margin="8,0,0,0"
                           Command="{Binding OpenFolderCommand}" />
                <WrapPanel Grid.Column="3" HorizontalAlignment="Right">
                    <ui:Button Content="删除选中" Padding="8,4" Command="{Binding DeleteSelectedCommand}" />
                    <ui:Button Content="{Binding DeleteAllButtonText}" Margin="8,0,0,0" Padding="8,4"
                               Command="{Binding DeleteAllCommand}" />
                </WrapPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,6,2,0" FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{Binding FilterSummary}" />
    </Grid>
</Page>
