<Page x:Class="RobotVision.WpfHost.Features.Chat.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:chat="clr-namespace:RobotVision.WpfHost.Features.Chat"
      Title="工艺助手"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static chat:ChatViewModel.TitleText}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="重新检测" Command="{Binding ProbeCommand}"
                           Margin="12,0,0,0"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                <ui:Button Grid.Column="2" Content="清空" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
            </Grid>
        </ui:Card>

        <Border Grid.Row="1" Padding="16" CornerRadius="6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">
            <Grid>
                <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{x:Static chat:ChatViewModel.EmptyTitle}"
                               FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock Text="{x:Static chat:ChatViewModel.EmptyLead}"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Margin="0,8,0,20"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <TextBlock Text="{x:Static chat:ChatViewModel.EmptyQuery}" TextWrapping="Wrap" FontSize="13" />
                    </Border>
                    <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <TextBlock Text="{x:Static chat:ChatViewModel.EmptyAnalysis}" TextWrapping="Wrap" FontSize="13" />
                    </Border>
                    <Border Padding="12,10" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <TextBlock Text="{x:Static chat:ChatViewModel.EmptyAction}" TextWrapping="Wrap" FontSize="13" />
                    </Border>
                </StackPanel>
                <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,4" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type chat:ChatBubble}">
                            <Border MaxWidth="720" Padding="10,8" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Background" Value="#332F81CB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <FlowDocumentScrollViewer chat:DocumentBinder.Document="{Binding Text}"
                                                              IsToolBarVisible="False" Padding="0" Background="Transparent"
                                                              VerticalScrollBarVisibility="Hidden"
                                                              HorizontalScrollBarVisibility="Disabled" />
                                    <Image MaxHeight="240" Margin="0,8,0,0" Stretch="Uniform"
                                           Source="{Binding ImagePath}"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Button Content="预览 HTML" FontSize="11" Padding="10,4" Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            ToolTip="用 WebView2 渲染模型回复中的 HTML（脚本已禁用）"
                                            Visibility="{Binding HasHtml, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.PreviewHtmlCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding HtmlPreview}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                        MinHeight="40" MaxHeight="120" Padding="8,8"
                        VerticalContentAlignment="Center"
                        AcceptsReturn="False"
                        TextWrapping="NoWrap"
                        PlaceholderText="{x:Static chat:ChatViewModel.InputPlaceholder}">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <ui:Button Grid.Column="1" Content="发送" IsDefault="True" Margin="8,0,0,0"
                       MinWidth="88" Command="{Binding SendCommand}" />
            <ui:Button Grid.Column="2" Content="停止" Margin="8,0,0,0" MinWidth="72"
                       Command="{Binding StopCommand}" />
        </Grid>
    </Grid>
</Page>
