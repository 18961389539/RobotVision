<Page x:Class="RobotVision.WpfHost.Features.Chat.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:chat="clr-namespace:RobotVision.WpfHost.Features.Chat"
      Title="工艺助手"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static chat:ChatViewModel.TitleText}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="重新检测" Command="{Binding ProbeCommand}"
                           Margin="12,0,0,0"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                <ui:Button Grid.Column="2" Content="清空" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
            </Grid>
        </ui:Card>

        <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">
            <Grid>
                <wv2:WebView2 x:Name="ChatView" DefaultBackgroundColor="#1C1C1C" />
                <TextBlock Text="工艺助手界面未启动。请确认 Chat.UiPort 未被占用。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="24" TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasChatUi}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Page>
