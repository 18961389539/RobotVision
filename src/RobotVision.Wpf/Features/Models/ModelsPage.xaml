<Page x:Class="RobotVision.WpfHost.Features.Models.ModelsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:RobotVision.WpfHost.Features.Models"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="模型管理"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="当前模型" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Text="{Binding SelectedFile.Name, Mode=OneWay}" IsReadOnly="True" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="推理任务" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding TaskOptions}"
                              SelectedValuePath="Value" SelectedValue="{Binding SelectedTask}"
                              DisplayMemberPath="Label" />
                </StackPanel>
                <Border Grid.Column="2" Padding="8,6" CornerRadius="4" VerticalAlignment="Bottom"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock FontSize="12" Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Message}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <models:ModelsListPanel Grid.Column="0" />
            <Grid Grid.Column="1" MinWidth="0">
                <models:ModelsImageViewport />
            </Grid>
            <models:ModelsParamPanel Grid.Column="2" />
        </Grid>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="模型" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding ToggleListPanelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ui:Button Grid.Column="1" Content="开始推理" Appearance="Primary"
                           IsEnabled="{Binding CanTest}" Command="{Binding RunTestCommand}" />
                <ui:Button Grid.Column="2" Content="取消" Margin="8,0,0,0"
                           Command="{Binding CancelTestCommand}"
                           Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Grid.Column="3" Margin="16,0,8,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="取消仅丢弃结果，后台推理不可中断" />
                <Button Grid.Column="4" Content="参数" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding ToggleParamPanelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="5" Content="更多" Padding="12,6" Click="OnMoreClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="打开模型目录" Command="{Binding OpenFolderCommand}" />
                            <MenuItem Header="卸载选中" Command="{Binding UnloadCommand}" />
                            <MenuItem Header="全部卸载" Command="{Binding UnloadAllCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,6,2,0" FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="替换 .onnx 后先卸载再推理；会话数超上限时自动回收最久未用的" />
    </Grid>
</Page>
