<UserControl x:Class="RobotVision.WpfHost.Features.Models.ModelsParamPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:host="clr-namespace:RobotVision.WpfHost.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/PagePanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Width="420" Margin="8,0,0,0" VerticalAlignment="Stretch" ClipToBounds="True"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="6"
            Visibility="{Binding IsParamPanelVisible,
                Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="10,8,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="参数" FontTypography="BodyStrong" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="收起" Padding="8,3" FontSize="11"
                        Command="{Binding ToggleParamPanelCommand}" />
            </Grid>
            <TabControl Grid.Row="1" Margin="6,0,6,8" Style="{StaticResource CockpitTabControl}">
                <TabItem Header="推理">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                  host:ViewportPageLayout.IsolateWheel="True">
                        <StackPanel>
                            <TextBlock Text="{Binding TaskParamsHint}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,10,8" Width="120">
                                    <TextBlock Text="置信度阈值" Margin="0,0,0,4" />
                                    <ui:NumberBox Value="{Binding Confidence}" Minimum="0.01" Maximum="0.99"
                                                  SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,8" Width="120">
                                    <TextBlock Text="IoU 阈值" Margin="0,0,0,4" />
                                    <ui:NumberBox Value="{Binding Iou}" Minimum="0.01" Maximum="0.99"
                                                  SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8" Width="120"
                                            Visibility="{Binding ShowPixelConfidence,
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="像素阈值（分割）" Margin="0,0,0,4" />
                                    <ui:NumberBox Value="{Binding PixelConfidence}" Minimum="0.01" Maximum="0.99"
                                                  SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="测试推理不经过配方/相机/标定；与产线共用模型会话" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="目录">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                  host:ViewportPageLayout.IsolateWheel="True">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding TestImageFolder, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="目录内所有 bmp/jpg/png/tif 将批量推理" />
                                <ui:Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0"
                                           Command="{Binding BrowseTestImageFolderCommand}" />
                                <ui:Button Grid.Column="2" Content="打开" Margin="8,0,0,0"
                                           Command="{Binding OpenTestImageFolderCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding TestImageFolderHint}" FontSize="11" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <WrapPanel Margin="0,8,0,0">
                                <ui:Button Content="上一张" Padding="8,4"
                                           Command="{Binding ShowPrevFolderResultCommand}" />
                                <ui:Button Content="下一张" Margin="8,0,0,0" Padding="8,4"
                                           Command="{Binding ShowNextFolderResultCommand}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"
                                           Text="{Binding FolderResultPosition}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
