<UserControl x:Class="RobotVision.WpfHost.Features.Monitor.MonitorLogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:host="clr-namespace:RobotVision.WpfHost.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/PagePanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Margin="0,8,0,0" Padding="10,8" MinHeight="140" MaxHeight="220"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="6"
            Visibility="{Binding IsLogPanelVisible,
                Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="运行日志" FontTypography="BodyStrong" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="收起" Padding="8,3" FontSize="11"
                        Command="{Binding ToggleLogPanelCommand}" />
            </Grid>
            <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" FontFamily="Consolas"
                     VirtualizingStackPanel.IsVirtualizing="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0"
                     ToolTip="双击复制该行"
                     MouseDoubleClick="OnLogListDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter Property="Background" Value="#3D791F1F" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Critical">
                                <Setter Property="Background" Value="#3D791F1F" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter Property="Background" Value="#2D633806" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Time, Mode=OneWay}" Foreground="#FFB8C0CC" />
                            <Run Text="{Binding Level, Mode=OneWay}" Foreground="#FF7EB6FF" />
                            <Run Text="{Binding Message, Mode=OneWay}" Foreground="#FFE8EDF4" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="级别" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding LogFilterOptions}" SelectedItem="{Binding LogFilter}"
                          Width="110" VerticalContentAlignment="Center" />
                <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}"
                          VerticalAlignment="Center" Margin="12,0,0,0" />
                <ui:Button Content="清空" Margin="12,0,0,0" Command="{Binding ClearLogCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
