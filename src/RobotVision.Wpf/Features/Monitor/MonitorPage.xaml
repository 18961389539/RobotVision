<Page x:Class="RobotVision.WpfHost.Features.Monitor.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:monitor="clr-namespace:RobotVision.WpfHost.Features.Monitor"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="运行监控"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding TriggerCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6"
                Visibility="{Binding HasInterlock, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding InterlockText}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <ui:Button Grid.Column="1" Content="解除联锁" Appearance="Primary" Margin="12,0,0,0"
                           Command="{Binding ClearInhibitCommand}" Padding="12,4" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="相机" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding CameraOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedCamera}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="配方" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" />
                        <ui:Button Grid.Column="1" Content="刷新" Margin="8,0,0,0"
                                   Command="{Binding RefreshRecipesCommand}" />
                    </Grid>
                </StackPanel>
                <CheckBox Grid.Column="2" Content="实时预览" VerticalAlignment="Bottom" Margin="0,0,10,0"
                          IsChecked="{Binding PreviewEnabled}" ToolTip="约 0.5s/帧" />
                <Border Grid.Column="3" Padding="8,6" CornerRadius="4" VerticalAlignment="Bottom"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock FontSize="12" Text="{Binding StatusText}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid MinWidth="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <monitor:MonitorImageViewport />
                <monitor:MonitorLogPanel x:Name="LogPanel" Grid.Row="1" />
            </Grid>
            <monitor:MonitorParamPanel Grid.Column="1" />
        </Grid>

        <Border Grid.Row="3" Margin="0,8,0,0" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Content="{Binding TriggerButtonText}" Appearance="Primary"
                           IsEnabled="{Binding CanTrigger}" Command="{Binding TriggerCommand}"
                           ToolTip="F5 触发一次完整流程" />
                <ui:Button Grid.Column="1" Content="恢复预览" Margin="8,0,0,0"
                           Command="{Binding ResumePreviewCommand}" />
                <Button Grid.Column="2" Content="日志" Padding="12,6" Margin="8,0,0,0"
                        Command="{Binding ToggleLogPanelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLogPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" />
                    <TextBlock Margin="8,0,0,0" FontSize="12" Text="{Binding StatusText}" />
                </StackPanel>
                <Button Grid.Column="5" Content="参数" Padding="12,6"
                        Command="{Binding ToggleParamPanelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Margin="2,6,2,0" FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="TCP TRIGGER 与手动触发共用同一流水线；连续失败达阈值将联锁并禁止触发" />
    </Grid>
</Page>
