<Page x:Class="RobotVision.WpfHost.Features.Monitor.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="运行监控"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding TriggerCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 主导图像区 + 悬浮参数栏 + 悬浮日志 -->
        <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
            <ivc:ImageViewer x:Name="Viewer" ImageSource="{Binding DisplayImage}" />
        </Border>

        <!-- 连续失败联锁：须可点击「解除联锁」，因此不放在 IsHitTestVisible=False 的状态栈 -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="8" Panel.ZIndex="40"
                Padding="12,8" CornerRadius="4" Background="#C0A32D2D"
                Visibility="{Binding HasInterlock, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding InterlockText}" Foreground="White" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" Content="解除联锁" Appearance="Primary" Margin="12,0,0,0"
                           Command="{Binding ClearInhibitCommand}" Padding="12,4" />
            </Grid>
        </Border>

        <!-- 左上：状态 + 触发结果横幅 -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="30"
                    IsHitTestVisible="False">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="10" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasInterlock}" Value="True">
                            <Setter Property="Margin" Value="10,72,10,10" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Background="#B0000000" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
                <TextBlock Text="{Binding StatusText}" Foreground="White" />
            </Border>
            <Border CornerRadius="3" Padding="12,6"
                    Visibility="{Binding TriggerBannerText, Converter={StaticResource NullToCollapsedConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#C01E7A46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TriggerSuccess}" Value="False">
                                <Setter Property="Background" Value="#C0A32D2D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding TriggerBannerText}" Foreground="White"
                           FontWeight="SemiBold" FontSize="13" />
            </Border>
        </StackPanel>

        <!-- 面板收起时的「参数」重新打开按钮 -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Content="参数" Padding="14,8" FontWeight="SemiBold"
                Panel.ZIndex="30"
                Command="{Binding ToggleParamPanelCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- 日志收起时的「日志」重新打开按钮 -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                Content="日志" Padding="14,8" FontWeight="SemiBold"
                Panel.ZIndex="30"
                Command="{Binding ToggleLogPanelCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLogPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- 右：参数浮动面板（可折叠） -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Width="428" Margin="12" Panel.ZIndex="20" ClipToBounds="True"
                Background="#F01E2836"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsParamPanelVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/OverlayPanelResources.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="12,12,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="参数面板" FontTypography="BodyStrong" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Button Grid.Column="1" Content="收起" Padding="10,4" FontSize="12"
                            Command="{Binding ToggleParamPanelCommand}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12"
                              host:ViewportPageLayout.IsolateWheel="True">
                    <StackPanel>
                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="相机" Margin="0,0,0,8"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ComboBox ItemsSource="{Binding CameraOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedCamera}" />
                                <CheckBox Content="实时预览 (约 0.5s/帧)"
                                          IsChecked="{Binding PreviewEnabled}" Margin="0,10,0,0" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="配方" Margin="0,0,0,8"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Recipes}"
                                              SelectedItem="{Binding SelectedRecipe}" />
                                    <ui:Button Grid.Column="1" Content="刷新" Margin="8,0,0,0"
                                               Command="{Binding RefreshRecipesCommand}" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="触发" Margin="0,0,0,8"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:Button Appearance="Primary"
                                           Content="{Binding TriggerButtonText}"
                                           IsEnabled="{Binding CanTrigger}"
                                           FontSize="14"
                                           ToolTip="触发一次完整流程：取图 → 预处理（去畸变或原图克隆）→ 推理 → 坐标变换（快捷键 F5）"
                                           Command="{Binding TriggerCommand}" />
                                <ui:CardExpander Header="高级选项" IsExpanded="False" Margin="0,8,0,0">
                                    <StackPanel Margin="0,10,0,0">
                                        <CheckBox Content="上报拍照位姿（末端相机 OnArm 试跑时勾选）"
                                                  IsChecked="{Binding IncludeTriggerPose}" Margin="0,0,0,4" FontSize="11" />
                                        <UniformGrid Columns="3">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="X mm" FontSize="10" />
                                                <ui:NumberBox Value="{Binding TriggerPoseX}" SmallChange="0.1"
                                                              IsEnabled="{Binding IncludeTriggerPose}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="Y mm" FontSize="10" />
                                                <ui:NumberBox Value="{Binding TriggerPoseY}" SmallChange="0.1"
                                                              IsEnabled="{Binding IncludeTriggerPose}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="RZ °" FontSize="10" />
                                                <ui:NumberBox Value="{Binding TriggerPoseRz}" SmallChange="0.1"
                                                              IsEnabled="{Binding IncludeTriggerPose}" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <ui:TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                                      Foreground="#FFB8C0CC"
                                                      Text="产线 PLC 触发自带位姿，此处仅用于本机手动试跑；固定机架相机无需展开" />
                                    </StackPanel>
                                </ui:CardExpander>
                                <ui:Button Appearance="Secondary" Content="恢复预览"
                                           Margin="0,8,0,0"
                                           Command="{Binding ResumePreviewCommand}" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card>
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="结果（机器人坐标）" Margin="0,0,0,8"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Grid MinHeight="96">
                                    <DataGrid ItemsSource="{Binding Poses}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              EnableRowVirtualization="False"
                                              EnableColumnVirtualization="False"
                                              GridLinesVisibility="Horizontal"
                                              Visibility="{Binding HasPoseResults,
                                                  Converter={StaticResource BoolToVisibilityConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="32" />
                                            <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat=F3}" Width="*" />
                                            <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat=F3}" Width="*" />
                                            <DataGridTextColumn Binding="{Binding AngleDeg, StringFormat=F3}" Width="*">
                                                <DataGridTextColumn.Header>
                                                    <TextBlock Text="角度 (°)" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               ToolTip="范围 (-180, 180]；[0,360) 表示的机器人/PLC 角度换算（负角 +360°）" />
                                                </DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="置信" Binding="{Binding Score, StringFormat=F3}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border CornerRadius="4" Padding="12,10"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            Visibility="{Binding HasPoseResults,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="尚未触发。手动触发或 TCP TRIGGER 成功后在此显示机器人坐标；失败时见上方横幅"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="#FFB8C0CC" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底：日志浮动面板（可折叠） -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                Height="220" MaxHeight="320" Margin="12" Panel.ZIndex="25"
                Background="#F01E2836"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsLogPanelVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/OverlayPanelResources.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="运行日志" FontTypography="BodyStrong" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Button Grid.Column="1" Content="收起" Padding="10,4" FontSize="12"
                            Command="{Binding ToggleLogPanelCommand}" />
                </Grid>

                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" FontFamily="Consolas"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0"
                         ToolTip="双击复制该行"
                         MouseDoubleClick="OnLogListDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter Property="Background" Value="#3D791F1F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Critical">
                                    <Setter Property="Background" Value="#3D791F1F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Background" Value="#2D633806" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="#FFB8C0CC" />
                                <Run Text="{Binding Level, Mode=OneWay}" Foreground="#FF7EB6FF" />
                                <Run Text="{Binding Message, Mode=OneWay}" Foreground="#FFE8EDF4" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="级别" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="#FFB8C0CC" />
                    <ComboBox ItemsSource="{Binding LogFilterOptions}" SelectedItem="{Binding LogFilter}"
                              Width="110" VerticalContentAlignment="Center" />
                    <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}"
                              VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ui:Button Content="清空" Margin="12,0,0,0"
                               Command="{Binding ClearLogCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
