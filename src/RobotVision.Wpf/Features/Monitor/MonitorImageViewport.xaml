<UserControl x:Class="RobotVision.WpfHost.Features.Monitor.MonitorImageViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
             xmlns:host="clr-namespace:RobotVision.WpfHost.Shared">
    <UserControl.Resources>
        <host:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
    </UserControl.Resources>
    <Grid>
        <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
            <ivc:ImageViewer x:Name="Viewer" ImageSource="{Binding DisplayImage}" />
        </Border>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                    IsHitTestVisible="False">
            <Border Background="#B0000000" CornerRadius="3" Padding="8,4" Margin="0,0,0,6">
                <TextBlock Text="{Binding StatusText}" Foreground="White" />
            </Border>
            <Border CornerRadius="3" Padding="12,6"
                    Visibility="{Binding TriggerBannerText, Converter={StaticResource NullToCollapsedConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#C01E7A46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TriggerSuccess}" Value="False">
                                <Setter Property="Background" Value="#C0A32D2D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding TriggerBannerText}" Foreground="White"
                           FontWeight="SemiBold" FontSize="13" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
