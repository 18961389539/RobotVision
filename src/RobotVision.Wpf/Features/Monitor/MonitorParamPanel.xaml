<UserControl x:Class="RobotVision.WpfHost.Features.Monitor.MonitorParamPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:host="clr-namespace:RobotVision.WpfHost.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/PagePanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Width="420" Margin="8,0,0,0" VerticalAlignment="Stretch" ClipToBounds="True"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="6"
            Visibility="{Binding IsParamPanelVisible,
                Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="10,8,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="参数" FontTypography="BodyStrong" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="收起" Padding="8,3" FontSize="11"
                        Command="{Binding ToggleParamPanelCommand}" />
            </Grid>
            <TabControl Grid.Row="1" Margin="6,0,6,8" Style="{StaticResource CockpitTabControl}">
                <TabItem Header="触发">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                  host:ViewportPageLayout.IsolateWheel="True">
                        <StackPanel>
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="手动触发走完整流程：取图 → 预处理 → 推理 → 坐标变换（F5）" />
                            <CheckBox Content="上报拍照位姿（末端相机 OnArm 试跑时勾选）"
                                      IsChecked="{Binding IncludeTriggerPose}" Margin="0,0,0,8" FontSize="11" />
                            <UniformGrid Columns="3"
                                         Visibility="{Binding IncludeTriggerPose,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="X mm" FontSize="10" />
                                    <ui:NumberBox Value="{Binding TriggerPoseX}" SmallChange="0.1" />
                                </StackPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Y mm" FontSize="10" />
                                    <ui:NumberBox Value="{Binding TriggerPoseY}" SmallChange="0.1" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="RZ °" FontSize="10" />
                                    <ui:NumberBox Value="{Binding TriggerPoseRz}" SmallChange="0.1" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="产线 PLC 触发自带位姿，此处仅用于本机手动试跑" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="结果">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                  host:ViewportPageLayout.IsolateWheel="True">
                        <Grid MinHeight="200">
                            <DataGrid ItemsSource="{Binding Poses}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      EnableRowVirtualization="False"
                                      Visibility="{Binding HasPoseResults,
                                          Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="32" />
                                    <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat=F3}" Width="*" />
                                    <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat=F3}" Width="*" />
                                    <DataGridTextColumn Binding="{Binding AngleDeg, StringFormat=F3}" Width="*">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="角度 (°)" ToolTip="范围 (-180, 180]" />
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="置信" Binding="{Binding Score, StringFormat=F3}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border CornerRadius="4" Padding="12,10"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    Visibility="{Binding HasPoseResults,
                                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="尚未触发。手动触发或 TCP TRIGGER 成功后在此显示机器人坐标"
                                           TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
