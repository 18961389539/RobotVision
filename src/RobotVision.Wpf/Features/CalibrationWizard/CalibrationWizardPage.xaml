<Page x:Class="RobotVision.WpfHost.Features.CalibrationWizard.CalibrationWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      xmlns:wizard="clr-namespace:RobotVision.WpfHost.Features.CalibrationWizard"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="标定向导"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.InputBindings>
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding ComputeCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 身份条：标定类型 / 相机 / 工位 Id -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="标定类型" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding ModeOptions}"
                              SelectedItem="{Binding SelectedModeOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4" ToolTip="{Binding Description}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Text=" ★" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Opacity="0.65"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowStationIdField}" Value="False">
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="相机" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding CameraOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedCamera}"
                              ToolTip="选择参与标定的相机" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowStationIdField}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="工位 Id" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding StationIds}"
                              SelectedItem="{Binding StationId, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              ToolTip="标定档案文件名前缀（可手输新工位）" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" MinWidth="0">
                <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
                    <ivc:ImageViewer x:Name="Viewer" ImageSource="{Binding FrameImage}"
                                     PreviewMouseLeftButtonDown="OnViewerMouseLeftButtonDown" />
                </Border>
                <Border Background="#66000000" CornerRadius="3" Padding="6,2" Margin="10"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="10"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding FrameInfo}" FontSize="11" Foreground="White" />
                </Border>
                <Border Background="#66000000" CornerRadius="3" Padding="6,2" Margin="10,12,10,10"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="10"
                        IsHitTestVisible="False"
                        Visibility="{Binding Clickable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock FontSize="11" Foreground="White"
                               Text="左键点选角点 · 滚轮缩放 · 中键拖动平移" />
                </Border>
            </Grid>

            <wizard:CalibrationWizardParamPanel x:Name="ParamPanel" Grid.Column="1" />
        </Grid>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Content="取图" Appearance="Primary" Command="{Binding GrabCommand}" />
                <ui:Button Grid.Column="1" Content="清空" Margin="8,0,0,0"
                           Command="{Binding ClearPointsCommand}" />
                <ui:Button Grid.Column="2" Content="计算" Margin="8,0,0,0" ToolTip="Ctrl+Enter"
                           Command="{Binding ComputeCommand}" />
                <ui:Button Grid.Column="3" Content="保存" Margin="8,0,0,0"
                           Command="{Binding SaveCommand}" />
                <Button Grid.Column="5" Content="参数" Padding="12,6"
                        Command="{Binding ToggleParamPanelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="2,6,2,0">
            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Message}" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       FontFamily="Consolas"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Result}" />
            <TextBlock FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="保存写回 data/calibration 并立即加载（无需重启）；覆盖已有档案前会确认。外参/旋转中心取图前须先完成内参标定" />
        </StackPanel>
    </Grid>
</Page>
