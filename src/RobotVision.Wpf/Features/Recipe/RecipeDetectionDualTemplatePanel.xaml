<UserControl x:Class="RobotVision.WpfHost.Features.Recipe.RecipeDetectionDualTemplatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/PagePanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,0,0,8">
        <ui:TextBlock FontTypography="BodyStrong" Text="双模板设置" Margin="0,0,0,6" />
        <TextBlock Text="{Binding DualTemplateStatusText}" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <WrapPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="匹配阈值" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.DualTemplate.MatchThreshold}"
                              Minimum="0" Maximum="1" SmallChange="0.05"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="旋转搜索 ±°" Margin="0,0,0,4" FontSize="11"
                           ToolTip="模板在搜索区内转多少度。夹具里零件转角不大时 15° 足够。" />
                <ui:NumberBox Value="{Binding Editor.DualTemplate.RefineRangeDeg}"
                              Minimum="1" Maximum="45" SmallChange="1"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118"
                        Visibility="{Binding ShowDualTemplateExpand,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="窗口外扩系数" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.DualTemplate.CropExpandRatio}"
                              Minimum="0.1" Maximum="5" SmallChange="0.2"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="最小间距(px)" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.DualTemplate.MinPairDistancePx}"
                              Minimum="0" Maximum="100000" SmallChange="5"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="最大间距(px)" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.DualTemplate.MaxPairDistancePx}"
                              Minimum="1" Maximum="100000" SmallChange="50"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
        </WrapPanel>
        <WrapPanel>
            <ui:Button Content="框选模板1" FontSize="11" Padding="10,4"
                       Command="{Binding DrawFeatureRoiCommand}" />
            <ui:Button Content="示教模板1" FontSize="11" Padding="10,4" Margin="6,0,0,0"
                       Command="{Binding Test.TeachDualTemplateACommand}" />
            <ui:Button Content="框选模板2" FontSize="11" Padding="10,4" Margin="6,0,0,0"
                       Command="{Binding DrawTeachRoiBCommand}" />
            <ui:Button Content="示教模板2" FontSize="11" Padding="10,4" Margin="6,0,0,0"
                       Command="{Binding Test.TeachDualTemplateBCommand}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
