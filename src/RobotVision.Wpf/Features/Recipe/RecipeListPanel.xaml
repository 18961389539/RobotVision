<UserControl x:Class="RobotVision.WpfHost.Features.Recipe.RecipeListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
             xmlns:host="clr-namespace:RobotVision.WpfHost.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/PagePanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <!-- 左：配方列表（可搜索，浮动窄栏——与相机管理页列表同构，可折叠） -->
        <Border Width="220" Margin="12" VerticalAlignment="Top" MaxHeight="640" Panel.ZIndex="20"
                HorizontalAlignment="Left"
                Background="#F01E2836"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsListPanelVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/OverlayPanelResources.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="440" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="配方" FontTypography="BodyStrong" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button Grid.Column="1" Content="新建" Padding="8,3" FontSize="11"
                               Command="{Binding NewCommand}" />
                    <ui:Button Grid.Column="2" Content="复制" Margin="6,0,0,0" Padding="8,3" FontSize="11"
                               Command="{Binding CopyCommand}"
                               ToolTip="复制当前编辑器为新配方（清序列号与输出补偿）" />
                    <ui:Button Grid.Column="3" Content="刷新" Margin="6,0,0,0" Padding="8,3" FontSize="11"
                               ToolTip="F5" Command="{Binding RefreshCommand}" />
                    <Button Grid.Column="4" Content="收起" Padding="10,4" FontSize="12" Margin="6,0,0,0"
                            Command="{Binding ToggleListPanelCommand}" />
                </Grid>
                <TextBlock Grid.Row="1" Margin="10,0,10,4" FontSize="9" TextWrapping="Wrap"
                           Foreground="#FFB8C0CC" Text="{Binding RecipesFolderHint}"
                           ToolTip="{Binding RecipesFolderHint}" />
                <StackPanel Grid.Row="2" Margin="10,0,10,6">
                    <TextBox Padding="5,3" FontSize="11"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按名称或备注过滤（F5 刷新）" />
                    <TextBlock Margin="0,4,0,0" FontSize="9" TextWrapping="Wrap"
                               Foreground="#E8A33D" Text="{Binding SelectedFilterHint}"
                               Visibility="{Binding SelectedFilterHint,
                                   Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                </StackPanel>
                <ListBox Grid.Row="3" Margin="4,0,4,4" ItemsSource="{Binding VisibleRecipes}"
                         SelectedItem="{Binding Selected}"
                         IsEnabled="{Binding IsIdle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2" Width="178">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  TextTrimming="CharacterEllipsis" />
                                    <Border Margin="6,2,0,0" Padding="4,1" CornerRadius="3"
                                            Background="{DynamicResource SystemFillColorCautionBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="停" FontSize="9" Foreground="Black" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="10" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Summary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground"
                                                    Value="#FFB8C0CC" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Summary, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="4" Margin="10,4,10,10">
                    <TextBlock Text="{Binding UnsavedHint}" FontSize="10" TextWrapping="Wrap"
                               Foreground="#E8A33D" Margin="0,0,0,6"
                               Visibility="{Binding HasUnsavedChanges,
                                   Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ui:Button Content="打开目录" Padding="8,4" FontSize="11"
                               Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </Grid>
        </Border>
</UserControl>
