<UserControl x:Class="RobotVision.WpfHost.Features.Recipe.RecipeDetectionRoiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/PagePanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <CheckBox Content="{Binding DetectionRoiCheckText}" FontSize="11" Margin="0,0,0,8"
                  IsChecked="{Binding Roi.UseRoi}" />
        <StackPanel Margin="0,0,0,10"
                    Visibility="{Binding Roi.UseRoi,
                        Converter={StaticResource BoolToVisibilityConverter}}">
            <UniformGrid Columns="2" Visibility="{Binding Roi.HasRoiRefFrame,
                    Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="0,0,8,8">
                    <TextBlock Text="X (px)" Margin="0,0,0,4" FontSize="11" />
                    <ui:NumberBox Value="{Binding Roi.RoiPxX}" Minimum="0" Maximum="{Binding Roi.RoiRefWidth}"
                                  SmallChange="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Y (px)" Margin="0,0,0,4" FontSize="11" />
                    <ui:NumberBox Value="{Binding Roi.RoiPxY}" Minimum="0" Maximum="{Binding Roi.RoiRefHeight}"
                                  SmallChange="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Margin="0,0,8,8">
                    <TextBlock Text="W (px)" Margin="0,0,0,4" FontSize="11" />
                    <ui:NumberBox Value="{Binding Roi.RoiPxWidth}" Minimum="1" Maximum="{Binding Roi.RoiRefWidth}"
                                  SmallChange="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="H (px)" Margin="0,0,0,4" FontSize="11" />
                    <ui:NumberBox Value="{Binding Roi.RoiPxHeight}" Minimum="1" Maximum="{Binding Roi.RoiRefHeight}"
                                  SmallChange="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="{Binding Roi.RoiRefFrameHint}" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding Roi.HasRoiRefFrame,
                           Converter={StaticResource BoolToVisibilityConverter}}" />
            <StackPanel Visibility="{Binding Roi.HasRoiRefFrame,
                    Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="X" Margin="0,0,0,4" FontSize="11" />
                        <ui:NumberBox Value="{Binding Roi.RoiX}" Minimum="0" Maximum="1"
                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Y" Margin="0,0,0,4" FontSize="11" />
                        <ui:NumberBox Value="{Binding Roi.RoiY}" Minimum="0" Maximum="1"
                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="W" Margin="0,0,0,4" FontSize="11" />
                        <ui:NumberBox Value="{Binding Roi.RoiWidth}" Minimum="0.01" Maximum="1"
                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="H" Margin="0,0,0,4" FontSize="11" />
                        <ui:NumberBox Value="{Binding Roi.RoiHeight}" Minimum="0.01" Maximum="1"
                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
            <WrapPanel>
                <ui:Button Content="预览区域" FontSize="11" Padding="10,4"
                           Command="{Binding Roi.PreviewRoiCommand}" />
                <ui:Button Content="框选检测区" FontSize="11" Padding="10,4" Margin="6,0,0,0"
                           Command="{Binding DrawDetectionRoiCommand}" />
            </WrapPanel>
        </StackPanel>
        <StackPanel Margin="0,0,0,10"
                    Visibility="{Binding UsesSecondarySearchRoi,
                        Converter={StaticResource BoolToVisibilityConverter}}">
            <CheckBox Content="{Binding SecondaryRoiCheckText}" FontSize="11" Margin="0,0,0,8"
                      IsChecked="{Binding Roi.UseSecondaryRoi}" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding SecondaryRoiHintText}"
                       Visibility="{Binding Roi.UseSecondaryRoi,
                           Converter={StaticResource BoolToVisibilityConverter}}" />
            <StackPanel Visibility="{Binding Roi.UseSecondaryRoi,
                    Converter={StaticResource BoolToVisibilityConverter}}">
                <UniformGrid Columns="2" Visibility="{Binding Roi.HasRoiRefFrame,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="ROI2 X (px)" Margin="0,0,0,4" FontSize="11" />
                        <ui:NumberBox Value="{Binding Roi.SecondaryRoiPxX}" Minimum="0"
                                      Maximum="{Binding Roi.RoiRefWidth}"
                                      SmallChange="1" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="ROI2 Y (px)" Margin="0,0,0,4" FontSize="11" />
                        <ui:NumberBox Value="{Binding Roi.SecondaryRoiPxY}" Minimum="0"
                                      Maximum="{Binding Roi.RoiRefHeight}"
                                      SmallChange="1" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="ROI2 W (px)" Margin="0,0,0,4" FontSize="11" />
                        <ui:NumberBox Value="{Binding Roi.SecondaryRoiPxWidth}" Minimum="1"
                                      Maximum="{Binding Roi.RoiRefWidth}"
                                      SmallChange="1" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="ROI2 H (px)" Margin="0,0,0,4" FontSize="11" />
                        <ui:NumberBox Value="{Binding Roi.SecondaryRoiPxHeight}" Minimum="1"
                                      Maximum="{Binding Roi.RoiRefHeight}"
                                      SmallChange="1" SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                </UniformGrid>
                <ui:Button Content="框选 ROI2" FontSize="11" Padding="10,4"
                           Command="{Binding DrawSecondaryRoiCommand}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
