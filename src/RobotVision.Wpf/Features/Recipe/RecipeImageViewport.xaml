<UserControl x:Class="RobotVision.WpfHost.Features.Recipe.RecipeImageViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
             xmlns:host="clr-namespace:RobotVision.WpfHost.Shared">
    <UserControl.Resources>
        <Style x:Key="ViewTabButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>
        <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <!-- 结果图视�?-->
                <ivc:ImageViewer x:Name="TestViewer" ImageSource="{Binding Test.ResultImage}"
                                 PixelSize="{Binding ViewerPixelSize}"
                                 PhysicalUnit="{Binding ViewerPhysicalUnit}"
                                 ShowEmptyStatePanel="False"
                                 IsToolbarVisible="False"
                                 ShowCaliperScores="False"
                                 ShowInfoPanel="False"
                                 ShowHistogram="False"
                                 ShowProfile="False"
                                 ShowRoiList="False"
                                 ShowCrosshair="False"
                                 ShowScaleBar="False"
                                 Visibility="{Binding ShowTestImageViewer, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!-- ROI 预览视图 -->
                <ivc:ImageViewer x:Name="RoiViewer" ImageSource="{Binding Roi.PreviewImage}"
                                 PixelSize="{Binding ViewerPixelSize}"
                                 PhysicalUnit="{Binding ViewerPhysicalUnit}"
                                 ShowEmptyStatePanel="False"
                                 IsToolbarVisible="False"
                                 ShowCaliperScores="False"
                                 ShowInfoPanel="False"
                                 ShowHistogram="False"
                                 ShowProfile="False"
                                 ShowRoiList="False"
                                 ShowCrosshair="False"
                                 ShowScaleBar="False"
                                 Visibility="{Binding ShowRoiImageViewer, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!-- 无图占位：首次取�?/ 测试前；触发中由旧结果图或深色底 + Message 顶住空白 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasAnyImage, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="尚未有图" FontSize="15" HorizontalAlignment="Center"
                               Foreground="#FFD0D8E4" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="#FFB8C0CC"
                               Text="测试触发或「预览区域」取图后在此显示。推理完成（含未检出目标 1007）会显示叠加结果；取图/标定/模型失败则无图" />
                </StackPanel>


                <!-- 左上：视图切换标签（结果�?/ ROI 预览"-->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,12,10,10"
                        Background="#66000000" CornerRadius="3" Padding="4,3" Panel.ZIndex="30"
                        Visibility="{Binding HasAnyImage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="结果" Command="{Binding ShowTestImageViewCommand}"
                                ToolTip="测试触发的位姿叠加结果">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ViewTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTestImage}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Background" Value="#99FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="ROI 预览" Margin="6,0,0,0"
                                Command="{Binding ShowRoiPreviewViewCommand}"
                                ToolTip="检测区域在画面上的位置（取一帧叠加矩形）">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ViewTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTestImage}" Value="False">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Background" Value="#99FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 右上：状态消息角标（面板收起时显示；面板展开时消息在面板头，避免重复"-->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,12,10,10"
                        Background="#66000000" CornerRadius="3" Padding="8,4" Panel.ZIndex="30"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="White"
                               MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                </Border>
            </Grid>
        </Border>
</UserControl>
