<Page x:Class="RobotVision.WpfHost.Features.Recipe.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:recipe="clr-namespace:RobotVision.WpfHost.Features.Recipe"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="配方管理"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Page.InputBindings>

    <Grid Margin="8" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <recipe:RecipeImageViewport x:Name="ImageViewport" />

        <!-- 列表收起时的「配方」重新打开按钮 -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Content="配方" Padding="14,8" FontWeight="SemiBold"
                Panel.ZIndex="30"
                Command="{Binding ToggleListPanelCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <recipe:RecipeListPanel Panel.ZIndex="20" />

        <!-- 面板收起时的"参数"重新打开按钮 -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Content="参数" Padding="14,8" FontWeight="SemiBold"
                Panel.ZIndex="30"
                Command="{Binding ToggleParamPanelCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <recipe:RecipeParamPanel x:Name="ParamPanel" Panel.ZIndex="20" />

        <!-- 取图/试触发/示教等长耗时操作：全页遮罩 + 进度条（Message 显示当前步骤） -->
        <Border Panel.ZIndex="50" Background="#99000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14"
                           Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                           Text="{Binding Message}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
