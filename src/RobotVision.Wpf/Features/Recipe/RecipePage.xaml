<Page x:Class="RobotVision.WpfHost.Features.Recipe.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="配方管理"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <vm:StringToVisibilityConverter x:Key="NonEmptyToVisibilityConverter" xmlns:vm="clr-namespace:RobotVision.WpfHost.Shared" />
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" xmlns:vm="clr-namespace:RobotVision.WpfHost.Shared" />
        <vm:NullToCollapsedConverter x:Key="NullToCollapsedConverter" xmlns:vm="clr-namespace:RobotVision.WpfHost.Shared" />

        <!-- 图像视图标签按钮：选中态高亮（结果图 / ROI 预览共用主图像区） -->
        <Style x:Key="ViewTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Page.Resources>

    <Grid Margin="8" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 主导图像区：完整 ImageViewer；结果图与 ROI 预览切换 -->
        <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <!-- 结果图视图 -->
                <ivc:ImageViewer x:Name="TestViewer" ImageSource="{Binding Test.ResultImage}"
                                 ShowEmptyStatePanel="False"
                                 Visibility="{Binding ShowTestImageViewer, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!-- ROI 预览视图 -->
                <ivc:ImageViewer x:Name="RoiViewer" ImageSource="{Binding Roi.PreviewImage}"
                                 ShowEmptyStatePanel="False"
                                 Visibility="{Binding ShowRoiImageViewer, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!-- 无图占位：首次取图/测试前；触发中由旧结果图或深色底 + Message 顶住空白 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasAnyImage, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="尚未有图像" FontSize="15" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="测试触发或「预览区域」取图后在此显示。推理完成（含未检出目标 1007）会显示叠加结果；取图/标定/模型失败则无图。" />
                </StackPanel>


                <!-- 左上：视图切换标签（结果图/ROI 预览） -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,12,10,10"
                        Background="#66000000" CornerRadius="3" Padding="4,3" Panel.ZIndex="30"
                        Visibility="{Binding HasAnyImage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="结果图" Style="{StaticResource ViewTabButton}"
                                Command="{Binding ShowTestImageViewCommand}"
                                ToolTip="测试触发的位姿叠加结果" />
                        <Button Content="ROI 预览" Margin="6,0,0,0" Style="{StaticResource ViewTabButton}"
                                Command="{Binding ShowRoiPreviewViewCommand}"
                                ToolTip="检测区域在画面上的位置（取一帧叠加矩形）" />
                    </StackPanel>
                </Border>

                <!-- 右上：状态消息角标（面板收起时显示；面板展开时消息在面板头，避免重复） -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,12,10,10"
                        Background="#66000000" CornerRadius="3" Padding="8,4" Panel.ZIndex="30"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="White"
                               MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                </Border>
            </Grid>
        </Border>

        <!-- 列表收起时的「配方」重新打开按钮 -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Content="配方" Padding="14,8" FontWeight="SemiBold"
                Panel.ZIndex="30"
                Command="{Binding ToggleListPanelCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- 左：配方列表（可搜索，浮动窄栏——与相机管理页列表同构，可折叠） -->
        <Border Width="220" Margin="12" VerticalAlignment="Top" MaxHeight="640" Panel.ZIndex="20"
                HorizontalAlignment="Left"
                Background="#F01E2836"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsListPanelVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="440" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="配方" FontTypography="BodyStrong" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="新建" Padding="8,3" FontSize="11"
                               Command="{Binding NewCommand}" />
                    <ui:Button Grid.Column="2" Content="刷新" Margin="6,0,0,0" Padding="8,3" FontSize="11"
                               ToolTip="F5" Command="{Binding RefreshCommand}" />
                    <Button Grid.Column="3" Content="收起" Padding="10,4" FontSize="12" Margin="6,0,0,0"
                            Command="{Binding ToggleListPanelCommand}" />
                </Grid>
                <TextBox Grid.Row="1" Margin="10,0,10,6" Padding="5,3" FontSize="11"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="按名称或备注过滤（F5 刷新）" />
                <ListBox Grid.Row="2" Margin="4,0,4,4" ItemsSource="{Binding VisibleRecipes}"
                         SelectedItem="{Binding Selected}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2" Width="178">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  TextTrimming="CharacterEllipsis" />
                                    <Border Margin="6,2,0,0" Padding="4,1" CornerRadius="3"
                                            Background="{DynamicResource SystemFillColorCautionBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="停" FontSize="9" Foreground="Black" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="10" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Summary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Summary}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="10,4,10,10">
                    <TextBlock Text="{Binding UnsavedHint}" FontSize="10" TextWrapping="Wrap"
                               Foreground="#E8A33D" Margin="0,0,0,6"
                               Visibility="{Binding HasUnsavedChanges,
                                   Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ui:Button Content="打开目录" Padding="8,4" FontSize="11"
                               Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 面板收起时的"参数"重新打开按钮 -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Content="参数" Padding="14,8" FontWeight="SemiBold"
                Panel.ZIndex="30"
                Command="{Binding ToggleParamPanelCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- 右：参数浮动面板（可折叠，图像主导布局核心区） -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Width="428" Margin="12" Panel.ZIndex="20" ClipToBounds="True"
                Background="#F01E2836"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsParamPanelVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 面板头：标题 + 消息 + 收起 -->
                <Grid Margin="12,12,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="配方参数" FontTypography="BodyStrong" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="10,0,6,0"
                               VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Message}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="2" Content="收起" Padding="10,4" FontSize="12"
                            Command="{Binding ToggleParamPanelCommand}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12"
                              host:ViewportPageLayout.IsolateWheel="True">
                    <StackPanel>

                        <!-- 基本信息 -->
                        <ui:CardExpander Header="基本信息" IsExpanded="False" Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,2">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="名称（字母/数字/_/-）" Margin="0,0,0,4" FontSize="12" />
                                    <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="已有配方改名后保存：写入新文件并删除旧名（PLC 请改用新名称或序列号）" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="序列号（PLC 触发，0=未分配）" Margin="0,0,0,4" FontSize="12" />
                                    <ui:NumberBox Value="{Binding Editor.SerialNumber}" Minimum="0" Maximum="9999"
                                                  SmallChange="1" SpinButtonPlacementMode="Compact"
                                                  ToolTip="#2 表示本框填 2 的配方，不是列表第 2 项。0=未分配，只能用名称触发。改完必须保存。" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="相机" Margin="0,0,0,4" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding CameraOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Id"
                                              ToolTip="选择本配方使用的相机"
                                              SelectedValue="{Binding Editor.CameraId}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="工位 Id（标定档案）" Margin="0,0,0,4" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding StationIds}" ToolTip="选择标定档案对应的工位 Id（可手输）"
                                              SelectedItem="{Binding Editor.StationId, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding MappingHint}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding MappingHint,
                                           Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                            <TextBlock Text="备注" Margin="0,0,0,4" FontSize="12" />
                            <ui:TextBox Text="{Binding Editor.Description, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="11" MinHeight="38" TextWrapping="Wrap"
                                        PlaceholderText="可选：产线、用途、维护说明等"
                                        ToolTip="仅用于备忘与左侧搜索，不影响 TRIGGER 与 TCP 输出" />
                            <CheckBox Content="启用该配方（停用触发返回 1015，文件保留）" FontSize="11"
                                      Margin="0,8,0,0" IsChecked="{Binding Editor.Enabled}" />
                            <TextBlock Text="{Binding AssetPinStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,6"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="钉死当前哈希" Appearance="Secondary" Padding="10,4" FontSize="12"
                                           Command="{Binding PinAssetsCommand}"
                                           ToolTip="把当前模型文件与工位标定档案的 SHA-256 写入配方；保存后 TRIGGER 校验，拷错文件返回 1017" />
                                <ui:Button Content="清除钉扎" Appearance="Secondary" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                                           Command="{Binding ClearAssetPinsCommand}" />
                            </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- 推理与角度 -->
                        <ui:CardExpander Header="推理与角度" IsExpanded="False" Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,2">
                            <TextBlock Text="{Binding AngleModeHint}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding AngleModeHint,
                                           Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="角度模式" Margin="0,0,0,4" FontSize="12" />
                                    <!-- SelectionChanged 触发 ViewModel 联动（更新按模式显隐的派生属性） -->
                                    <ComboBox ItemsSource="{Binding AngleModeOptions}" ToolTip="角度计算模式：决定如何由像素角度换算物理角度"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Editor.AngleMode}"
                                              SelectionChanged="AngleMode_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="旋转中心补偿" Margin="0,0,0,4" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding RotationOptions}" ToolTip="旋转中心补偿策略"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Editor.RotationCompensation}" />
                                </StackPanel>
                                <!-- 双BLOB模式纯图像处理不用模型：隐藏主模型选择（UniformGrid 该行独占，隐藏不留空洞） -->
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualBlobMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="主模型（.onnx）" Margin="0,0,0,4" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding ModelFiles}" ToolTip="主推理模型（.onnx）；必填"
                                              SelectedItem="{Binding PrimaryModel, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" />
                                </StackPanel>
                            </UniformGrid>
                            <!-- 次模型仅双模型模式有效；移出 UniformGrid 独占一行，隐藏时不留空洞 -->
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDualMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="次模型（B 特征 .onnx）" Margin="0,0,0,4" FontSize="12" />
                                <ComboBox ItemsSource="{Binding ModelFiles}" ToolTip="次模型（B 特征 .onnx，可选）"
                                          SelectedItem="{Binding SecondaryModel, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" />
                            </StackPanel>
                            <!-- 检测置信度 / IoU / 掩码置信度：三列同一行（分割模式第三列显示） -->
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <UniformGrid.Style>
                                    <Style TargetType="UniformGrid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDualBlobMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UniformGrid.Style>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="检测置信度" Margin="0,0,0,4" FontSize="11" />
                                    <ui:NumberBox Value="{Binding Editor.Confidence}"
                                                  Minimum="0" Maximum="1" SmallChange="0.05"
                                                  SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="IoU" Margin="0,0,0,4" FontSize="11" />
                                    <ui:NumberBox Value="{Binding Editor.Iou}"
                                                  Minimum="0" Maximum="1" SmallChange="0.05"
                                                  SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSegmentationMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMaskTemplateMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="掩码置信度" Margin="0,0,0,4" FontSize="11" />
                                    <ui:NumberBox Value="{Binding Editor.Segmentation.PixelConfidence}"
                                                  Minimum="0" Maximum="1" SmallChange="0.05"
                                                  SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </UniformGrid>
                            <!-- 按角度模式动态显隐：WrapPanel 保证隐藏后其余项自动补位不留空洞 -->
                            <WrapPanel>
                                <!-- 关键点置信度/A/B 索引：仅关键点模式 -->
                                <StackPanel Margin="0,0,8,8" Width="118">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyPointMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="关键点置信度" Margin="0,0,0,4" FontSize="11" />
                                    <ui:NumberBox Value="{Binding Editor.Keypoint.MinConfidence}"
                                                  Minimum="0" Maximum="1" SmallChange="0.05"
                                                  SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8" Width="118">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyPointMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="关键点 A 索引" Margin="0,0,0,4" FontSize="11" />
                                    <ui:NumberBox Value="{Binding Editor.Keypoint.IndexA}"
                                                  Minimum="0" Maximum="64" SmallChange="1"
                                                  SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8" Width="118">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyPointMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="关键点 B 索引" Margin="0,0,0,4" FontSize="11" />
                                    <ui:NumberBox Value="{Binding Editor.Keypoint.IndexB}"
                                                  Minimum="0" Maximum="64" SmallChange="1"
                                                  SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <!-- 配对距离：仅双模型模式 -->
                                <StackPanel Margin="0,0,8,8" Width="118">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="配对距离(px)" Margin="0,0,0,4" FontSize="11"
                                               ToolTip="A/B 一对一就近配对的最大像素距离；多目标间距接近时可能配错" />
                                    <ui:NumberBox Value="{Binding Editor.DualModel.PairingMaxDistancePx}"
                                                  Minimum="1" Maximum="100000" SmallChange="50"
                                                  SpinButtonPlacementMode="Compact"
                                                  ToolTip="A/B 一对一就近配对的最大像素距离；多目标间距接近时可能配错" />
                                </StackPanel>
                                <!-- 窗口配对（主从级联）：仅双模型模式 -->
                                <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <CheckBox Content="窗口配对（主从）" Margin="0,0,0,10"
                                              IsChecked="{Binding Editor.DualModel.CropWindowPairing}"
                                              VerticalAlignment="Bottom"
                                              Click="NotifyModeUiChanged"
                                              ToolTip="A 全图检测，B 只在 A 外扩窗口内检测：多目标不跨目标配错，B 推理更快；窗口重叠的密集目标仍可能选错" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8" Width="118">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDualCropExpand}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="窗口外扩系数" Margin="0,0,0,4" FontSize="11"
                                               ToolTip="A 包围盒四边各外扩（边长×该值），仅窗口配对生效" />
                                    <ui:NumberBox Value="{Binding Editor.DualModel.CropExpandRatio}"
                                                  Minimum="0.1" Maximum="5" SmallChange="0.2"
                                                  SpinButtonPlacementMode="Compact"
                                                  ToolTip="A 包围盒四边各外扩（边长×该值），仅窗口配对生效" />
                                </StackPanel>
                            </WrapPanel>

                            <!-- 双BLOB参数：仅 DualBlobCenterLine 模式（阈值分割+连通域，无需模型） -->
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDualBlobMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:TextBlock FontTypography="BodyStrong" Text="BLOB 设置" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,16,8" Orientation="Horizontal">
                                        <CheckBox Content="暗BLOB" IsChecked="{Binding Editor.Blob.DetectDark}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="勾选检测暗目标（阈值取反）；不勾检测亮目标" />
                                        <CheckBox Content="Otsu 自动阈值" Margin="16,0,0,0"
                                                  IsChecked="{Binding Editor.Blob.UseOtsu}"
                                                  VerticalAlignment="Center"
                                                  Click="NotifyModeUiChanged"
                                                  ToolTip="勾选自动计算阈值（忽略固定阈值）；光照稳定时建议固定阈值更稳" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowBlobFixedThreshold}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="固定阈值" Margin="0,0,0,4" FontSize="11"
                                                   ToolTip="Otsu 开启时忽略" />
                                        <ui:NumberBox Value="{Binding Editor.Blob.Threshold}"
                                                      Minimum="0" Maximum="255" SmallChange="5"
                                                      SpinButtonPlacementMode="Compact"
                                                      ToolTip="Otsu 开启时忽略" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <TextBlock Text="开运算核(px)" Margin="0,0,0,4" FontSize="11"
                                                   ToolTip="≤1 关闭；主次BLOB轻微粘连时先用开运算分离" />
                                        <ui:NumberBox Value="{Binding Editor.Blob.OpenKernelSize}"
                                                      Minimum="0" Maximum="31" SmallChange="2"
                                                      SpinButtonPlacementMode="Compact"
                                                      ToolTip="≤1 关闭；主次BLOB轻微粘连时先用开运算分离" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <TextBlock Text="主面积下限" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.Blob.MinArea}"
                                                      Minimum="1" Maximum="100000000" SmallChange="100"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <TextBlock Text="主面积上限" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.Blob.MaxArea}"
                                                      Minimum="1" Maximum="100000000" SmallChange="1000"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <TextBlock Text="次面积下限" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.Blob.SecondaryMinArea}"
                                                      Minimum="1" Maximum="100000000" SmallChange="10"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <TextBlock Text="次面积上限" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.Blob.SecondaryMaxArea}"
                                                      Minimum="1" Maximum="100000000" SmallChange="1000"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <TextBlock Text="窗口外扩系数" Margin="0,0,0,4" FontSize="11"
                                                   ToolTip="主BLOB包围盒四边各外扩（边长×该值），圈定次BLOB搜索窗口" />
                                        <ui:NumberBox Value="{Binding Editor.Blob.CropExpandRatio}"
                                                      Minimum="0.1" Maximum="5" SmallChange="0.2"
                                                      SpinButtonPlacementMode="Compact"
                                                      ToolTip="主BLOB包围盒四边各外扩（边长×该值），圈定次BLOB搜索窗口" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <TextBlock Text="最小间距(px)" Margin="0,0,0,4" FontSize="11"
                                                   ToolTip="主次质心最小间距，防止把主BLOB边缘碎块配成次BLOB" />
                                        <ui:NumberBox Value="{Binding Editor.Blob.MinPairDistancePx}"
                                                      Minimum="0" Maximum="100000" SmallChange="5"
                                                      SpinButtonPlacementMode="Compact"
                                                      ToolTip="主次质心最小间距，防止把主BLOB边缘碎块配成次BLOB" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <TextBlock Text="最大间距(px)" Margin="0,0,0,4" FontSize="11"
                                                   ToolTip="主次质心最大间距，超过不配对" />
                                        <ui:NumberBox Value="{Binding Editor.Blob.MaxPairDistancePx}"
                                                      Minimum="1" Maximum="100000" SmallChange="50"
                                                      SpinButtonPlacementMode="Compact"
                                                      ToolTip="主次质心最大间距，超过不配对" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>

                            <!-- 分割+精修参数：仅 MaskTemplate 模式 -->
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaskTemplateMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <DockPanel Margin="0,0,0,6">
                                    <ui:Button DockPanel.Dock="Right" Content="示教模板" Padding="10,3" FontSize="11"
                                               Command="{Binding Test.TeachTemplateCommand}"
                                               Visibility="{Binding IsTemplateMethod, Converter={StaticResource BoolToVisibilityConverter}}"
                                               ToolTip="取图 → 分割 → 转正裁剪存为模板。若启用特征 ROI，只裁该框（头尾/齿脚等局部纹理）；否则裁整个分割目标。仅模板匹配方法需要" />
                                    <ui:TextBlock FontTypography="BodyStrong" Text="精修设置" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="精修方法" Margin="0,0,0,4" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding RefineMethodOptions}" ToolTip="分割后的精修方法。卡尺+凸起：自动沿长边抓原图边缘，无需示教模板"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Editor.Template.RefineMethod}"
                                              SelectionChanged="AngleMode_SelectionChanged" />
                                </StackPanel>
                                <TextBlock FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="{Binding RefineMethodHint}"
                                           Visibility="{Binding RefineMethodHint,
                                               Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                <!-- 模板专属参数（阈值/范围/边缘图/示教状态）：仅模板匹配方法 -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTemplateMethod}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,8,0" Width="118">
                                            <TextBlock Text="匹配阈值" Margin="0,0,0,4" FontSize="11"
                                                       ToolTip="低于该值放弃精修，回退粗角度（无方向）" />
                                            <ui:NumberBox Value="{Binding Editor.Template.MatchThreshold}"
                                                          Minimum="0" Maximum="1" SmallChange="0.05"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0" Width="118">
                                            <TextBlock Text="精修范围(°)" Margin="0,0,0,4" FontSize="11"
                                                       ToolTip="粗角度基础上的旋转搜索范围（默认 ±5°）" />
                                            <ui:NumberBox Value="{Binding Editor.Template.RefineRangeDeg}"
                                                          Minimum="1" Maximum="45" SmallChange="1"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,6,0,0" VerticalAlignment="Bottom">
                                            <CheckBox Content="边缘图定角（更准）"
                                                      FontSize="11"
                                                      IsChecked="{Binding Editor.Template.UseEdgeMatch}"
                                                      ToolTip="混合判决：边缘图定角度 + 原图定头尾。中等纹理目标角度抖动约降至 1/5；弱纹理目标请改用直线拟合" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <!-- 状态：已示教（绿）/ 未示教（警示） -->
                                    <TextBlock FontSize="11" Margin="0,6,0,0" Text="✓ 已示教模板"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTemplate}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Margin="0,6,0,0"
                                               Text="未示教模板：点击「示教模板」自动生成（画面需有目标）"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTemplate}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <CheckBox Content="单独框选特征（示教用）" FontSize="11" Margin="0,8,0,4"
                                              IsChecked="{Binding Roi.UseTemplateRoi}"
                                              ToolTip="检测 ROI 决定 TRIGGER 在哪找目标；特征框决定模板吃哪块纹理（齿/脚、丝印等）。不启用则示教仍裁整个分割目标。运行时匹配仍在目标转正窗口内滑窗，不必特征框与检测框相同。" />
                                    <StackPanel
                                        Visibility="{Binding Roi.UseTemplateRoi,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                        <UniformGrid Columns="4" Visibility="{Binding Roi.HasRoiRefFrame,
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Margin="0,0,8,4">
                                                <TextBlock Text="X (px)" Margin="0,0,0,2" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.TemplateRoiPxX}" Minimum="0"
                                                              Maximum="{Binding Roi.RoiRefWidth}"
                                                              SmallChange="1" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,4">
                                                <TextBlock Text="Y (px)" Margin="0,0,0,2" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.TemplateRoiPxY}" Minimum="0"
                                                              Maximum="{Binding Roi.RoiRefHeight}"
                                                              SmallChange="1" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,4">
                                                <TextBlock Text="宽 (px)" Margin="0,0,0,2" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.TemplateRoiPxWidth}" Minimum="1"
                                                              Maximum="{Binding Roi.RoiRefWidth}"
                                                              SmallChange="1" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,4">
                                                <TextBlock Text="高 (px)" Margin="0,0,0,2" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.TemplateRoiPxHeight}" Minimum="1"
                                                              Maximum="{Binding Roi.RoiRefHeight}"
                                                              SmallChange="1" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <ui:Button Content="框选特征" FontSize="11" Padding="10,4" Margin="0,0,0,4"
                                                   HorizontalAlignment="Left"
                                                   Click="OnDrawTemplateRoiClick"
                                                   ToolTip="在预览图上拖出橙色特征框（可与绿色检测框并存）。示教时只把该框内纹理存成模板。" />
                                        <TextBlock FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="橙色=特征（示教），绿色=检测（TRIGGER）。特征中心须落在分割目标上。" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 偏心补偿前置预警 -->
                            <TextBlock Text="{Binding RotationCenterHint}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding RotationCenterHint,
                                           Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- 输出补偿（首件微调） -->
                        <ui:CardExpander Header="输出补偿（首件微调）" IsExpanded="False" Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,2">
                                <ui:TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Text="标定与偏心补偿之后叠加到每个目标。用于吸嘴/料厚残差，避免为 0.1mm 重做九点。勿用大补偿掩盖标定错误。" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="ΔX (mm)" FontSize="11" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding Editor.OutputOffset.X}"
                                                      Minimum="-100" Maximum="100" SmallChange="0.01"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="ΔY (mm)" FontSize="11" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding Editor.OutputOffset.Y}"
                                                      Minimum="-100" Maximum="100" SmallChange="0.01"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ΔRz (°)" FontSize="11" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding Editor.OutputOffset.RzDeg}"
                                                      Minimum="-180" Maximum="180" SmallChange="0.1"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- 检测区域 ROI -->
                        <ui:CardExpander Header="检测区域（ROI）" IsExpanded="False" Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,2">
                            <CheckBox Content="启用（缺省全图）" FontSize="11" Margin="0,0,0,8"
                                      IsChecked="{Binding Roi.UseRoi}" />
                            <StackPanel
                                Visibility="{Binding Roi.UseRoi,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- 像素输入（主输入）：预览取一帧后启用，操作工按画面像素思考 -->
                            <UniformGrid Columns="4" Visibility="{Binding Roi.HasRoiRefFrame,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="X (px)" Margin="0,0,0,4" FontSize="11" ToolTip="左上角 X（参考帧像素，自动换算成比例存储）" />
                                    <ui:NumberBox Value="{Binding Roi.RoiPxX}" Minimum="0" Maximum="{Binding Roi.RoiRefWidth}"
                                                  SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Y (px)" Margin="0,0,0,4" FontSize="11" ToolTip="左上角 Y（参考帧像素）" />
                                    <ui:NumberBox Value="{Binding Roi.RoiPxY}" Minimum="0" Maximum="{Binding Roi.RoiRefHeight}"
                                                  SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="宽 (px)" Margin="0,0,0,4" FontSize="11" ToolTip="宽度（参考帧像素；与 X 联动钳制，右缘不越界）" />
                                    <ui:NumberBox Value="{Binding Roi.RoiPxWidth}" Minimum="1" Maximum="{Binding Roi.RoiRefWidth}"
                                                  SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="高 (px)" Margin="0,0,0,4" FontSize="11" ToolTip="高度（参考帧像素；与 Y 联动钳制，下缘不越界）" />
                                    <ui:NumberBox Value="{Binding Roi.RoiPxHeight}" Minimum="1" Maximum="{Binding Roi.RoiRefHeight}"
                                                  SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </UniformGrid>
                            <!-- 像素模式状态行：参考帧来源 + 存储比例回显 + 边缘校验 -->
                            <TextBlock Text="{Binding Roi.RoiRefFrameHint}" FontSize="10" Margin="0,0,0,2"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding Roi.HasRoiRefFrame,
                                           Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{Binding Roi.RoiRatioHint}" FontSize="10" Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding Roi.HasRoiRefFrame,
                                           Converter={StaticResource BoolToVisibilityConverter}}" />
                            <!-- 比例输入（回退）：无参考帧时显示；取一帧后自动切到像素模式 -->
                            <StackPanel Visibility="{Binding Roi.HasRoiRefFrame,
                                    Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="X" Margin="0,0,0,4" FontSize="11" ToolTip="左上角 X（0~1 相对比例）" />
                                        <ui:NumberBox Value="{Binding Roi.RoiX}" Minimum="0" Maximum="1"
                                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Y" Margin="0,0,0,4" FontSize="11" ToolTip="左上角 Y（0~1 相对比例）" />
                                        <ui:NumberBox Value="{Binding Roi.RoiY}" Minimum="0" Maximum="1"
                                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="宽" Margin="0,0,0,4" FontSize="11" ToolTip="宽度（0~1 相对比例）" />
                                        <ui:NumberBox Value="{Binding Roi.RoiWidth}" Minimum="0.01" Maximum="1"
                                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="高" Margin="0,0,0,4" FontSize="11" ToolTip="高度（0~1 相对比例）" />
                                        <ui:NumberBox Value="{Binding Roi.RoiHeight}" Minimum="0.01" Maximum="1"
                                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="取一帧后可按像素输入，或直接『框选区域』图上拖拽"
                                           FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Content="预览区域" FontSize="11" Padding="10,4"
                                           Command="{Binding Roi.PreviewRoiCommand}"
                                           ToolTip="当前相机取一帧作为像素参考帧，显示在主图像区" />
                                <ui:Button Grid.Column="1" Content="框选区域" FontSize="11" Padding="10,4" Margin="6,0,0,0"
                                           Click="OnDrawRoiRegionClick"
                                           ToolTip="在图像上拖拽画出检测区域（无参考帧时先自动取一帧）；画完可拖动/缩放矩形微调" />
                                <TextBlock Grid.Column="2" FontSize="10" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="图上拖拽或改数值均可，双向联动；结果坐标自动偏移回全图" />
                            </Grid>
                            </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- 光源 -->
                        <ui:CardExpander Header="光源" IsExpanded="False" Margin="0,0,0,8">
                            <StackPanel Margin="0,6,0,2">
                            <CheckBox Content="启用（取图前点亮）" FontSize="11" Margin="0,0,0,8"
                                      IsChecked="{Binding Lighting.UseLighting}" />
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Lighting.UseLighting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="控制器" Margin="0,0,0,4" FontSize="11" />
                                        <ComboBox ItemsSource="{Binding Lighting.LightControllerIds}" ToolTip="选择本配方联动的光源控制器 Id"
                                                  SelectedItem="{Binding Lighting.SelectedLightControllerId,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="通道（≥1）" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Lighting.LightChannel}"
                                                      Minimum="1" Maximum="64" SmallChange="1"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="亮度(0-255)" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Lighting.LightBrightness}"
                                                      Minimum="0" Maximum="255" SmallChange="5"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="稳定延时(ms)" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Lighting.LightStabilizeDelayMs}"
                                                      Minimum="0" Maximum="10000" SmallChange="5"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Content="取图完成后熄灯（常亮场景可取消）" FontSize="11"
                                          IsChecked="{Binding Lighting.LightTurnOffAfterGrab}" Margin="0,2,0,0" />
                            </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </ScrollViewer>

                <!-- 操作脚条：固定在面板底部不随参数滚动，保存/测试触发随时可点 -->
                <Border Grid.Row="2" Padding="12,10"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel>
                        <!-- 操作 -->
                        <CheckBox IsChecked="{Binding Test.IncludeTriggerPose}" FontSize="11" Margin="0,0,0,4"
                                  ToolTip="末端相机（OnArm）工位测试触发必须上报拍照位姿，否则返回 ERR 1014">
                            <TextBlock Text="测试时上报拍照位姿（末端相机必须勾选，否则 1014）"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <UniformGrid Columns="3" Margin="0,0,0,8"
                                     Visibility="{Binding Test.ShowTriggerPoseFields,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="X mm" FontSize="10" />
                                <ui:NumberBox Value="{Binding Test.TriggerPoseX}" SmallChange="0.1" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Y mm" FontSize="10" />
                                <ui:NumberBox Value="{Binding Test.TriggerPoseY}" SmallChange="0.1" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="RZ °" FontSize="10" />
                                <ui:NumberBox Value="{Binding Test.TriggerPoseRz}" SmallChange="0.1" />
                            </StackPanel>
                        </UniformGrid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Content="保存" Appearance="Primary"
                                       Command="{Binding SaveCommand}" />
                            <ui:Button Grid.Column="1" Content="测试触发" Margin="8,0,0,0"
                                       Command="{Binding Test.TestTriggerCommand}"
                                       ToolTip="用磁盘上的配方跑一次完整链路，结果显示在主图像区" />
                            <ui:Button Grid.Column="2" Content="复制为新配方" Margin="8,0,0,0" FontSize="11"
                                       Command="{Binding CopyCommand}" />
                            <ui:Button Grid.Column="3" Content="删除" Margin="8,0,0,0"
                                       Command="{Binding DeleteCommand}" />
                        </Grid>
                        <TextBlock FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="测试触发仍用磁盘旧配方（未保存修改有提示）；保存即热加载，触发立即生效。滚轮缩放图像，中键或右键拖动画布。" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
