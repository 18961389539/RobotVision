<Page x:Class="RobotVision.WpfHost.Features.Recipe.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:recipe="clr-namespace:RobotVision.WpfHost.Features.Recipe"
      xmlns:host="clr-namespace:RobotVision.WpfHost.Shared"
      Title="配方管理"
      VerticalAlignment="Stretch"
      host:ViewportPageLayout.FillViewport="True"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <host:StringToVisibilityConverter x:Key="NonEmptyToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 身份条：名称 / 序列号 / 相机 / 角度模式始终可见 -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="名称" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="已有配方改名后保存：写入新文件并删除旧名（PLC 请改用新名称或序列号）" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="PLC 序列号" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:NumberBox Value="{Binding Editor.SerialNumber}" Minimum="0" Maximum="9999"
                                  SmallChange="1" SpinButtonPlacementMode="Compact"
                                  ToolTip="#2 表示本框 #2 的配方，不是列表第 2 项；0=未分配。改完必须保存" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="相机" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding CameraOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Id"
                              SelectedValue="{Binding EditorCameraId}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="角度模式" FontSize="10" Margin="0,0,0,3"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding AngleModeOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding EditorAngleMode}" />
                </StackPanel>
                <Border Grid.Column="4" Margin="0,0,8,0" Padding="8,6" CornerRadius="4" VerticalAlignment="Bottom"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding DirtyChipText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Border Grid.Column="5" Padding="8,6" CornerRadius="4" VerticalAlignment="Bottom"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding PipelineStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPipelineOccupied}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <recipe:RecipeListPanel Grid.Column="0" />

            <Grid Grid.Column="1" MinWidth="0">
                <recipe:RecipeImageViewport x:Name="ImageViewport" />
            </Grid>

            <recipe:RecipeParamPanel x:Name="ParamPanel" Grid.Column="2" />
        </Grid>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="配方" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding ToggleListPanelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ui:Button Grid.Column="1" Content="测试触发"
                           Command="{Binding Test.TestTriggerCommand}"
                           ToolTip="{Binding TestTriggerButtonToolTip}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                            <Setter Property="Appearance" Value="Primary" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="Appearance" Value="Secondary" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Grid.Column="2" Content="保存" Margin="8,0,0,0"
                           Command="{Binding SaveCommand}"
                           ToolTip="Ctrl+S。未保存时测试走当前编辑器，产线 TRIGGER 仍是磁盘旧版。">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                            <Setter Property="Appearance" Value="Secondary" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                    <Setter Property="Appearance" Value="Primary" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <StackPanel Grid.Column="3" Margin="16,0,8,0" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding Test.IncludeTriggerPose}" FontSize="11"
                              ToolTip="末端相机（OnArm）工位测试触发必须上报拍照位姿，否则返回 ERR 1014">
                        <TextBlock Text="测试时上报拍照位姿（末端相机必须勾选，否则 1014）" TextWrapping="Wrap" />
                    </CheckBox>
                    <UniformGrid Columns="3" Margin="0,6,0,0"
                                 Visibility="{Binding Test.ShowTriggerPoseFields,
                                     Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="X mm" FontSize="10" />
                            <ui:NumberBox Value="{Binding Test.TriggerPoseX}" SmallChange="0.1" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Y mm" FontSize="10" />
                            <ui:NumberBox Value="{Binding Test.TriggerPoseY}" SmallChange="0.1" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="RZ °" FontSize="10" />
                            <ui:NumberBox Value="{Binding Test.TriggerPoseRz}" SmallChange="0.1" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" FontSize="12" MaxWidth="280" TextTrimming="CharacterEllipsis"
                               Text="{Binding Message}" ToolTip="{Binding Message}" />
                </StackPanel>
                <Button Grid.Column="5" Content="参数" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding ToggleParamPanelCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="6" Content="更多" Padding="12,6" Click="OnMoreClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="配置工作台（写入编辑器，不保存）"
                                      Command="{Binding OpenSetupWizardCommand}" />
                            <MenuItem Header="复制为新配方" Command="{Binding CopyCommand}" />
                            <MenuItem Header="打开配方目录" Command="{Binding OpenFolderCommand}" />
                            <Separator />
                            <MenuItem Header="删除磁盘配方" Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="2,6,2,0">
            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="{Binding RecipeHealthHint}"
                       Visibility="{Binding RecipeHealthHint,
                           Converter={StaticResource NonEmptyToVisibilityConverter}}" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="{Binding UnsavedHint}"
                       Visibility="{Binding HasUnsavedChanges,
                           Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Text="{Binding TestTriggerBlockHint, Mode=OneWay}"
                       Visibility="{Binding ShowTestTriggerBlockHint,
                           Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Message}"
                       Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <TextBlock FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="测试走当前编辑器。色块图例在画面左下。保存后才上产线。" />
        </StackPanel>
    </Grid>
</Page>
