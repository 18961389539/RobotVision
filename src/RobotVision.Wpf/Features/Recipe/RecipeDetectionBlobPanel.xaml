<UserControl x:Class="RobotVision.WpfHost.Features.Recipe.RecipeDetectionBlobPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/PagePanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,0,0,8">
        <ui:TextBlock FontTypography="BodyStrong" Text="BLOB 设置" Margin="0,0,0,6" />
        <WrapPanel>
            <CheckBox Content="暗BLOB" IsChecked="{Binding Editor.Blob.DetectDark}" Margin="0,0,16,8" />
            <CheckBox Content="Otsu 自动阈值" IsChecked="{Binding EditorBlobUseOtsu}" Margin="0,0,8,8" />
            <StackPanel Margin="0,0,8,8" Width="118">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBlobFixedThreshold}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="固定阈值" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.Blob.Threshold}"
                              Minimum="0" Maximum="255" SmallChange="5"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="开运算(px)" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.Blob.OpenKernelSize}"
                              Minimum="0" Maximum="31" SmallChange="2"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="主面积下" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.Blob.MinArea}"
                              Minimum="1" Maximum="100000000" SmallChange="100"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="主面积上" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.Blob.MaxArea}"
                              Minimum="1" Maximum="100000000" SmallChange="1000"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="次面积下" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.Blob.SecondaryMinArea}"
                              Minimum="1" Maximum="100000000" SmallChange="10"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="次面积上" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.Blob.SecondaryMaxArea}"
                              Minimum="1" Maximum="100000000" SmallChange="1000"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118"
                        Visibility="{Binding ShowBlobExpandWindow,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="窗口外扩系数" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.Blob.CropExpandRatio}"
                              Minimum="0.1" Maximum="5" SmallChange="0.2"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="最小间距(px)" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.Blob.MinPairDistancePx}"
                              Minimum="0" Maximum="100000" SmallChange="5"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <StackPanel Margin="0,0,8,8" Width="118">
                <TextBlock Text="最大间距(px)" Margin="0,0,0,4" FontSize="11" />
                <ui:NumberBox Value="{Binding Editor.Blob.MaxPairDistancePx}"
                              Minimum="1" Maximum="100000" SmallChange="50"
                              SpinButtonPlacementMode="Compact" />
            </StackPanel>
        </WrapPanel>
    </StackPanel>
</UserControl>
