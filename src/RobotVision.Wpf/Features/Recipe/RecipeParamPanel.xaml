<UserControl x:Class="RobotVision.WpfHost.Features.Recipe.RecipeParamPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:host="clr-namespace:RobotVision.WpfHost.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RobotVision.Wpf;component/Shared/PagePanelResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Border Width="420" Margin="8,0,0,0" VerticalAlignment="Stretch" ClipToBounds="True"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6"
                Visibility="{Binding IsParamPanelVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,8,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="参数" FontTypography="BodyStrong" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="收起" Padding="8,3" FontSize="11"
                            Command="{Binding ToggleParamPanelCommand}" />
                </Grid>
                <TabControl Grid.Row="1" SelectedIndex="1" Margin="6,0,6,8"
                            Style="{StaticResource CockpitTabControl}">
                    <TabItem Header="身份">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                      host:ViewportPageLayout.IsolateWheel="True">
                            <StackPanel>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="名称、序列号、相机、角度模式在顶栏。这里只放不常改的身份字段。" />
                                <TextBlock Text="工位 Id（标定档案）" Margin="0,0,0,4" FontSize="12" />
                                <ComboBox ItemsSource="{Binding StationIds}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          Text="{Binding EditorStationId, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="选择标定档案对应的工位 Id（可手输）。与档案文件名前缀一致。" />
                                <TextBlock Text="{Binding MappingHint}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Margin="0,6,0,8"
                                           Visibility="{Binding MappingHint,
                                               Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                <TextBlock Text="备注" Margin="0,0,0,4" FontSize="12" />
                                <ui:TextBox Text="{Binding Editor.Description, UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="11" MinHeight="48" TextWrapping="Wrap"
                                            PlaceholderText="可选：产线、用途、维护说明等" />
                                <CheckBox Content="启用该配方（停用触发返回 1015，文件保留）" FontSize="11"
                                          Margin="0,10,0,8" IsChecked="{Binding Editor.Enabled}" />
                                <TextBlock Text="{Binding AssetPinStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <WrapPanel>
                                    <ui:Button Content="钉死当前哈希" Appearance="Secondary" Padding="10,4" FontSize="12"
                                               Command="{Binding PinAssetsCommand}" />
                                    <ui:Button Content="清除钉扎" Appearance="Secondary" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                                               Command="{Binding ClearAssetPinsCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="检测">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                      host:ViewportPageLayout.IsolateWheel="True">
                            <StackPanel>
                                <TextBlock Text="{Binding AngleModeHint}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8"
                                           Visibility="{Binding AngleModeHint,
                                               Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                <TextBlock Text="{Binding RefineMethodHint}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8"
                                           Visibility="{Binding RefineMethodHint,
                                               Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualBlobMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="主模型（.onnx）" Margin="0,0,0,4" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding ModelFiles}"
                                              SelectedItem="{Binding PrimaryModel, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="次模型（B 特征 .onnx）" Margin="0,0,0,4" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding ModelFiles}"
                                              SelectedItem="{Binding SecondaryModel, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" />
                                </StackPanel>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <UniformGrid.Style>
                                        <Style TargetType="UniformGrid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualBlobMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UniformGrid.Style>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="检测置信度" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.Confidence}"
                                                      Minimum="0" Maximum="1" SmallChange="0.05"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="IoU" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.Iou}"
                                                      Minimum="0" Maximum="1" SmallChange="0.05"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSegmentationMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMaskTemplateMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="掩码置信度" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.Segmentation.PixelConfidence}"
                                                      Minimum="0" Maximum="1" SmallChange="0.05"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Content="启用检测区域（缺省全图；双BLOB 的 ROI1：BLOB1 只在此区内）" FontSize="11" Margin="0,0,0,8"
                                          IsChecked="{Binding Roi.UseRoi}" />
                                <StackPanel Margin="0,0,0,10"
                                            Visibility="{Binding Roi.UseRoi,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                    <UniformGrid Columns="2" Visibility="{Binding Roi.HasRoiRefFrame,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="X (px)" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Roi.RoiPxX}" Minimum="0" Maximum="{Binding Roi.RoiRefWidth}"
                                                          SmallChange="1" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Y (px)" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Roi.RoiPxY}" Minimum="0" Maximum="{Binding Roi.RoiRefHeight}"
                                                          SmallChange="1" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="W (px)" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Roi.RoiPxWidth}" Minimum="1" Maximum="{Binding Roi.RoiRefWidth}"
                                                          SmallChange="1" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="H (px)" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Roi.RoiPxHeight}" Minimum="1" Maximum="{Binding Roi.RoiRefHeight}"
                                                          SmallChange="1" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding Roi.RoiRefFrameHint}" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding Roi.HasRoiRefFrame,
                                                   Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel Visibility="{Binding Roi.HasRoiRefFrame,
                                            Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="X" Margin="0,0,0,4" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.RoiX}" Minimum="0" Maximum="1"
                                                              SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="Y" Margin="0,0,0,4" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.RoiY}" Minimum="0" Maximum="1"
                                                              SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="W" Margin="0,0,0,4" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.RoiWidth}" Minimum="0.01" Maximum="1"
                                                              SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="H" Margin="0,0,0,4" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.RoiHeight}" Minimum="0.01" Maximum="1"
                                                              SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <WrapPanel>
                                        <ui:Button Content="预览区域" FontSize="11" Padding="10,4"
                                                   Command="{Binding Roi.PreviewRoiCommand}" />
                                        <ui:Button Content="框选检测区" FontSize="11" Padding="10,4" Margin="6,0,0,0"
                                                   Command="{Binding DrawDetectionRoiCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualBlobMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <CheckBox Content="启用 ROI2（BLOB2 只在此区内；不启用则用主包围盒外扩）" FontSize="11" Margin="0,0,0,8"
                                              IsChecked="{Binding Roi.UseSecondaryRoi}" />
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="BLOB1 只在 ROI1 检测，BLOB2 只在 ROI2 检测。两边都要框选，不要把 ROI1 拉成全图。"
                                               Visibility="{Binding Roi.UseSecondaryRoi,
                                                   Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel Visibility="{Binding Roi.UseSecondaryRoi,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                        <UniformGrid Columns="2" Visibility="{Binding Roi.HasRoiRefFrame,
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="ROI2 X (px)" Margin="0,0,0,4" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.SecondaryRoiPxX}" Minimum="0"
                                                              Maximum="{Binding Roi.RoiRefWidth}"
                                                              SmallChange="1" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="ROI2 Y (px)" Margin="0,0,0,4" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.SecondaryRoiPxY}" Minimum="0"
                                                              Maximum="{Binding Roi.RoiRefHeight}"
                                                              SmallChange="1" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="ROI2 W (px)" Margin="0,0,0,4" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.SecondaryRoiPxWidth}" Minimum="1"
                                                              Maximum="{Binding Roi.RoiRefWidth}"
                                                              SmallChange="1" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="ROI2 H (px)" Margin="0,0,0,4" FontSize="11" />
                                                <ui:NumberBox Value="{Binding Roi.SecondaryRoiPxHeight}" Minimum="1"
                                                              Maximum="{Binding Roi.RoiRefHeight}"
                                                              SmallChange="1" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <ui:Button Content="框选 ROI2" FontSize="11" Padding="10,4"
                                                   Command="{Binding DrawSecondaryRoiCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyPointMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="关键点置信度" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.Keypoint.MinConfidence}"
                                                      Minimum="0" Maximum="1" SmallChange="0.05"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyPointMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="关键点 A 索引" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.Keypoint.IndexA}"
                                                      Minimum="0" Maximum="64" SmallChange="1"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyPointMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="关键点 B 索引" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.Keypoint.IndexB}"
                                                      Minimum="0" Maximum="64" SmallChange="1"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDualMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="配对距离(px)" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.DualModel.PairingMaxDistancePx}"
                                                      Minimum="1" Maximum="100000" SmallChange="50"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDualMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <CheckBox Content="窗口配对（主从）" Margin="0,0,0,10"
                                                  IsChecked="{Binding EditorCropWindowPairing}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8" Width="118">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDualCropExpand}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="窗口外扩系数" Margin="0,0,0,4" FontSize="11" />
                                        <ui:NumberBox Value="{Binding Editor.DualModel.CropExpandRatio}"
                                                      Minimum="0.1" Maximum="5" SmallChange="0.2"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualBlobMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="BLOB 设置" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <CheckBox Content="暗BLOB" IsChecked="{Binding Editor.Blob.DetectDark}" Margin="0,0,16,8" />
                                        <CheckBox Content="Otsu 自动阈值" IsChecked="{Binding EditorBlobUseOtsu}" Margin="0,0,8,8" />
                                        <StackPanel Margin="0,0,8,8" Width="118">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowBlobFixedThreshold}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="固定阈值" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Editor.Blob.Threshold}"
                                                          Minimum="0" Maximum="255" SmallChange="5"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8" Width="118">
                                            <TextBlock Text="开运算(px)" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Editor.Blob.OpenKernelSize}"
                                                          Minimum="0" Maximum="31" SmallChange="2"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8" Width="118">
                                            <TextBlock Text="主面积下" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Editor.Blob.MinArea}"
                                                          Minimum="1" Maximum="100000000" SmallChange="100"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8" Width="118">
                                            <TextBlock Text="主面积上" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Editor.Blob.MaxArea}"
                                                          Minimum="1" Maximum="100000000" SmallChange="1000"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8" Width="118">
                                            <TextBlock Text="次面积下" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Editor.Blob.SecondaryMinArea}"
                                                          Minimum="1" Maximum="100000000" SmallChange="10"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8" Width="118">
                                            <TextBlock Text="次面积上" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Editor.Blob.SecondaryMaxArea}"
                                                          Minimum="1" Maximum="100000000" SmallChange="1000"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8" Width="118">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowBlobExpandWindow}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="窗口外扩系数" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Editor.Blob.CropExpandRatio}"
                                                          Minimum="0.1" Maximum="5" SmallChange="0.2"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8" Width="118">
                                            <TextBlock Text="最小间距(px)" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Editor.Blob.MinPairDistancePx}"
                                                          Minimum="0" Maximum="100000" SmallChange="5"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8" Width="118">
                                            <TextBlock Text="最大间距(px)" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Editor.Blob.MaxPairDistancePx}"
                                                          Minimum="1" Maximum="100000" SmallChange="50"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMaskTemplateMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <DockPanel Margin="0,0,0,6">
                                        <ui:Button DockPanel.Dock="Right" Content="详情…" Padding="10,3" FontSize="11"
                                                   Command="{Binding OpenRefineDetailsCommand}" />
                                        <ui:TextBlock FontTypography="BodyStrong" Text="精修设置" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="精修方法" Margin="0,0,0,4" FontSize="12" />
                                    <ComboBox ItemsSource="{Binding RefineMethodOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding EditorRefineMethod}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <StackPanel Width="140" Margin="0,0,12,8"
                                                    Visibility="{Binding ShowMatchThreshold,
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="匹配阈值" FontSize="11" Margin="0,0,0,4"
                                                       ToolTip="分数低于该值判定精修失败。详情里还有第二峰门等。" />
                                            <ui:NumberBox Value="{Binding Editor.Template.MatchThreshold}"
                                                          Minimum="0" Maximum="1" SmallChange="0.05"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Width="140" Margin="0,0,12,8"
                                                    Visibility="{Binding ShowRefineRange,
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="角度下限 (°)" FontSize="11" Margin="0,0,0,4"
                                                       ToolTip="相对分割粗角的搜索起点。例如 -5 表示向负方向搜 5°。" />
                                            <ui:NumberBox Value="{Binding Editor.Template.RefineAngleLoDeg}"
                                                          Minimum="-45" Maximum="45" SmallChange="1"
                                                          SpinButtonPlacementMode="Compact"
                                                          ToolTip="相对粗角。可与上限非对称。" />
                                        </StackPanel>
                                        <StackPanel Width="140" Margin="0,0,12,8"
                                                    Visibility="{Binding ShowRefineRange,
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="角度上限 (°)" FontSize="11" Margin="0,0,0,4"
                                                       ToolTip="相对分割粗角的搜索终点。须大于下限。" />
                                            <ui:NumberBox Value="{Binding Editor.Template.RefineAngleHiDeg}"
                                                          Minimum="-45" Maximum="45" SmallChange="1"
                                                          SpinButtonPlacementMode="Compact"
                                                          ToolTip="相对粗角。须大于下限。" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{Binding TeachPeakHint}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding TeachPeakHint,
                                                   Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="{Binding TestNextStepHint}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding TestNextStepHint,
                                                   Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                    <TextBlock FontSize="11" Margin="0,0,0,0" TextWrapping="Wrap"
                                               Text="{Binding RefineDetailsSummary}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="{Binding PolarityLockHint}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding PolarityLockHint,
                                                   Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding Test.ShowRefineAdviceReminder,
                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Text="{Binding Test.RefineAdviceText}" />
                                        <ui:Button Content="打开配置工作台" Padding="10,3" FontSize="11" HorizontalAlignment="Left"
                                                   Command="{Binding OpenSetupWizardCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="产线占用相机时顶栏会提示，测试触发禁用，避免 1009/1010。"
                                           Visibility="{Binding IsPipelineOccupied,
                                               Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="示教">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                      host:ViewportPageLayout.IsolateWheel="True">
                            <StackPanel>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="示教写进当前编辑器，保存后才上产线。检测区域在「检测」页；框选特征/示教在图像工具条。" />
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="{Binding TemplateStatusText}" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="{Binding TeachGeometryHint}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="{Binding FeatureGrabOriginHint}"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Visibility="{Binding FeatureGrabOriginHint,
                                               Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                <StackPanel Margin="0,0,0,10"
                                            Visibility="{Binding IsMaskTemplateMode,
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="期望件数（0=不检查）" Margin="0,0,0,4" FontSize="12" />
                                    <ui:NumberBox Value="{Binding Editor.Template.ExpectedCount}"
                                                  Minimum="0" Maximum="20" SmallChange="1"
                                                  SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="输出">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,4,8"
                                      host:ViewportPageLayout.IsolateWheel="True">
                            <StackPanel>
                                <TextBlock Text="旋转中心补偿" Margin="0,0,0,4" FontSize="12" />
                                <ComboBox ItemsSource="{Binding RotationOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Editor.RotationCompensation}" />
                                <TextBlock Text="{Binding RotationCenterHint}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding RotationCenterHint,
                                               Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                <TextBlock Text="{Binding UndirectedEccentricHint}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Margin="0,6,0,8"
                                           Visibility="{Binding UndirectedEccentricHint,
                                               Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                <ui:TextBlock FontTypography="BodyStrong" Text="输出补偿（首件微调）" Margin="0,8,0,6" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="标定与偏心之后叠加到每个目标。勿用大补偿掩盖标定错误。" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="ΔX (mm)" FontSize="11" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding Editor.OutputOffset.X}"
                                                      Minimum="-100" Maximum="100" SmallChange="0.01"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="ΔY (mm)" FontSize="11" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding Editor.OutputOffset.Y}"
                                                      Minimum="-100" Maximum="100" SmallChange="0.01"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ΔRz (°)" FontSize="11" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding Editor.OutputOffset.RzDeg}"
                                                      Minimum="-180" Maximum="180" SmallChange="0.1"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,6"
                                           Text="{Binding OutputOffsetTeachHint}" />
                                <WrapPanel>
                                    <ui:Button Content="记下本次为示教输出" Padding="10,3" FontSize="11" Margin="0,0,8,4"
                                               Command="{Binding RecordTeachOutputCommand}" />
                                    <ui:Button Content="用结果库合格均值建议补偿" Padding="10,3" FontSize="11" Margin="0,0,0,4"
                                               Command="{Binding SuggestOutputOffsetCommand}" />
                                </WrapPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="光源" Margin="0,12,0,6" />
                                <CheckBox Content="启用（取图前点亮）" FontSize="11" Margin="0,0,0,8"
                                          IsChecked="{Binding Lighting.UseLighting}" />
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Lighting.UseLighting}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="控制器" Margin="0,0,0,4" FontSize="11" />
                                            <ComboBox ItemsSource="{Binding Lighting.LightControllerIds}"
                                                      SelectedItem="{Binding Lighting.SelectedLightControllerId,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="通道（≥1）" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Lighting.LightChannel}"
                                                          Minimum="1" Maximum="64" SmallChange="1"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="亮度(0-255)" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Lighting.LightBrightness}"
                                                          Minimum="0" Maximum="255" SmallChange="5"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="稳定延时(ms)" Margin="0,0,0,4" FontSize="11" />
                                            <ui:NumberBox Value="{Binding Lighting.LightStabilizeDelayMs}"
                                                          Minimum="0" Maximum="10000" SmallChange="5"
                                                          SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox Content="取图完成后熄灯（常亮场景可取消）" FontSize="11"
                                              IsChecked="{Binding Lighting.LightTurnOffAfterGrab}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
</UserControl>
