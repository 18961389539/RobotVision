<ui:FluentWindow x:Class="RobotVision.WpfHost.Features.Recipe.RefineMethodDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="精修参数"
        Width="560" Height="640"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding MethodTitle}" />

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="确定" Appearance="Primary" Margin="0,0,8,0" Command="{Binding AcceptCommand}" />
                <ui:Button Content="取消" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{Binding MethodHint}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- 通用 -->
                <ui:TextBlock FontTypography="BodyStrong" Text="通用" Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,12">
                    <StackPanel Width="130" Margin="0,0,12,8">
                        <TextBlock Text="期望件数" FontSize="11" Margin="0,0,0,4"
                                   ToolTip="0 = 不检查件数；不符则全部 1019" />
                        <ui:NumberBox Value="{Binding Template.ExpectedCount}"
                                      Minimum="0" Maximum="20" SmallChange="1"
                                      SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                </WrapPanel>
                <CheckBox Content="精修失败时回退粗角（无方向，不推荐）" FontSize="11" Margin="0,0,0,16"
                          IsChecked="{Binding Template.AllowCoarseFallback}"
                          ToolTip="关闭（默认）：精修不过门返回 1019。打开则输出无向粗角。" />

                <!-- 示教 -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding NeedsTaughtTemplate, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="示教模板" Padding="10,4" FontSize="11"
                                   Command="{Binding TeachTemplateCommand}" />
                        <ui:TextBlock FontTypography="BodyStrong" Text="示教" VerticalAlignment="Center" />
                    </DockPanel>
                    <Image Source="{Binding TemplatePreview}" MaxHeight="96" Stretch="Uniform"
                           HorizontalAlignment="Left" Margin="0,0,0,6"
                           Visibility="{Binding HasTemplate, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding TemplateStatusText}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TeachDiagnosticsHint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasTeachDiagnostics, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!-- 极性（卡尺 / 模板） -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding ShowPolarity, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:TextBlock FontTypography="BodyStrong" Text="极性" Margin="0,0,0,8" />
                    <TextBlock Text="壳体边缘极性" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding EdgePolarityOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Template.HousingEdgePolarity}"
                              SelectionChanged="Polarity_SelectionChanged"
                              Margin="0,0,0,8" />
                    <TextBlock Text="凸起侧（示教记录）" FontSize="11" Margin="0,0,0,4"
                               Visibility="{Binding ShowCaliperPanel, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ComboBox ItemsSource="{Binding TabPolarityOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Template.TabPolarity}"
                              SelectionChanged="Polarity_SelectionChanged"
                              Visibility="{Binding ShowCaliperPanel, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding PolarityLockHint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasPolarityLockHint, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!-- 模板匹配 -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding ShowTemplatePanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:TextBlock FontTypography="BodyStrong" Text="模板匹配" Margin="0,0,0,8" />
                    <WrapPanel>
                        <StackPanel Width="130" Margin="0,0,12,8">
                            <TextBlock Text="匹配阈值" FontSize="11" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding Template.MatchThreshold}"
                                          Minimum="0" Maximum="1" SmallChange="0.05"
                                          SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,8"
                                    Visibility="{Binding ShowRefineRange, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="精修范围(°)" FontSize="11" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding Template.RefineRangeDeg}"
                                          Minimum="1" Maximum="45" SmallChange="1"
                                          SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </WrapPanel>
                    <CheckBox Content="转正裁剪窗" FontSize="11" Margin="0,4,0,4"
                              IsChecked="{Binding Template.UseUprightCrop}" />
                    <CheckBox Content="边缘图定角（更准）" FontSize="11" Margin="0,0,0,4"
                              IsChecked="{Binding Template.UseEdgeMatch}" />
                    <TextBlock Text="{Binding TeachPeakHint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 形状匹配 -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding ShowShapePanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:TextBlock FontTypography="BodyStrong" Text="形状匹配" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <StackPanel Width="130" Margin="0,0,12,8">
                            <TextBlock Text="匹配阈值" FontSize="11" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding Template.MatchThreshold}"
                                          Minimum="0" Maximum="1" SmallChange="0.05"
                                          SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,8"
                                    Visibility="{Binding ShowRefineRange, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="精修范围(°)" FontSize="11" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding Template.RefineRangeDeg}"
                                          Minimum="1" Maximum="45" SmallChange="1"
                                          SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="固定使用转正裁剪（与模板「转正裁剪窗」无关）。试触发/监控会叠青色命中点、红色未命中点。" />
                    <TextBlock Text="{Binding RefineMethodScoreHint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasRefineMethodScoreHint, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding LastRefineQualityHint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasRefineQualityHint, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!-- SIFT -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding ShowSiftPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:TextBlock FontTypography="BodyStrong" Text="SIFT 特征匹配" Margin="0,0,0,8" />
                    <StackPanel Width="130" Margin="0,0,0,8">
                        <TextBlock Text="匹配阈值" FontSize="11" Margin="0,0,0,4" />
                        <ui:NumberBox Value="{Binding Template.MatchThreshold}"
                                      Minimum="0" Maximum="1" SmallChange="0.05"
                                      SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="必须示教整颗目标，不能框局部特征。试触发/监控会叠特征内点（青）与外点（红）。" />
                    <TextBlock Text="{Binding RefineMethodScoreHint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasRefineMethodScoreHint, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding LastRefineQualityHint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasRefineQualityHint, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!-- 卡尺 -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding ShowCaliperPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:TextBlock FontTypography="BodyStrong" Text="卡尺 + 凸起" Margin="0,0,0,8" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="无需示教模板。试触发/监控会叠卡尺探针与抓边点。极性见上方。" />
                </StackPanel>

                <!-- 孔槽 -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding ShowCentroidPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:TextBlock FontTypography="BodyStrong" Text="质心-孔槽连线" Margin="0,0,0,8" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="分割掩码须能检出孔或槽；角度由质心指向最大内标。无额外阈值项。" />
                </StackPanel>

                <!-- 直线拟合 -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding ShowLineFitPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:TextBlock FontTypography="BodyStrong" Text="直线拟合" Margin="0,0,0,8" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#FFE8A33D"
                               Text="角度无方向 [0,180)，不能与偏心工具同用。弱纹理矩形件适用。" />
                </StackPanel>

                <!-- 特征框 -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding ShowFeatureRoi, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:TextBlock FontTypography="BodyStrong" Text="示教特征框" Margin="0,0,0,8" />
                    <CheckBox Content="单独框选特征（示教裁这块）" FontSize="11" Margin="0,0,0,8"
                              IsChecked="{Binding Roi.UseTemplateRoi}" />
                    <TextBlock Text="{Binding FeatureGrabOriginHint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasFeatureGrabOriginHint, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <StackPanel Visibility="{Binding Roi.UseTemplateRoi, Converter={StaticResource BoolToVisibilityConverter}}">
                        <UniformGrid Columns="4" Margin="0,0,0,8"
                                       Visibility="{Binding Roi.HasRoiRefFrame, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="0,0,8,4">
                                <TextBlock Text="X (px)" FontSize="11" Margin="0,0,0,2" />
                                <ui:NumberBox Value="{Binding Roi.TemplateRoiPxX}" Minimum="0"
                                              Maximum="{Binding Roi.RoiRefWidth}" SmallChange="1"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,4">
                                <TextBlock Text="Y (px)" FontSize="11" Margin="0,0,0,2" />
                                <ui:NumberBox Value="{Binding Roi.TemplateRoiPxY}" Minimum="0"
                                              Maximum="{Binding Roi.RoiRefHeight}" SmallChange="1"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,4">
                                <TextBlock Text="W (px)" FontSize="11" Margin="0,0,0,2" />
                                <ui:NumberBox Value="{Binding Roi.TemplateRoiPxWidth}" Minimum="1"
                                              Maximum="{Binding Roi.RoiRefWidth}" SmallChange="1"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="H (px)" FontSize="11" Margin="0,0,0,2" />
                                <ui:NumberBox Value="{Binding Roi.TemplateRoiPxHeight}" Minimum="1"
                                              Maximum="{Binding Roi.RoiRefHeight}" SmallChange="1"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:Button Content="在配方页框选特征…" FontSize="11" Padding="10,4" HorizontalAlignment="Left"
                                   Command="{Binding DrawFeatureRoiCommand}"
                                   ToolTip="关闭本窗口并在结果图上拖出橙色特征框" />
                    </StackPanel>
                </StackPanel>

                <!-- 几何过门 -->
                <StackPanel Margin="0,0,0,8">
                    <ui:TextBlock FontTypography="BodyStrong" Text="几何过门" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding TeachGeometryHint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <WrapPanel Visibility="{Binding ShowGeometryGates, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Width="118" Margin="0,0,8,8">
                            <TextBlock Text="面积下限倍" FontSize="11" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding Template.AreaRatioLo}" Minimum="0.1" Maximum="2"
                                          SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Width="118" Margin="0,0,8,8">
                            <TextBlock Text="面积上限倍" FontSize="11" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding Template.AreaRatioHi}" Minimum="0.5" Maximum="5"
                                          SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Width="118" Margin="0,0,8,8">
                            <TextBlock Text="轴比下限倍" FontSize="11" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding Template.AspectRatioLo}" Minimum="0.1" Maximum="2"
                                          SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Width="118" Margin="0,0,0,8">
                            <TextBlock Text="轴比上限倍" FontSize="11" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding Template.AspectRatioHi}" Minimum="0.5" Maximum="5"
                                          SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
