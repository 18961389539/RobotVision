<ui:FluentWindow x:Class="RobotVision.WpfHost.Features.Recipe.RecipeSetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:recipe="clr-namespace:RobotVision.WpfHost.Features.Recipe"
        Title="配方向导"
        Width="980" Height="680"
        MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="配方向导" />

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="1" Content="上一步" Margin="12,0,8,0"
                           Command="{Binding BackCommand}" />
                <ui:Button Grid.Column="2" Content="{Binding NextLabel}" Margin="0,0,8,0"
                           Command="{Binding NextCommand}"
                           Visibility="{Binding ShowNext, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ui:Button Grid.Column="3" Content="{Binding ApplyLabel}" Appearance="Primary" Margin="0,0,8,0"
                           Command="{Binding ApplyCommand}"
                           ToolTip="写入当前编辑器：角度模式、精修、极性、件数、阈值。需要示教时关闭后自动打开示教。不改产线 TRIGGER。" />
                <ui:Button Grid.Column="4" Content="取消" Command="{Binding CancelCommand}" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0" Padding="12,16">
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" BorderThickness="3,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Padding="10,8" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Step}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Width="18" />
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding StepCaption}" Margin="20,16,20,8" Opacity="0.65" FontSize="12" />
                <Border x:Name="PreviewHost" Grid.Row="1" Margin="20,0,20,8" Height="240" Background="#0A0F16" CornerRadius="4" ClipToBounds="True"
                        SizeChanged="OnPreviewHostSizeChanged"
                        Visibility="{Binding ShowPreviewPane, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform"
                               SizeChanged="OnPreviewHostSizeChanged" />
                        <Rectangle x:Name="FeatureOverlay" Stroke="#FFD700" StrokeThickness="2"
                                   Fill="#28FFD700" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                        <TextBlock Text="分析后在此显示取景。点下方训练区域时画面保持这一帧，只换金色特征框。"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FFB8C0CC" TextWrapping="Wrap" Margin="16" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" Padding="20,8,20,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                    <!-- 欢迎 -->
                    <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:TextBlock Text="按场景选配方，而不是只比精修分数" FontTypography="Subtitle" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"
                                   Text="这个向导把推荐拆成四步：任务要什么 → 分析当前件长什么样 → 给出角度模式（不只是六种精修）→ 写入编辑器。产线 TRIGGER 仍用你保存后的配方；这里只改编辑器。" />
                        <TextBlock Margin="0,14,0,6" FontWeight="SemiBold" Text="会考虑" />
                        <TextBlock TextWrapping="Wrap" LineHeight="20"
                                   Text="• 要不要头尾（有向角）&#x0a;• 能不能示教、外观会不会变&#x0a;• 两个定位特征 / 无模型双 BLOB&#x0a;• 壳体孔槽、凸起、剪影、丝印、近圆&#x0a;• 文件夹整夹赛马：过门率 × 均分 × 角度稳定性（角σ）" />
                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="固定工位同一颗料不必做多尺寸模板。特征框用相对壳体的一块不对称区域，不要用 8×8 / 16×16。" />
                    </StackPanel>

                    <!-- 任务 -->
                    <StackPanel Visibility="{Binding IsTask, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:TextBlock Text="任务约束" FontTypography="Subtitle" />
                        <TextBlock Margin="0,8,0,12" TextWrapping="Wrap"
                                   Text="先告诉系统这工位要什么。约束会过滤不能用的路径（例如不要头尾时不会强推卡尺极性）。" />
                        <CheckBox Content="需要有向角（头尾要分清，偏心工具必须勾选）"
                                  IsChecked="{Binding NeedDirectedAngle}" Margin="0,0,0,8" />
                        <CheckBox Content="允许示教模板（模板 / SIFT / 形状匹配）"
                                  IsChecked="{Binding TeachAllowed}" Margin="0,0,0,8" />
                        <CheckBox Content="外观会变（磨损、油污、光照漂）——避开灰度 NCC"
                                  IsChecked="{Binding AppearanceVaries}" Margin="0,0,0,8" />
                        <CheckBox Content="画面上有两个稳定特征（孔、PIN、Mark）——优先连线，不走壳体精修"
                                  IsChecked="{Binding HasTwoLandmarks}" Margin="0,0,0,8" />
                        <CheckBox Content="用双 BLOB（无需模型，主斑点定位、主→次定向）"
                                  IsChecked="{Binding UseBlobsWithoutModel}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="期望件数" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ui:NumberBox Width="100" Value="{Binding ExpectedCount}"
                                          Minimum="0" Maximum="20" SmallChange="1"
                                          SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="期望件数写入「分割+精修」配方。0 = 不检查件数（不会改成 1）。" />
                    </StackPanel>

                    <!-- 分析 -->
                    <StackPanel Visibility="{Binding IsAnalyze, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:TextBlock Text="分析画面" FontTypography="Subtitle" />
                        <TextBlock Margin="0,8,0,8" Text="{Binding CameraHint}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding AnalyzeHint}" />
                        <CheckBox Content="文件夹相机：对目录内全部图片打分（磁盘解码，不推进产线回放下标）"
                                  IsChecked="{Binding ScoreAllPlayback}" Margin="0,0,0,12"
                                  Visibility="{Binding IsFileCamera, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="分析当前画面" Appearance="Primary" HorizontalAlignment="Left"
                                       Command="{Binding AnalyzeCommand}"
                                       ToolTip="取一帧（或整夹）分割、分类场景、精修赛马。不写入配方。" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="分析中…" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 建议 -->
                    <StackPanel Visibility="{Binding IsResult, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:TextBlock Text="建议" FontTypography="Subtitle" />
                        <TextBlock Margin="0,8,0,4" TextWrapping="Wrap" Text="{Binding SceneSummary}" />
                        <Border Margin="0,8,0,12" Padding="12" CornerRadius="6"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                            <Button Command="{Binding ChoosePrimaryCommand}" HorizontalContentAlignment="Left"
                                    Padding="0" Background="Transparent" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="主建议（点击采用此项）" FontSize="12" Opacity="0.7" />
                                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" FontSize="16"
                                               Text="{Binding PrimaryTitle}" />
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding PrimaryWhy}" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ChosenHint}" />
                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Text="{Binding ConfidenceNote}" />
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding PlaybookSummary}" />

                        <TextBlock FontWeight="SemiBold" Margin="0,8,0,6" Text="备选（点击采用）" />
                        <ItemsControl ItemsSource="{Binding AlternativeRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,6" Padding="8,6" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.ChooseAlternativeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Candidate}">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" — " /><Run Text="{Binding Why, Mode=OneWay}" />
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock FontWeight="SemiBold" Margin="0,12,0,6" Text="模板训练区域（NCC / 形状匹配）"
                                   Visibility="{Binding ShowFeatureRoiPicker, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding FeatureRoiHint}"
                                   Visibility="{Binding ShowFeatureRoiPicker, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <DataGrid ItemsSource="{Binding FeatureRoiRows}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" MaxHeight="140"
                                  CanUserAddRows="False" CanUserResizeRows="False"
                                  SelectedIndex="{Binding SelectedFeatureIndex, Mode=TwoWay}"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  EnableRowVirtualization="False"
                                  RequestBringIntoView="OnSuppressBringIntoView"
                                  Visibility="{Binding ShowFeatureRoiPicker, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="窗口" Binding="{Binding Size}" Width="90" />
                                <DataGridTextColumn Header="0/180 分差" Binding="{Binding Gap}" Width="90" />
                                <DataGridCheckBoxColumn Header="最高差" Binding="{Binding Best}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock FontWeight="SemiBold" Margin="0,12,0,6" Text="精修赛马（过门率 × 均分 × 角稳定性；点选有资格的一行可改为采用）" />
                        <DataGrid ItemsSource="{Binding BakeOffRows}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180"
                                  CanUserAddRows="False" CanUserResizeRows="False"
                                  SelectedIndex="{Binding SelectedBakeOffIndex, Mode=TwoWay}"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  EnableRowVirtualization="False"
                                  RequestBringIntoView="OnSuppressBringIntoView">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="120" />
                                <DataGridTextColumn Header="分" Binding="{Binding Score}" Width="70" />
                                <DataGridCheckBoxColumn Header="过门" Binding="{Binding Ok}" Width="50" />
                                <DataGridCheckBoxColumn Header="资格" Binding="{Binding Eligible}" Width="50" />
                                <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock FontWeight="SemiBold" Margin="0,12,0,6" Text="方法已定后的参数寻优（过门率 × 均分 × 角稳定性；点选一行可改匹配门）" />
                        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding ParamTuneHint}" />
                        <DataGrid ItemsSource="{Binding ParamTuneRows}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" MaxHeight="140"
                                  CanUserAddRows="False" CanUserResizeRows="False"
                                  SelectedIndex="{Binding SelectedParamTuneIndex, Mode=TwoWay}"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  EnableRowVirtualization="False"
                                  RequestBringIntoView="OnSuppressBringIntoView"
                                  Visibility="{Binding HasParamTuneRows, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="参数" Binding="{Binding Label}" Width="110" />
                                <DataGridTextColumn Header="分" Binding="{Binding Score}" Width="70" />
                                <DataGridCheckBoxColumn Header="采用" Binding="{Binding Best}" Width="50" />
                                <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ui:Button Content="再分析一帧 / 整夹" Margin="0,12,0,0" HorizontalAlignment="Left"
                                   Command="{Binding AnalyzeCommand}" />
                        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="预览：绿框=检测 ROI，金框=建议特征，绿轮廓=置信最高件，青轮廓=其余件，青线=卡尺探针，品红=拟合边。点「采用并关闭」只写编辑器；需要示教时会接着打开「示教模板」。请再「测试触发」确认，保存后才上产线。" />
                    </StackPanel>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.ColumnSpan="2" Background="#99000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsHitTestVisible="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="16"
                               Foreground="White" Text="{Binding Message}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
