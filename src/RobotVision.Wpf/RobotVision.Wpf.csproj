<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="OxyPlot.Wpf" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RobotVision.Hosting\RobotVision.Hosting.csproj" />
    <ProjectReference Include="..\RobotVision.Teach\RobotVision.Teach.csproj" />
    <ProjectReference Include="..\ImageViewerControl\ImageViewerControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RobotVision.Wpf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 仅拷贝示例配方 JSON；大体积 ONNX 与运行时数据由 appsettings DataRoot / ModelsFolder 指向，避免每次构建复制整包。 -->
    <None Include="..\..\recipes\*.json" CopyToOutputDirectory="PreserveNewest" Link="recipes.samples\%(Filename)%(Extension)" />
    <!-- MaskCaliperTabTimingTests 从 bin 的 recipes\ 读 OSDP.json；上面的通配只拷到 recipes.samples\，这里显式补拷一份。 -->
    <None Include="..\..\recipes\OSDP.json" CopyToOutputDirectory="PreserveNewest" Link="recipes\OSDP.json" />
    <None Include="..\..\data\calibration\**\*" CopyToOutputDirectory="PreserveNewest" Link="data\calibration\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\data\replay\**\*" CopyToOutputDirectory="PreserveNewest" Link="data\replay\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\RobotVision.ChatUi\dist\**\*" CopyToOutputDirectory="PreserveNewest" Link="chat-ui\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\RobotVision.ChatUi\dist\index.html')" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
