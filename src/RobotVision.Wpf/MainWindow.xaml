<ui:FluentWindow x:Class="RobotVision.WpfHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:monitor="clr-namespace:RobotVision.WpfHost.Features.Monitor"
        xmlns:cameras="clr-namespace:RobotVision.WpfHost.Features.Cameras"
        xmlns:lightings="clr-namespace:RobotVision.WpfHost.Features.Lightings"
        xmlns:recipe="clr-namespace:RobotVision.WpfHost.Features.Recipe"
        xmlns:models="clr-namespace:RobotVision.WpfHost.Features.Models"
        xmlns:calibration="clr-namespace:RobotVision.WpfHost.Features.Calibration"
        xmlns:wizard="clr-namespace:RobotVision.WpfHost.Features.CalibrationWizard"
        xmlns:failures="clr-namespace:RobotVision.WpfHost.Features.Failures"
        xmlns:analysis="clr-namespace:RobotVision.WpfHost.Features.Analysis"
        xmlns:communication="clr-namespace:RobotVision.WpfHost.Features.Communication"
        xmlns:logs="clr-namespace:RobotVision.WpfHost.Features.Logs"
        xmlns:settings="clr-namespace:RobotVision.WpfHost.Features.Settings"
        xmlns:sys="clr-namespace:RobotVision.WpfHost.Features.SystemInfo"
        xmlns:about="clr-namespace:RobotVision.WpfHost.Features.About"
        xmlns:chat="clr-namespace:RobotVision.WpfHost.Features.Chat"
        Title="RobotVision 视觉调试"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="600"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="RobotVision 视觉调试" />

        <!-- 全局状态栏：所有页面可） -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- TCP 服务状态圆点：● 运行 / ○ 未启动） -->
                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill"
                                    Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTcpRunning}" Value="True">
                                    <Setter Property="Fill"
                                            Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="{Binding TcpStatus}" Margin="6,0,0,0"
                           VerticalAlignment="Center" />
                <!-- 后台/启动期故障提示：仅当 ShellViewModel.Notice 非空时显示，不被 1s 轮询覆盖 -->
                <TextBlock Grid.Column="2" Text="{Binding Notice}" Margin="16,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           ToolTip="{Binding Notice}"
                           Visibility="{Binding Notice, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Grid.Column="3" Text="TCP: 配方名/序列号 / PING" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>

        <ui:NavigationView x:Name="Nav"
                           Margin="4,0,0,0"
                           IsBackButtonVisible="Auto"
                           PaneDisplayMode="Left"
                           OpenPaneLength="196">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="运行监控" TargetPageType="{x:Type monitor:MonitorPage}"
                                       Icon="{ui:SymbolIcon Home24}" />
                <ui:NavigationViewItem Content="相机管理" TargetPageType="{x:Type cameras:CamerasPage}"
                                       Icon="{ui:SymbolIcon Camera24}" />
                <ui:NavigationViewItem Content="光源管理" TargetPageType="{x:Type lightings:LightingsPage}"
                                       Icon="{ui:SymbolIcon Lightbulb24}" />
                <ui:NavigationViewItem Content="配方管理" TargetPageType="{x:Type recipe:RecipePage}"
                                       Icon="{ui:SymbolIcon DocumentEdit24}" />
                <ui:NavigationViewItem Content="模型管理" TargetPageType="{x:Type models:ModelsPage}"
                                       Icon="{ui:SymbolIcon Cube24}" />
                <ui:NavigationViewItem Content="标定档案" TargetPageType="{x:Type calibration:CalibrationPage}"
                                       Icon="{ui:SymbolIcon Wrench24}" />
                <ui:NavigationViewItem Content="标定向导" TargetPageType="{x:Type wizard:CalibrationWizardPage}"
                                       Icon="{ui:SymbolIcon BookCompass24}" />
                <ui:NavigationViewItem Content="失败现场" TargetPageType="{x:Type failures:FailuresPage}"
                                       Icon="{ui:SymbolIcon ImageMultiple24}" />
                <ui:NavigationViewItem Content="结果分析" TargetPageType="{x:Type analysis:AnalysisPage}"
                                       Icon="{ui:SymbolIcon DataBarVertical24}" />
                <ui:NavigationViewItem Content="通信监控" TargetPageType="{x:Type communication:CommunicationPage}"
                                       Icon="{ui:SymbolIcon PlugConnected24}" />
                <ui:NavigationViewItem Content="工艺助手" TargetPageType="{x:Type chat:ChatPage}"
                                       Icon="{ui:SymbolIcon Chat24}" />
                <ui:NavigationViewItem Content="日志浏览" TargetPageType="{x:Type logs:LogsPage}"
                                       Icon="{ui:SymbolIcon DocumentSearch24}" />
                <ui:NavigationViewItem Content="服务设置" TargetPageType="{x:Type settings:SettingsPage}"
                                       Icon="{ui:SymbolIcon Options24}" />
                <ui:NavigationViewItem Content="系统信息" TargetPageType="{x:Type sys:SystemPage}"
                                       Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="关于" TargetPageType="{x:Type about:AboutPage}"
                                       Icon="{ui:SymbolIcon Info24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </DockPanel>
</ui:FluentWindow>
