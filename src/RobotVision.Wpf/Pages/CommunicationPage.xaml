<Page x:Class="RobotVision.WpfHost.Pages.CommunicationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="通信监控"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ToggleServiceCommand}" />
    </Page.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 服务状态与操作 -->
        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding ServiceStatus}"
                              VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SummaryText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding LastTcpLineText}" FontFamily="Consolas" FontSize="12"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding LastTcpLineText}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="{Binding ToggleButtonLabel}"
                           Command="{Binding ToggleServiceCommand}" />
                <ui:Button Grid.Column="3" Content="清空记录" Margin="8,0,0,0"
                           Command="{Binding ClearRequestsCommand}" />
            </Grid>
        </ui:Card>

        <!-- 方案 A：统计迷你卡（4 个核心指标一瞥即知） -->
        <ui:Card Grid.Row="1" Margin="0,0,0,8" Padding="16,10">
            <UniformGrid Columns="4">
                <StackPanel>
                    <TextBlock Text="当前连接" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding ConnectedClients}" FontSize="26" FontWeight="SemiBold"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="累计请求" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding TotalRequestsText}" FontSize="26" FontWeight="SemiBold"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="触发成功率" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding SuccessRateText}" FontSize="26" FontWeight="SemiBold"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="平均耗时" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding AvgMsText}" FontSize="26" FontWeight="SemiBold"
                               Margin="0,2,0,0" />
                </StackPanel>
            </UniformGrid>
        </ui:Card>

        <!-- 默认打开「请求历史」：PING / 未知序列号等不会进入「运行统计」 -->
        <TabControl Grid.Row="2" SelectedIndex="0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="请求历史" />
                        <TextBlock Text="{Binding Requests.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <TextBlock Text="暂无 TCP 请求。确认顶部为「运行中」。报文可带或不带换行（LF）；未知序列号会显示 ERR,1001，不会出现在「运行统计」。"
                               TextWrapping="Wrap" Margin="8" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRequests}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox ItemsSource="{Binding Requests}" FontFamily="Consolas"
                             Background="Transparent" BorderThickness="0"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Client}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Request}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding ReplyTrimmed}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Result}" FontSize="11"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter Property="Foreground" Value="#6BCB77" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Foreground" Value="#FF6B6B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="5" Text="{Binding ElapsedText}" FontSize="11"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="运行统计" />
                        <TextBlock Text="{Binding StatsRows.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <!-- 仅统计进入 VisionService 的配方触发；TCP 协议错误（1001 未知序列号等）只在「请求历史」 -->
                <Grid>
                    <TextBlock Text="暂无配方触发。此处只统计真正跑过视觉管线的配方；#1 未绑定序列号时只会在「请求历史」出现 ERR,1001。"
                               TextWrapping="Wrap" Margin="8" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStats}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                        <ItemsControl ItemsSource="{Binding StatsRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,7"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBlock Text="{Binding Recipe}" FontTypography="BodyStrong"
                                                          TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1"
                                                         Value="{Binding Rate}" Height="6"
                                                         VerticalAlignment="Center" Margin="10,0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tier}" Value="warn">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tier}" Value="poor">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Grid.Column="2" Text="{Binding SuccessRate}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                        <TextBlock FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="触发 " /><Run Text="{Binding Total, StringFormat={}{0:N0}}" />
                                            <Run Text=" · 成功 " /><Run Text="{Binding Ok, StringFormat={}{0:N0}}" />
                                            <Run Text=" · 失败 " /><Run Text="{Binding Failed, StringFormat={}{0:N0}}" />
                                            <Run Text=" · 平均 " /><Run Text="{Binding AvgMs}" /><Run Text=" ms" />
                                            <Run Text=" · 最近 " /><Run Text="{Binding LastMs}" /><Run Text=" ms" />
                                            <Run Text=" · 最近触发 " /><Run Text="{Binding LastAt}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前连接" />
                        <TextBlock Text="{Binding Clients.Count}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </TabItem.Header>
                <!-- 方案 A：连接卡片流（替代 DataGrid） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding Clients}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="210" Margin="0,0,8,8" Padding="10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <ui:TextBlock Grid.Column="1" Text="{Binding Ip}" FontTypography="BodyStrong"
                                                          TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
                                        </Grid>
                                        <TextBlock FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="端口 " /><Run Text="{Binding Port}" />
                                            <Run Text=" · 接入 " /><Run Text="{Binding ConnectedAt, StringFormat=HH:mm:ss}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="请求 " /><Run Text="{Binding Requests, StringFormat={}{0:N0}}" />
                                            <Run Text=" · 收 " /><Run Text="{Binding BytesIn, StringFormat={}{0:N0}}" />
                                            <Run Text=" · 发 " /><Run Text="{Binding BytesOut, StringFormat={}{0:N0}}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="最近: " /><Run Text="{Binding LastRequest}" />
                                        </TextBlock>
                                        <ui:Button Content="断开" FontSize="11" Padding="10,3" Margin="0,8,0,0"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.DisconnectClientCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
