<Page x:Class="RobotVision.WpfHost.Pages.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      Title="运行监控"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding TriggerCommand}" />
    </Page.InputBindings>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <!-- 画面区：统一使用 ImageViewer 控件（缩放/平移/像素信息/测量） -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
            <Border Background="#1E1E1E" CornerRadius="4" ClipToBounds="True">
                <ivc:ImageViewer x:Name="Viewer" ImageSource="{Binding DisplayImage}"
                                 IsToolbarVisible="False" />
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#B0000000" CornerRadius="3" Padding="8,4" Margin="8"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding StatusText}" Foreground="White" />
            </Border>
            <!-- 触发结果横幅：成功绿 / 失败红，远距可读；无结果时不显示 -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    CornerRadius="3" Padding="12,6" Margin="8"
                    IsHitTestVisible="False" Panel.ZIndex="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Background" Value="#C01E7A46" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TriggerBannerText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TriggerSuccess}" Value="False">
                                <Setter Property="Background" Value="#C0A32D2D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding TriggerBannerText}" Foreground="White"
                           FontWeight="SemiBold" FontSize="13" />
            </Border>
        </Grid>

        <!-- 右侧控制面板 -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel>
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="相机" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Cameras}"
                                  SelectedItem="{Binding SelectedCamera}" />
                        <CheckBox Content="实时预览（0.5s/帧）"
                                  IsChecked="{Binding PreviewEnabled}" Margin="0,10,0,0" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="配方" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Recipes}"
                                      SelectedItem="{Binding SelectedRecipe}" />
                            <ui:Button Grid.Column="1" Content="刷新" Margin="8,0,0,0"
                                       Command="{Binding RefreshRecipesCommand}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="触发" Margin="0,0,0,8" />
                        <ui:Button Appearance="Primary"
                                   Content="{Binding TriggerButtonText}"
                                   IsEnabled="{Binding CanTrigger}"
                                   FontSize="14"
                                   ToolTip="触发一次完整流程：取图 → 去畸变 → 推理 → 坐标变换（快捷键 F5）"
                                   Command="{Binding TriggerCommand}" />
                        <CheckBox Content="上报拍照位姿（末端相机必须勾选）"
                                  IsChecked="{Binding IncludeTriggerPose}" Margin="0,8,0,4" FontSize="11" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="X mm" FontSize="10" />
                                <ui:NumberBox Value="{Binding TriggerPoseX}" SmallChange="0.1"
                                              IsEnabled="{Binding IncludeTriggerPose}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Y mm" FontSize="10" />
                                <ui:NumberBox Value="{Binding TriggerPoseY}" SmallChange="0.1"
                                              IsEnabled="{Binding IncludeTriggerPose}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="RZ °" FontSize="10" />
                                <ui:NumberBox Value="{Binding TriggerPoseRz}" SmallChange="0.1"
                                              IsEnabled="{Binding IncludeTriggerPose}" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:Button Appearance="Secondary" Content="恢复预览"
                                   Margin="0,8,0,0"
                                   Command="{Binding ResumePreviewCommand}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="结果（机器人坐标）" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Poses}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  MinHeight="120"
                                  EnableRowVirtualization="False"
                                  EnableColumnVirtualization="False"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="32" />
                                <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat=F3}" Width="*" />
                                <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat=F3}" Width="*" />
                                <DataGridTextColumn Binding="{Binding AngleDeg, StringFormat=F3}" Width="*">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="角度 (°)" ToolTip="范围 (-180, 180]；[0,360) 表示的机器人由 PLC 换算（负角 +360）" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="置信度" Binding="{Binding Score, StringFormat=F3}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部日志 -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="8"
                VerticalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" FontFamily="Consolas"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter Property="Background" Value="#3D791F1F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Critical">
                                    <Setter Property="Background" Value="#3D791F1F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Background" Value="#2D633806" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Time}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Run Text="{Binding Level}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Run Text="{Binding Message}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,0">
                    <TextBlock Text="级别" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ComboBox ItemsSource="{Binding LogFilterOptions}" SelectedItem="{Binding LogFilter}"
                              Width="110" VerticalContentAlignment="Center" />
                    <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}"
                              VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ui:Button Content="清空" Margin="12,0,0,0"
                               Command="{Binding ClearLogCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
