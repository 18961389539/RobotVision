<Page x:Class="RobotVision.WpfHost.Pages.ModelsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      Title="模型管理"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：模型文件列表 -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong" Text="ONNX 模型" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="16,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Message}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" />
                    <ui:Button Grid.Column="3" Content="打开模型目录" Margin="8,0,0,0"
                               Command="{Binding OpenFolderCommand}" />
                </Grid>
            </ui:Card>

            <!-- 方案 B：模型文件卡片流（ListBox + WrapPanel，替代 DataGrid 白底） -->
            <Border Grid.Row="1" Padding="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Margin="3" Padding="8" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"
                                                Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected,
                                                RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource SystemFillColorAccentBrush}" />
                                                <Setter Property="Background"
                                                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Loaded}" Value="True">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <ui:TextBlock Grid.Column="1" Text="{Binding Name}" FontTypography="BodyStrong"
                                                      TextTrimming="CharacterEllipsis" Margin="6,0,0,0"
                                                      ToolTip="{Binding Name}" />
                                    </Grid>
                                    <TextBlock Text="{Binding SizeText}" FontSize="10" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding LoadedText}" FontSize="10" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding LoadedText}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 卸载操作：模型文件被替换后需重新加载新会话（Unload 后下次推理自动重建） -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Content="卸载选中" Command="{Binding UnloadCommand}" />
                <ui:Button Grid.Column="1" Content="全部卸载" Margin="8,0,0,0"
                           Command="{Binding UnloadAllCommand}" />
                <ui:TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                              FontSize="11" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              Text="替换 .onnx 后先卸载再推理，避免继续使用旧会话；会话数超上限时自动回收最久未用的" />
            </Grid>
        </Grid>

        <!-- 右：图像主导 + 参数浮动面板（方案 A，与相机页同构） -->
        <Grid Grid.Column="1">

            <!-- 主导图像区：占满右栏，ImageViewer 支持缩放/平移/像素信息 -->
            <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
                <ivc:ImageViewer ImageSource="{Binding ResultImage}" IsToolbarVisible="False" />
            </Border>

            <!-- 推理状态/结果角标（左上角，半透明黑底白字） -->
            <Border Background="#66000000" CornerRadius="3" Padding="8,4" Margin="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="30">
                <TextBlock Text="{Binding TestResult}" FontSize="11" Foreground="White"
                           TextWrapping="Wrap" MaxWidth="520" />
            </Border>

            <!-- 面板收起时的"参数"重新打开按钮 -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Content="参数" Padding="14,8" FontWeight="SemiBold"
                    Panel.ZIndex="30"
                    Command="{Binding ToggleParamPanelCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 参数浮动面板（右上角，可折叠） -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="352" Margin="12" Panel.ZIndex="20"
                    Background="#F01E2836"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding IsParamPanelVisible,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer MaxHeight="720" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <!-- 面板头：标题 + 收起 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="模型测试" FontTypography="BodyStrong" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="收起" Padding="10,4" FontSize="12"
                                    Command="{Binding ToggleParamPanelCommand}" />
                        </Grid>

                        <!-- 模型与任务 -->
                        <ui:CardExpander Header="模型与任务" IsExpanded="True" Margin="0,0,0,6">
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="模型" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SelectedFile.Name, Mode=OneWay}" IsReadOnly="True" />
                                </StackPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="推理任务" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding TaskOptions}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedTask}"
                                                  DisplayMemberPath="Label" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="IoU 阈值" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding Iou}" Minimum="0.01" Maximum="0.99"
                                                      SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="置信度阈值" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding Confidence}" Minimum="0.01" Maximum="0.99"
                                                      SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="像素阈值（分割）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding PixelConfidence}" Minimum="0.01" Maximum="0.99"
                                                      SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </UniformGrid>
                                <ui:TextBlock FontSize="11" TextWrapping="Wrap"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Text="测试推理不经过配方/相机/标定链路，直接验证模型输出；与产线共享会话缓存，互不并发" />
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- 测试图片 -->
                        <ui:CardExpander Header="测试图片" IsExpanded="True" Margin="0,0,0,6">
                            <StackPanel Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding TestImagePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0"
                                               Command="{Binding BrowseTestImageCommand}" />
                                </Grid>
                                <ui:TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Text="默认打开上次图片所在目录；结果图叠加模型原始输出（框/掩码/关键点）" />
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- 操作（不折叠，常驻显示） -->
                        <StackPanel Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Content="开始推理" Appearance="Primary"
                                           IsEnabled="{Binding CanTest}"
                                           Command="{Binding RunTestCommand}" />
                                <ui:Button Grid.Column="1" Content="取消" Margin="8,0,0,0"
                                           Command="{Binding CancelTestCommand}"
                                           Visibility="{Binding IsTesting,
                                               Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ui:TextBlock Grid.Column="2" Margin="12,0,0,0" FontSize="11"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              TextWrapping="Wrap"
                                              Text="取消仅丢弃结果，后台推理不可中断" />
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
