<Page x:Class="RobotVision.WpfHost.Pages.CamerasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      Title="相机管理"
      VerticalAlignment="Stretch"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：相机列表。用标准 Border 替代 ui:Card —— WPF-UI Card 的默认 Style
             VerticalAlignment=Center + 模板行为使局部 VerticalAlignment=Stretch 不生效
             （实测 Card 悬空居中）；Border 无此怪癖，Stretch 可靠撑满整列。 -->
        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" Padding="8"
                VerticalAlignment="Stretch"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="相机" FontTypography="BodyStrong" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="新建" Margin="8,0,0,0"
                               Command="{Binding NewCommand}" />
                    <ui:Button Grid.Column="2" Content="刷新" Margin="4,0,0,0" ToolTip="F5"
                               Command="{Binding RefreshCommand}" />
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{Binding Id}" FontTypography="BodyStrong"
                                                  TextTrimming="CharacterEllipsis" />
                                    <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                                             Margin="6,0,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Registered}" Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="3"
                                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontSize="10" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Registered}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding UnregisteredReason}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           ToolTip="{Binding UnregisteredReason}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnregisteredReason}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="4,8,4,4">
                    <TextBlock Text="{Binding UnsavedHint}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Margin="0,0,0,6"
                               Visibility="{Binding HasUnsavedChanges,
                                   Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右：图像主导 + 参数浮动面板（方案2） -->
        <Grid Grid.Row="0" Grid.Column="1">

            <!-- 主导图像区：占满右栏，ImageViewer 支持缩放/平移/右键菜单 -->
            <Border Background="#0A0F16" CornerRadius="4" ClipToBounds="True">
                <ivc:ImageViewer ImageSource="{Binding PreviewImage}" IsToolbarVisible="False" />
            </Border>

            <!-- 预览角标（实时预览 / 测试取图 语义） -->
            <Border Background="#66000000" CornerRadius="3" Padding="6,2" Margin="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="30"
                    Visibility="{Binding PreviewVisible,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding PreviewCaption}" FontSize="11" Foreground="White" />
            </Border>

            <!-- 面板收起时的"参数"重新打开按钮 -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Content="参数" Padding="14,8" FontWeight="SemiBold"
                    Panel.ZIndex="30"
                    Command="{Binding ToggleParamPanelCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsParamPanelVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 参数浮动面板（右上角，可折叠） -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="352" Margin="12" Panel.ZIndex="20"
                    Background="#F01E2836"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding IsParamPanelVisible,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer MaxHeight="720" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <!-- 面板头：标题 + 收起 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="参数面板" FontTypography="BodyStrong" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="收起" Padding="10,4" FontSize="12"
                                    Command="{Binding ToggleParamPanelCommand}" />
                        </Grid>

                        <!-- 取图 / 实时预览 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Content="取一帧" Command="{Binding TestGrabCommand}" />
                            <ui:Button Grid.Column="1" Content="{Binding PreviewButtonText}" Margin="8,0,0,0"
                                       Command="{Binding TogglePreviewCommand}" />
                            <ui:Button Grid.Column="3" Content="打开目录" Margin="8,0,0,0"
                                       Command="{Binding OpenFolderCommand}" />
                        </Grid>

                        <!-- 基本信息 -->
                        <ui:CardExpander Header="基本信息" IsExpanded="True" Margin="0,0,0,6">
                            <StackPanel Margin="0,10,0,0">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="相机 Id（字母/数字/_/-）" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditId, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsNew}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="类型" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding TypeOptions}"
                                                  SelectedItem="{Binding EditType}" />
                                    </StackPanel>
                                </UniformGrid>
                                <ui:TextBlock FontSize="11"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              TextWrapping="Wrap"
                                              Text="保存后立即在运行中的服务上注册生效，无需重启程序；切换类型需重填对应参数" />
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- 类型参数 -->
                        <ui:CardExpander Header="类型参数" IsExpanded="True" Margin="0,0,0,6">
                            <StackPanel Margin="0,10,0,0">
                                <!-- File -->
                                <StackPanel
                                    Visibility="{Binding IsFile,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="回放目录（相对路径以 exe 目录为基准）" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding EditFolder, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0"
                                                       Command="{Binding BrowseFolderCommand}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="回放帧间隔（ms，0 = 不限速）" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Basler -->
                                <StackPanel
                                    Visibility="{Binding IsBasler,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="序列号（留空 = 自动绑定第一台）" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding EditDeviceId, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="枚举设备" Margin="8,26,0,0"
                                                   Command="{Binding EnumerateBaslerCommand}" />
                                    </Grid>
                                    <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding HasBaslerDevices,
                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="本机相机（选中自动填入序列号）" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding BaslerDevices}"
                                                  SelectedItem="{Binding SelectedBaslerDevice}" />
                                    </StackPanel>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,10,8">
                                            <TextBlock Text="曝光（µs，空=不下发）" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding EditExposureUs, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="增益（dB，空=不下发）" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding EditGain, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <StackPanel>
                                        <TextBlock Text="采集超时（ms）" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditGrabTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Virtual -->
                                <StackPanel
                                    Visibility="{Binding IsVirtual,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,10,8">
                                            <TextBlock Text="宽（px）" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding EditWidth, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="高（px）" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding EditHeight, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,10,8">
                                            <TextBlock Text="图案" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding PatternOptions}"
                                                      SelectedItem="{Binding EditPattern}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="棋盘格单元（px）" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding EditCellPx, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,10,8">
                                            <TextBlock Text="模拟曝光延时（ms）" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding EditIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="高斯噪声 σ" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding EditNoiseSigma, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <ui:TextBlock FontSize="11"
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                  TextWrapping="Wrap"
                                                  Text="Chessboard：移动棋盘格（默认 15×11 内角点，可用于内参标定向导）；Shapes：彩色图形；Bars：色条基准图" />
                                </StackPanel>

                                <!-- Unknown（外部工厂注册类型） -->
                                <StackPanel
                                    Visibility="{Binding IsUnknownType,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ui:TextBlock FontSize="11"
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                  TextWrapping="Wrap"
                                                  Text="该类型由外部相机工厂注册，本页未内置编辑字段。测试取图与保存仍可用（按现有配置创建）；如需修改高级参数，请直接编辑 appsettings.json 的 Cameras 节点后重启。" />
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- 运行时调光 -->
                        <ui:CardExpander Header="运行时调光（已注册相机）" Margin="0,0,0,6"
                                     Visibility="{Binding HasLiveExposureControl,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="0,10,0,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock FontTypography="BodyStrong" Text="曝光 / 增益"
                                                  VerticalAlignment="Center" />
                                    <ui:Button Grid.Column="2" Content="读取当前值"
                                               Command="{Binding ReadLiveParamsCommand}" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="曝光" VerticalAlignment="Center" Width="40" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1000"
                                            Value="{Binding ExposureSlider}"
                                            IsMoveToPointEnabled="True" SmallChange="1" LargeChange="50"
                                            TickFrequency="100" TickPlacement="BottomRight"
                                            AutoToolTipPlacement="TopLeft" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding ExposureText}" Width="80"
                                               VerticalAlignment="Center" TextAlignment="Right"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="增益" VerticalAlignment="Center" Width="40" />
                                    <Slider Grid.Column="1" Minimum="{Binding GainMin}" Maximum="{Binding GainMax}"
                                            Value="{Binding Gain}"
                                            IsMoveToPointEnabled="True" SmallChange="0.1" LargeChange="1"
                                            TickFrequency="2" TickPlacement="BottomRight"
                                            AutoToolTipPlacement="TopLeft" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding GainText}" Width="80"
                                               VerticalAlignment="Center" TextAlignment="Right"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Content="应用并取图预览" Appearance="Primary"
                                               Command="{Binding ApplyAndGrabCommand}" />
                                    <ui:Button Grid.Column="1" Content="填入编辑框（保存后生效）" Margin="8,0,0,0"
                                               Command="{Binding SaveLiveParamsCommand}" />
                                </Grid>
                                <ui:TextBlock FontSize="11"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Margin="0,6,0,0" TextWrapping="Wrap"
                                              Text="曝光为对数刻度滑块；下发后立即对产线触发生效。确认亮度合适后点&quot;填入编辑框&quot;，再点&quot;保存&quot;持久化到配置" />
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- 操作与状态（不折叠，常驻显示） -->
                        <StackPanel Margin="0,4,0,0">
                            <ui:TextBlock Text="操作" FontTypography="BodyStrong" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Content="保存" Appearance="Primary"
                                           Command="{Binding SaveCommand}" />
                                <ui:Button Grid.Column="1" Content="复制为新相机" Margin="8,0,0,0"
                                           Command="{Binding CopyCommand}" />
                                <ui:Button Grid.Column="2" Content="删除" Margin="8,0,0,0"
                                           Command="{Binding DeleteCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding Message}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
