<Page x:Class="RobotVision.WpfHost.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="日志浏览"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
    </Page.InputBindings>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：按天的日志文件 -->
        <Border Grid.Column="0" Margin="0,0,8,0" Padding="8"
                VerticalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="日志文件" FontTypography="BodyStrong" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="刷新" Command="{Binding RefreshFilesCommand}" />
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2" Width="190">
                                <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong"
                                              TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Margin="0,2,0,0">
                                    <Run Text="{Binding DateText}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding SizeText}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:Button Grid.Row="2" Content="打开日志目录" Margin="4,8,4,4"
                           Command="{Binding OpenFolderCommand}" />
            </Grid>
        </Border>

        <!-- 右：过滤 + 条目 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="调试" IsChecked="{Binding IncludeDebug}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Content="信息" IsChecked="{Binding IncludeInfo}"
                              Margin="12,0,0,0" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="2" Content="警告" IsChecked="{Binding IncludeWarning}"
                              Margin="12,0,0,0" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="3" Content="错误" IsChecked="{Binding IncludeError}"
                              Margin="12,0,0,0" VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="4" Margin="16,0,0,0" PlaceholderText="关键词过滤（来源或消息）"
                                Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:ToggleSwitch Grid.Column="5" Content="跟随" Margin="12,0,0,0"
                                     IsChecked="{Binding FollowTail}" />
                    <ui:Button Grid.Column="6" Content="重载" Margin="8,0,0,0" ToolTip="重新读取当前文件（F5）"
                               Command="{Binding ReloadCommand}" />
                    <ui:Button Grid.Column="7" Content="清除过滤" Margin="8,0,0,0"
                               Command="{Binding ClearFilterCommand}" />
                </Grid>
            </ui:Card>

            <Border Grid.Row="1" Padding="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="11" Margin="4,6,4,2"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ListBox x:Name="EntryList" ItemsSource="{Binding Rows}"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" VerticalAlignment="Top"
                                               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="WRN">
                                                        <Setter Property="Foreground" Value="#F5A623" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERR">
                                                        <Setter Property="Foreground" Value="#FF5252" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="FTL">
                                                        <Setter Property="Foreground" Value="#FF5252" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Source}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="ERR">
                                                            <Setter Property="Foreground" Value="#FF8080" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="FTL">
                                                            <Setter Property="Foreground" Value="#FF8080" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
