<Page x:Class="RobotVision.WpfHost.Pages.LightingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="光源管理"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Page.InputBindings>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：光源控制器列表（仅列表，添加/参数在右侧） -->
        <Border Grid.Column="0" Margin="0,0,8,0" Padding="8"
                VerticalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="光源控制器" FontTypography="BodyStrong" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="删除" Margin="8,0,0,0"
                               Command="{Binding DeleteCommand}" />
                    <ui:Button Grid.Column="2" Content="刷新" Margin="4,0,0,0"
                               Command="{Binding RefreshCommand}" ToolTip="F5" />
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{Binding Id}" FontTypography="BodyStrong"
                                                  TextTrimming="CharacterEllipsis" />
                                    <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                                             Margin="6,0,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Registered}" Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="3"
                                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontSize="10" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Registered}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右：添加 / 编辑 / 手动调光 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 添加控制器 -->
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="Subtitle" Text="添加控制器" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Content="添加" Appearance="Primary"
                                       Command="{Binding AddCommand}" />
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,8,0">
                                <ui:TextBlock Text="控制器 Id（字母/数字/_/-）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewId, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="新控制器 Id，添加后写入 appsettings 的 LightControllers 段" />
                            </StackPanel>
                            <StackPanel>
                                <ui:TextBlock Text="类型" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding NewType}"
                                          ToolTip="控制器类型（来自工厂注册表）" />
                            </StackPanel>
                        </UniformGrid>

                        <ui:TextBlock Text="{Binding NewTypeHint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <!-- 新建 Serial 参数 -->
                        <StackPanel Margin="0,0,0,8"
                                    Visibility="{Binding IsNewSerial,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:TextBlock Text="串口参数（RS232/RS485）" FontTypography="BodyStrong"
                                          Margin="0,0,0,8" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0">
                                    <ui:TextBlock Text="串口名" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="如 COM3" />
                                </StackPanel>
                                <StackPanel>
                                    <ui:TextBlock Text="波特率" Margin="0,0,0,4" />
                                    <ui:NumberBox Value="{Binding NewBaudRate}" Minimum="1200" Maximum="921600"
                                                  SmallChange="9600" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>

                        <!-- 新建 Network 参数 -->
                        <StackPanel Visibility="{Binding IsNewNetwork,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:TextBlock Text="网络参数（UDP / TCP）" FontTypography="BodyStrong"
                                          Margin="0,0,0,8" />
                            <ui:TextBlock Text="控制器地址（host:port）" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="如 192.168.1.50:5000" Margin="0,0,0,8" />
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,8,0">
                                    <ui:TextBlock Text="传输协议" Margin="0,0,0,4" />
                                    <ComboBox SelectedItem="{Binding NewProtocol}" ToolTip="传输协议：Tcp 可靠连接 / Udp 低延迟广播">
                                        <ComboBoxItem>Tcp</ComboBoxItem>
                                        <ComboBoxItem>Udp</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <ui:TextBlock Text="本机绑定（可选，UDP 固定端口用）" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NewLocalEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                           ToolTip="本机绑定地址（可选）；UDP 需固定本地端口时填写" />
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Visibility="{Binding IsNewTcp,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <ui:TextBlock Text="TCP 重连次数" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding NewReconnectAttempts}" Minimum="0" Maximum="20"
                                              SmallChange="1" SpinButtonPlacementMode="Compact"
                                              HorizontalAlignment="Left" Width="120" />
                            </StackPanel>
                        </StackPanel>

                        <ui:TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="None = 无操作虚拟控制器（调试兜底）；真实类型由工厂注册表提供。" />
                    </StackPanel>
                </ui:Card>

                <!-- None 说明（无连接参数可编辑） -->
                <ui:Card Margin="0,0,0,8" Padding="12"
                         Visibility="{Binding IsNone,
                             Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="虚拟控制器（None）" Margin="0,0,0,8" />
                        <ui:TextBlock FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="无硬件连接参数。配方引用后可走完整取图/推理链路；手动开灯仅模拟成功，不会点亮任何光源。" />
                    </StackPanel>
                </ui:Card>

                <!-- Network 专属参数（仅选中 Network 光源时显示） -->
                <ui:Card Margin="0,0,0,8" Padding="12"
                         Visibility="{Binding IsNetwork,
                             Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="Subtitle"
                                          Text="网络参数（UDP / TCP）" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Content="保存" Appearance="Primary"
                                       Command="{Binding SaveSelectedCommand}" />
                        </Grid>

                        <ui:TextBlock Text="控制器地址（host:port）" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="控制器地址，格式 host:port，如 192.168.1.50:5000" />

                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,8,8">
                                <ui:TextBlock Text="传输协议" Margin="0,0,0,4" />
                                <ComboBox SelectedItem="{Binding EditProtocol}" ToolTip="传输协议：Tcp 可靠连接 / Udp 低延迟广播">
                                    <ComboBoxItem>Tcp</ComboBoxItem>
                                    <ComboBoxItem>Udp</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <ui:TextBlock Text="本机绑定（可选，UDP 固定端口用）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditLocalEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="本机绑定地址（可选）；UDP 需固定本地端口时填写" />
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,8,0">
                                <ui:TextBlock Text="命令超时（ms）" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding EditTimeoutMs}" Minimum="1" Maximum="10000"
                                              SmallChange="50"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,0"
                                        Visibility="{Binding IsEditTcp,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <ui:TextBlock Text="TCP 重连次数" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding EditReconnectAttempts}" Minimum="0" Maximum="20"
                                              SmallChange="1"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </UniformGrid>

                        <ui:TextBlock FontSize="11" TextWrapping="Wrap"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="指令帧默认 ASCII 行协议（SET ch brightness / OFF ALL / PING）；实际控制器协议不同时替换 NetworkLightController.BuildSetFrame 等。" />

                        <!-- 协议调试：手动发送原始指令 -->
                        <Border Margin="0,14,0,0" Padding="10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <ui:TextBlock Text="协议调试（发送原始指令）" FontTypography="BodyStrong"
                                              Margin="0,0,0,6" />
                                <TextBox Text="{Binding DebugCommand, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="输入原始指令，支持 \r \n \t 转义（如 SET 1 128\r\n）"
                                         Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Content="发送" Command="{Binding SendDebugCommand}" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding DebugResult, StringFormat=最近发送: {0}}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- Serial 专属参数（仅选中 Serial 光源时显示） -->
                <ui:Card Margin="0,0,0,8" Padding="12"
                         Visibility="{Binding IsSerial,
                             Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="Subtitle"
                                          Text="串口参数（RS232 / RS485）" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Content="保存" Appearance="Primary"
                                       Command="{Binding SaveSelectedCommand}" />
                        </Grid>

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <ui:TextBlock Text="串口名" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditPort, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="串口名称，如 COM3" />
                            </StackPanel>
                            <StackPanel>
                                <ui:TextBlock Text="波特率" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding EditBaudRate}" Minimum="1200" Maximum="921600"
                                              SmallChange="9600" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </UniformGrid>

                        <ui:TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="指令帧默认 ASCII 行协议（SET ch brightness / OFF ALL）；实际控制器协议不同时替换 SerialLightController.BuildSetFrame 等。" />

                        <!-- 协议调试：手动发送原始指令 -->
                        <Border Margin="0,14,0,0" Padding="10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <ui:TextBlock Text="协议调试（发送原始指令）" FontTypography="BodyStrong"
                                              Margin="0,0,0,6" />
                                <TextBox Text="{Binding DebugCommand, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="输入原始指令，支持 \r \n \t 转义（如 SET 1 128\r\n）"
                                         Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Content="发送" Command="{Binding SendDebugCommand}" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding DebugResult, StringFormat=最近发送: {0}}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- 手动调光 -->
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="手动调光（作用于运行中的服务）" Margin="0,0,0,10" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="通道号（≥1）" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Channel}" Minimum="1" Maximum="64"
                                              SmallChange="1" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="亮度（0-255）" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Brightness}" Minimum="0" Maximum="255"
                                              SmallChange="5"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </UniformGrid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="亮度" VerticalAlignment="Center" Width="40" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="255"
                                    Value="{Binding Brightness}"
                                    IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"
                                    TickFrequency="32" TickPlacement="BottomRight"
                                    AutoToolTipPlacement="TopLeft" Margin="8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" Width="48"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Content="开灯" Appearance="Primary" Command="{Binding TurnOnCommand}" />
                            <ui:Button Grid.Column="1" Content="关灯" Margin="8,0,0,0"
                                       Command="{Binding TurnOffCommand}" />
                            <ui:TextBlock Grid.Column="2" FontSize="11" Margin="16,0,0,0"
                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap" VerticalAlignment="Center"
                                          Text="开灯保持常亮，直到手动关灯或下一次取图周期点亮；调参确认后到配方编辑器把亮度写回配方" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 操作与状态 -->
                <ui:Card Padding="12">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
