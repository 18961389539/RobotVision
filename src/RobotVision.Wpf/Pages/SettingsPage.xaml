<Page x:Class="RobotVision.WpfHost.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="服务设置"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <!-- 生效方式徽章（组标题右侧）：绿 = 保存后生效 -->
        <Style x:Key="HotBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <!-- 需重启标注（字段标签旁）：琥珀小字 -->
        <Style x:Key="RestartHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,8" MaxWidth="860">
                <!-- 服务状态（常驻不折叠） -->
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="Subtitle" Text="服务状态" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="2" Content="重新载入" Command="{Binding ReloadCommand}" />
                            <ui:Button Grid.Column="3" Content="恢复默认值" Margin="8,0,0,0"
                                       Command="{Binding RestoreDefaultsCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:Card>

                <!-- 运行参数：折叠分组 + 生效徽章（个别参数需重启，字段级标注） -->
                <ui:CardExpander IsExpanded="True" Margin="0,0,0,8" Padding="12">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock FontTypography="Subtitle" Text="运行参数" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HotBadge}">
                                <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="#0D1117" />
                            </Border>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="请求超时（ms，建议 3000~5000）" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding TimeoutMs}" Minimum="500" Maximum="60000"
                                              SmallChange="500" SpinButtonPlacementMode="Inline"
                                              ToolTip="单次 TRIGGER 处理超时；与 TCP 空闲断线无关" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="连接空闲超时（ms，0 = 永久）" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding IdleTimeoutMs}" Minimum="0" Maximum="2592000000.0"
                                              SmallChange="1000" SpinButtonPlacementMode="Inline"
                                              ToolTip="0=PLC 节拍间隙不断开；需要回收死连接可点「30天」。半开连接仍由 KeepAlive 探测" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:Button Content="永久" Appearance="Secondary" FontSize="11"
                                               Command="{Binding SetIdleNeverCommand}" />
                                    <ui:Button Content="30 天" Appearance="Secondary" FontSize="11" Margin="8,0,0,0"
                                               Command="{Binding SetIdleThirtyDaysCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="推理队列深度（含执行中）" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding MaxQueueDepth}" Minimum="1" Maximum="64"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="并发执行上限（工位数）" Margin="0,0,0,4" />
                                    <TextBlock Style="{StaticResource RestartHint}" Text="需重启" />
                                </StackPanel>
                                <ui:NumberBox Value="{Binding MaxConcurrent}" Minimum="1" Maximum="64"
                                              SmallChange="1" SpinButtonPlacementMode="Inline"
                                              ToolTip="同时进入取图/推理的任务数；取图按相机串行、推理按模型串行。首次请求后生效，改动需重启程序" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="监听 backlog（1~1024）" Margin="0,0,0,4" />
                                    <TextBlock Style="{StaticResource RestartHint}" Text="需重启" />
                                </StackPanel>
                                <ui:NumberBox Value="{Binding TcpBacklog}" Minimum="1" Maximum="1024"
                                              SmallChange="1" SpinButtonPlacementMode="Inline"
                                              ToolTip="内核排队待 accept 的连接数；监听启动时读取，改动需重启程序生效" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="并发连接上限（0 = 不限）" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding MaxConnections}" Minimum="0" Maximum="64"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="总超时必须大于各 Basler 相机的 GrabTimeoutMs，否则相机取图超时将表现为 1008 而非 1003（保存时校验）；并发执行上限必须 ≤ 队列深度" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- 末端相机拍照位姿校验（1012/1014） -->
                <ui:CardExpander IsExpanded="True" Margin="0,0,0,8" Padding="12">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock FontTypography="Subtitle" Text="拍照位姿校验（OnArm）" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HotBadge}">
                                <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="#0D1117" />
                            </Border>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <ui:ToggleSwitch Content="启用位姿校验（正式产线应开启）"
                                         IsChecked="{Binding PoseCheckEnabled}" />
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding ShowPoseToleranceFields,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="XY 容差（mm）" Margin="0,0,0,4" />
                                    <ui:NumberBox Value="{Binding PoseXyToleranceMm}" Minimum="0.01" Maximum="50"
                                                  SmallChange="0.1" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="RZ 容差（°）" Margin="0,0,0,4" />
                                    <ui:NumberBox Value="{Binding PoseRzToleranceDeg}" Minimum="0.01" Maximum="45"
                                                  SmallChange="0.1" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      TextWrapping="Wrap" Margin="0,4,0,0">
                            <ui:TextBlock.Style>
                                <Style TargetType="ui:TextBlock">
                                    <Setter Property="Text"
                                            Value="末端相机工位：未上报 X,Y,RZ 返回 1014；超容差返回 1012。关闭后两项均不拦截（仅调试）。" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PoseCheckEnabled}" Value="False">
                                            <Setter Property="Text"
                                                    Value="位姿校验已关闭：1012/1014 均不拦截，仅用于台架调试；正式产线请开启。" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:TextBlock.Style>
                        </ui:TextBlock>
                    </StackPanel>
                </ui:CardExpander>

                <!-- 失败现场留存 -->
                <ui:CardExpander IsExpanded="True" Margin="0,0,0,8" Padding="12">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock FontTypography="Subtitle" Text="失败现场留存" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HotBadge}">
                                <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="#0D1117" />
                            </Border>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Margin="0,0,0,8">
                            <ui:ToggleSwitch Content="启用失败现场图像留存" IsChecked="{Binding FailureEnabled}" />
                        </StackPanel>
                        <StackPanel MaxWidth="320" HorizontalAlignment="Left"
                                    Visibility="{Binding ShowFailureRetention,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="滚动保留数量（最旧先删，0 = 不自动清理）" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding FailureRetainedCount}" Minimum="0" Maximum="10000"
                                          SmallChange="50" SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- IP 白名单（默认收起） -->
                <ui:CardExpander IsExpanded="False" Margin="0,0,0,8" Padding="12">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock FontTypography="Subtitle" Text="IP 白名单" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HotBadge}">
                                <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="#0D1117" />
                            </Border>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="每行一条；空 = 允许所有；支持前缀通配如 192.168.*（整段通配）" Margin="0,0,0,4" />
                            <TextBox Text="{Binding WhitelistText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     MinHeight="72" MaxHeight="160" FontFamily="Consolas" />
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Margin="0,6,0,0"
                                          Text="热参数：保存后立即按新名单拒绝接入；仅允许合法 IP（如 192.168.1.10）或整段通配（如 192.168.*）" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- 网络端点（默认收起；保存后热重启监听） -->
                <ui:CardExpander IsExpanded="False" Padding="12">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock FontTypography="Subtitle" Text="网络端点" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HotBadge}">
                                <TextBlock Text="保存后生效" FontSize="10" FontWeight="SemiBold" Foreground="#0D1117" />
                            </Border>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="监听 IP 地址" Margin="0,0,0,4" />
                                <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="监听端口" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding TcpPort}" Minimum="1" Maximum="65535"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="IP 地址与端口保存后热重启监听（无需重启程序，客户端会短暂断开）；端口被占用时自动回滚到旧监听" />
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>

        <!-- 固定底部操作栏：保存/状态反馈始终可见 -->
        <ui:Card Grid.Row="1" Padding="12" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Content="保存并应用" Appearance="Primary" Command="{Binding SaveCommand}" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="2" Content="打开配置目录"
                           Command="{Binding OpenSettingsFolderCommand}" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
