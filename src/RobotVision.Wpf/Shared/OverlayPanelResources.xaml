<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- 图像主导页悬浮面板（#F01E2836）：在 WPF-UI / App 样式上统一浅色前景。
         ComboBox 已由 App 级 DarkComboBox（BasedOn DefaultComboBoxStyle）覆盖。 -->
    <Style TargetType="{x:Type ui:TextBlock}" BasedOn="{StaticResource AppLightTextBlockStyle}">
        <Setter Property="Foreground" Value="#FFF5F8FC" />
    </Style>
    <Style TargetType="TextBlock" BasedOn="{StaticResource AppLightTextBlockStyle}">
        <Setter Property="Foreground" Value="#FFF5F8FC" />
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="Foreground" Value="#FFF5F8FC" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Foreground" Value="#FFF5F8FC" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Foreground" Value="#FFF5F8FC" />
    </Style>
    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource AppDataGridStyle}">
        <Setter Property="Foreground" Value="#FFF5F8FC" />
    </Style>
    <Style TargetType="{x:Type ui:NumberBox}" BasedOn="{StaticResource DefaultUiNumberBoxStyle}">
        <Setter Property="Foreground" Value="#FFF5F8FC" />
    </Style>
</ResourceDictionary>
