<UserControl
    x:Class="ImageViewer.Controls.AdaptiveImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <Grid Background="#0F1722" Focusable="True" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="8" Background="#182433" BorderBrush="#314158" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button x:Name="autoButton" Content="Auto" Click="OnAutoClick" Margin="0,0,6,0" Padding="10,5" ToolTip="Automatic view selection" />
                <Button x:Name="twoDimensionalButton" Content="2D" Click="OnTwoDimensionalClick" Margin="0,0,6,0" Padding="10,5" ToolTip="Show 2D image" />
                <Button x:Name="threeDimensionalButton" Content="3D" Click="OnThreeDimensionalClick" Margin="0,0,6,0" Padding="10,5" ToolTip="Show 3D volume" />
                <Button x:Name="axialButton" Content="Axial" Click="OnAxialClick" Margin="0,0,6,0" Padding="10,5" ToolTip="Axial view (1)" />
                <Button x:Name="coronalButton" Content="Coronal" Click="OnCoronalClick" Margin="0,0,6,0" Padding="10,5" ToolTip="Coronal view (2); Up/Down changes the slice" />
                <Button x:Name="sagittalButton" Content="Sagittal" Click="OnSagittalClick" Margin="0,0,6,0" Padding="10,5" ToolTip="Sagittal view (3); Up/Down changes the slice" />
                <Button x:Name="qualityButton" Content="Quality" Click="OnQualityClick" Margin="0,0,6,0" Padding="10,5" ToolTip="Analyze volume quality" />
                <Button x:Name="segmentButton" Content="Segment" Click="OnSegmentClick" Margin="0,0,6,0" Padding="10,5" ToolTip="Create segmentation candidates" />
                <Button x:Name="cancelButton" Content="Cancel" Click="OnCancelClick" Padding="10,5" ToolTip="Cancel current operation (Esc)" />
            </WrapPanel>
        </Border>
        <Grid Grid.Row="1">
            <ContentControl x:Name="contentHost" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8" Background="#C0182433" BorderBrush="#49627D" BorderThickness="1" CornerRadius="3">
                <StackPanel>
                    <TextBlock x:Name="statusText" Foreground="#E8EEF5" />
                    <ProgressBar x:Name="operationProgress" Height="5" Width="180" Margin="0,6,0,0" Visibility="Collapsed" IsIndeterminate="True" />
                </StackPanel>
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8" Background="#C0182433" BorderBrush="#49627D" BorderThickness="1" CornerRadius="3" MaxWidth="360">
                <StackPanel>
                    <TextBlock Text="Data quality" Foreground="#E8EEF5" FontWeight="SemiBold" />
                    <ListBox x:Name="anomalyList" MaxHeight="100" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" Foreground="#F5C26B" SelectionChanged="OnAnomalySelected" />
                    <TextBlock x:Name="segmentationText" Foreground="#A8C7E8" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="acceptSegmentationButton" Content="Accept" Click="OnAcceptSegmentationClick" Margin="0,0,6,0" Padding="8,3" />
                        <Button x:Name="rejectSegmentationButton" Content="Reject" Click="OnRejectSegmentationClick" Padding="8,3" />
                        <Button x:Name="retryButton" Content="Retry quality" Click="OnRetryQualityClick" Margin="6,0,0,0" Padding="8,3" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="stateBarText" Padding="8,5" Foreground="#AAB5C3" Background="#111A27" />
    </Grid>
</UserControl>
