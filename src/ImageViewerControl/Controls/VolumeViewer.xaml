<UserControl
    x:Class="ImageViewer.Controls.VolumeViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid PreviewMouseWheel="OnPreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="sliceViewerHost" />
        <Border Grid.Row="1" Padding="8,6" Background="#E6111822">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="sliceStatusText"
                           DockPanel.Dock="Left"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="White" />
                <Slider x:Name="sliceSlider"
                        ToolTip="拖动浏览 3D 体数据的不同切片层（轴向序号 0–N）；与上方状态文字同步"
                        Minimum="0"
                        Maximum="0"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        SmallChange="1"
                        LargeChange="1"
                        ValueChanged="OnSliceValueChanged" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
