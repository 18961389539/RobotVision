<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\BaslerPylon.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LDVisionCamera.Net" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="YoloDotNet" />
    <PackageReference Include="YoloDotNet.ExecutionProvider.OpenVino" />
    <PackageReference Include="Intel.ML.OnnxRuntime.OpenVino" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.IO.Ports" />
    <!-- 未检测到本机 pylon 安装时回退 NuGet 10.x（须与已装 pylon 大版本一致，否则枚举 SEH 异常）。 -->
    <PackageReference Include="Basler.Pylon.NET.x64" NoWarn="NU1701" GeneratePathProperty="true"
                      Condition="'$(PylonManagedDll)' == '' or !Exists('$(PylonManagedDll)')" />
    <!-- 纯托管 GigE Vision（GVCP/GVSP），不依赖 pylon 运行库；与 Basler.Pylon 并存，按 Type 选用。 -->
    <PackageReference Include="GigEVision.Net" />
  </ItemGroup>

  <!-- 优先引用本机 pylon 安装目录（与 Runtime 大版本一致）；否则回退 NuGet 10.x。 -->
  <ItemGroup Condition="Exists('$(PylonManagedDll)')">
    <Reference Include="Basler.Pylon">
      <HintPath>$(PylonManagedDll)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(PylonManagedDll)')">
    <Reference Include="Basler.Pylon">
      <HintPath>$(PkgBasler_Pylon_NET_x64)\lib\native\Basler.Pylon.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- 将 pylon 原生运行库部署到输出目录（优先于 System32 加载，免改 PATH）。 -->
  <ItemGroup Condition="Exists('$(PylonRuntimeDir)')">
    <None Include="$(PylonRuntimeDir)\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
    <None Include="$(PylonRuntimeDir)\*.cti" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RobotVision.Core\RobotVision.Core.csproj" />
    <ProjectReference Include="..\RobotVision.Vision\RobotVision.Vision.csproj" />
    <ProjectReference Include="..\RobotVision.JlVision\RobotVision.JlVision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RobotVision.Tests" />
    <InternalsVisibleTo Include="RobotVision.Teach" />
  </ItemGroup>

  <!-- 本机 System32 存在同名旧版 onnxruntime.dll 会抢先加载。
       OpenVINO EP 的 win-x64 原生库放到输出根目录（随项目引用传到 App/Tests）。
       另将 VC++ 2015-2022 运行库 DLL 应用本地部署（native\，许可允许）。 -->
  <ItemGroup>
    <None Include="$(PkgIntel_ML_OnnxRuntime_OpenVino)\runtimes\win-x64\native\*.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)"
          Visible="false"
          Condition="'$(PkgIntel_ML_OnnxRuntime_OpenVino)' != '' and Exists('$(PkgIntel_ML_OnnxRuntime_OpenVino)\runtimes\win-x64\native')" />
    <None Update="native\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
