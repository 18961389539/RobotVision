<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LDVisionCamera.Net" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="YoloDotNet" />
    <PackageReference Include="YoloDotNet.ExecutionProvider.Cpu" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.IO.Ports" />
    <!-- 未检测到本机 pylon 安装时回退 NuGet 10.x（须与已装 pylon 大版本一致，否则枚举 SEH 异常）。 -->
    <PackageReference Include="Basler.Pylon.NET.x64" NoWarn="NU1701" GeneratePathProperty="true"
                      Condition="'$(PylonManagedDll)' == '' or !Exists('$(PylonManagedDll)')" />
    <!-- 纯托管 GigE Vision（GVCP/GVSP），不依赖 pylon 运行库；与 Basler.Pylon 并存，按 Type 选用。 -->
    <PackageReference Include="GigEVision.Net" />
  </ItemGroup>

  <!-- 优先引用本机 pylon 安装目录（与 Runtime 大版本一致）；否则回退 NuGet 10.x。 -->
  <PropertyGroup>
    <PylonRoot Condition="'$(PYLON_ROOT)' != ''">$(PYLON_ROOT)</PylonRoot>
    <PylonRoot Condition="'$(PylonRoot)' == '' and Exists('D:\Program Files\Basler\pylon')">D:\Program Files\Basler\pylon</PylonRoot>
    <PylonRoot Condition="'$(PylonRoot)' == '' and Exists('C:\Program Files\Basler\pylon')">C:\Program Files\Basler\pylon</PylonRoot>
    <PylonManagedDll Condition="'$(PylonRoot)' != ''">$(PylonRoot)\Development\Assemblies\Basler.Pylon\net8.0\x64\Basler.Pylon.dll</PylonManagedDll>
    <PylonRuntimeDir Condition="'$(PylonRoot)' != ''">$(PylonRoot)\Runtime\x64</PylonRuntimeDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(PylonManagedDll)')">
    <Reference Include="Basler.Pylon">
      <HintPath>$(PylonManagedDll)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(PylonManagedDll)')">
    <Reference Include="Basler.Pylon">
      <HintPath>$(PkgBasler_Pylon_NET_x64)\lib\native\Basler.Pylon.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- 将 pylon 原生运行库部署到输出目录（优先于 System32 加载，免改 PATH）。 -->
  <ItemGroup Condition="Exists('$(PylonRuntimeDir)')">
    <None Include="$(PylonRuntimeDir)\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
    <None Include="$(PylonRuntimeDir)\*.cti" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RobotVision.Core\RobotVision.Core.csproj" />
  </ItemGroup>

  <!-- 本机 System32 存在同名旧版 onnxruntime.dll 会抢先加载（OrtGetApiBase 入口点缺失），
       将 win-x64 原生库放到输出根目录：应用目录优先于 System32。随项目引用传递到 App/CalibTool/Tests。
       另外 onnxruntime.dll 依赖 VC++ 2015-2022 运行库，本机未安装系统级 Redistributable，
       故将三个 x64 运行库 DLL 一并应用本地部署（取自 Edge 应用目录，许可允许）。 -->
  <ItemGroup>
    <None Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime.dll" CopyToOutputDirectory="PreserveNewest" Link="onnxruntime.dll" Visible="false" />
    <None Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime_providers_shared.dll" CopyToOutputDirectory="PreserveNewest" Link="onnxruntime_providers_shared.dll" Visible="false" />
    <None Update="native\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
