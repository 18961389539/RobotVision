<Page x:Class="RobotVision.UI.Pages.CommunicationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="通信监控"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="230" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 服务状态与操作 -->
        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding ServiceStatus}"
                              VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="2" Content="{Binding ToggleButtonLabel}"
                           Command="{Binding ToggleServiceCommand}" />
                <ui:Button Grid.Column="3" Content="清空记录" Margin="8,0,0,0"
                           Command="{Binding ClearRequestsCommand}" />
            </Grid>
        </ui:Card>

        <!-- 运行统计（按配方） -->
        <ui:Card Grid.Row="1" Margin="0,0,0,8" Padding="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong" Text="运行统计（按配方）"
                                  VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StatsSummary}" Margin="16,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <DataGrid ItemsSource="{Binding StatsRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          MaxHeight="180"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="配方" Binding="{Binding Recipe}" Width="140" />
                        <DataGridTextColumn Header="触发" Binding="{Binding Total, StringFormat={}{0:N0}}"
                                            Width="70" />
                        <DataGridTextColumn Header="成功" Binding="{Binding Ok, StringFormat={}{0:N0}}"
                                            Width="70" />
                        <DataGridTextColumn Header="失败" Binding="{Binding Failed, StringFormat={}{0:N0}}"
                                            Width="70" />
                        <DataGridTextColumn Header="成功率" Binding="{Binding SuccessRate}" Width="80" />
                        <DataGridTextColumn Header="平均耗时" Binding="{Binding AvgMs}" Width="90" />
                        <DataGridTextColumn Header="最近耗时" Binding="{Binding LastMs}" Width="90" />
                        <DataGridTextColumn Header="最近触发" Binding="{Binding LastAt}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </ui:Card>

        <!-- 当前连接 -->
        <ui:Card Grid.Row="2" Margin="0,0,0,8" Padding="8">
            <DockPanel>
                <ui:TextBlock DockPanel.Dock="Top" FontTypography="BodyStrong"
                              Text="当前连接" Margin="4,0,0,6" />
                <DataGrid ItemsSource="{Binding Clients}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          EnableRowVirtualization="False"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40" />
                        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120" />
                        <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="70" />
                        <DataGridTextColumn Header="接入时间"
                                            Binding="{Binding ConnectedAt, StringFormat=HH:mm:ss}"
                                            Width="80" />
                        <DataGridTextColumn Header="请求数"
                                            Binding="{Binding Requests, StringFormat={}{0:N0}}"
                                            Width="70" />
                        <DataGridTextColumn Header="收字节"
                                            Binding="{Binding BytesIn, StringFormat={}{0:N0}}"
                                            Width="90" />
                        <DataGridTextColumn Header="发字节"
                                            Binding="{Binding BytesOut, StringFormat={}{0:N0}}"
                                            Width="90" />
                        <DataGridTextColumn Header="最近请求" Binding="{Binding LastRequest}"
                                            Width="*" />
                        <DataGridTextColumn Header="最近时间"
                                            Binding="{Binding LastRequestAt, StringFormat=HH:mm:ss, TargetNullValue=—}"
                                            Width="80" />
                        <DataGridTemplateColumn Header="操作" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="断开"
                                               Command="{Binding DataContext.DisconnectClientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </ui:Card>

        <!-- 请求历史 -->
        <ui:Card Grid.Row="3" Padding="8">
            <DockPanel>
                <ui:TextBlock DockPanel.Dock="Top" FontTypography="BodyStrong"
                              Text="请求历史（最近 200 条，最新在前）" Margin="4,0,0,6" />
                <DataGrid ItemsSource="{Binding Requests}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="90" />
                        <DataGridTextColumn Header="客户端" Binding="{Binding Client}" Width="140" />
                        <DataGridTextColumn Header="请求" Binding="{Binding Request}" Width="150" />
                        <DataGridTextColumn Header="应答" Binding="{Binding ReplyTrimmed}" Width="*" />
                        <DataGridTemplateColumn Header="结果" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Result}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter Property="Foreground" Value="#6BCB77" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Foreground" Value="#FF6B6B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </ui:Card>
    </Grid>
</Page>
