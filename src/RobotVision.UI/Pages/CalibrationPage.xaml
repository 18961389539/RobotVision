<Page x:Class="RobotVision.UI.Pages.CalibrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="标定档案"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontTypography="BodyStrong" Text="标定档案（启动时从 data/calibration 加载）"
                              VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" />
                <ui:Button Grid.Column="3" Content="打开标定目录" Margin="8,0,0,0"
                           Command="{Binding OpenFolderCommand}" />
            </Grid>
        </ui:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Margin="0,0,0,8" Padding="8">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="内参（去畸变）" Margin="8,4,8,8" />
                        <DataGrid ItemsSource="{Binding Intrinsics}"
                                  SelectedItem="{Binding SelectedIntrinsic}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False"
                                  MinHeight="60" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="相机" Binding="{Binding CameraId}" Width="110" />
                                <DataGridTextColumn Header="分辨率" Binding="{Binding Resolution}" Width="90" />
                                <DataGridTextColumn Header="畸变系数" Binding="{Binding Distortion}" Width="2*" />
                                <DataGridTextColumn Header="重投影 RMS" Binding="{Binding Rms}" Width="100" />
                                <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="标定时间" Binding="{Binding CalibratedAt}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="8,6,8,0">
                            <ui:Button Content="删除选中内参" Command="{Binding DeleteIntrinsicCommand}"
                                       FontSize="11" Padding="10,3" />
                            <TextBlock Text="质量：优秀（≤0.3px）/ 可用（≤0.5px）/ 超标" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Padding="8">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="外参（像素 → 机器人，2×3 仿射）" Margin="8,4,8,8" />
                        <DataGrid ItemsSource="{Binding Extrinsics}"
                                  SelectedItem="{Binding SelectedExtrinsic}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False"
                                  MinHeight="60" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="工位" Binding="{Binding StationId}" Width="110" />
                                <DataGridTextColumn Header="相机" Binding="{Binding CameraId}" Width="110" />
                                <DataGridTextColumn Header="仿射第 1 行" Binding="{Binding AffineRow0}" Width="2*" />
                                <DataGridTextColumn Header="仿射第 2 行" Binding="{Binding AffineRow1}" Width="2*" />
                                <DataGridTextColumn Header="RMS" Binding="{Binding Rms}" Width="80" />
                                <DataGridTextColumn Header="最大残差" Binding="{Binding MaxResidual}" Width="80" />
                                <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="标定时间" Binding="{Binding CalibratedAt}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="8,6,8,0">
                            <ui:Button Content="删除选中外参" Command="{Binding DeleteExtrinsicCommand}"
                                       FontSize="11" Padding="10,3" />
                            <TextBlock Text="质量：优秀（≤0.1）/ 可用（≤0.5）" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="8">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="旋转中心（第 4 轴轴心，偏心工具补偿）" Margin="8,4,8,8" />
                        <DataGrid ItemsSource="{Binding RotationCenters}"
                                  SelectedItem="{Binding SelectedRotation}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False"
                                  MinHeight="60" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="工位" Binding="{Binding StationId}" Width="110" />
                                <DataGridTextColumn Header="相机" Binding="{Binding CameraId}" Width="110" />
                                <DataGridTextColumn Header="轴心" Binding="{Binding Center}" Width="140" />
                                <DataGridTextColumn Header="半径" Binding="{Binding Radius}" Width="80" />
                                <DataGridTextColumn Header="RMS" Binding="{Binding Rms}" Width="80" />
                                <DataGridTextColumn Header="轴比" Binding="{Binding AxisRatio}" Width="70" />
                                <DataGridTextColumn Header="点数" Binding="{Binding PointCount}" Width="60" />
                                <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Quality}" Value="超标">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Quality}" Value="优秀">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="标定时间" Binding="{Binding CalibratedAt}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="8,6,8,0">
                            <ui:Button Content="删除选中旋转中心" Command="{Binding DeleteRotationCommand}"
                                       FontSize="11" Padding="10,3" />
                            <TextBlock Text="质量：优秀（≤0.3px）/ 可用（≤0.5px）/ 超标（含轴比 &gt;1.2）" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
