<Page x:Class="RobotVision.UI.Pages.CamerasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="相机管理"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：相机列表 -->
        <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="相机" FontTypography="BodyStrong" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="新建" Margin="8,0,0,0"
                               Command="{Binding NewCommand}" />
                    <ui:Button Grid.Column="2" Content="刷新" Margin="4,0,0,0"
                               Command="{Binding RefreshCommand}" />
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2" Width="220">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{Binding Id}" FontTypography="BodyStrong"
                                                  TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="3"
                                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontSize="10" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Registered}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="#4CC38A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding UnregisteredReason}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           Foreground="#E8A33D" ToolTip="{Binding UnregisteredReason}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnregisteredReason}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="4,8,4,4">
                    <TextBlock Text="{Binding UnsavedHint}" FontSize="11" TextWrapping="Wrap"
                               Foreground="#E8A33D" Margin="0,0,0,6"
                               Visibility="{Binding HasUnsavedChanges,
                                   Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ui:Button Content="打开配置所在目录" Command="{Binding OpenSettingsFolderCommand}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 右：编辑与测试 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 基本信息 -->
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="基本信息" Margin="0,0,0,10" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="相机 Id（字母/数字/_/-）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditId, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNew}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="类型" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding EditType}" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="保存后立即在运行中的服务上注册生效，无需重启程序；切换类型需重填对应参数" />
                    </StackPanel>
                </ui:Card>

                <!-- 类型参数：File -->
                <ui:Card Margin="0,0,0,8" Padding="12"
                         Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="回放参数（File）" Margin="0,0,0,10" />
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="回放目录（相对路径以 exe 目录为基准）" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding EditFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0"
                                           Command="{Binding BrowseFolderCommand}" />
                            </Grid>
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Margin="0,6,0,0"
                                          Text="按文件名顺序循环读取图片，用于无相机联调与算法回归" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="回放帧间隔（ms，0 = 不限速）" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Margin="0,6,0,0"
                                          Text="固定间隔回放可模拟真实采集节拍，联调时序更接近产线" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 类型参数：Basler -->
                <ui:Card Margin="0,0,0,8" Padding="12"
                         Visibility="{Binding IsBasler, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="Basler 参数（pylon）" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="序列号（留空 = 自动绑定第一台）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditDeviceId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="枚举设备" Margin="8,26,0,0"
                                       Command="{Binding EnumerateBaslerCommand}" />
                        </Grid>

                        <StackPanel Margin="0,0,0,8"
                                    Visibility="{Binding HasBaslerDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="本机相机（选中自动填入序列号）" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding BaslerDevices}"
                                      SelectedItem="{Binding SelectedBaslerDevice}" />
                        </StackPanel>

                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="曝光（µs，空=不下发）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditExposureUs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="增益（dB，空=不下发）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditGain, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="采集超时（ms）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditGrabTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                        <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="运行前提：本机安装 pylon Camera Software Suite（与 Basler.Pylon.NET.x64 版本匹配）。运行时调光见下方卡片。" />
                    </StackPanel>
                </ui:Card>

                <!-- 类型参数：Virtual -->
                <ui:Card Margin="0,0,0,8" Padding="12"
                         Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="虚拟相机参数" Margin="0,0,0,10" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="宽（px）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditWidth, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="高（px）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditHeight, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="图案" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding PatternOptions}" SelectedItem="{Binding EditPattern}" />
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="棋盘格单元（px）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditCellPx, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="模拟曝光延时（ms）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="高斯噪声 σ" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditNoiseSigma, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="Chessboard：移动棋盘格（默认 15×11 内角点，可用于内参标定向导）；Shapes：彩色图形；Bars：色条基准图" />
                    </StackPanel>
                </ui:Card>

                <!-- 外部工厂注册的类型（无内置编辑面板） -->
                <ui:Card Margin="0,0,0,8" Padding="12"
                         Visibility="{Binding IsUnknownType, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="扩展类型参数" Margin="0,0,0,8" />
                        <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      TextWrapping="Wrap"
                                      Text="该类型由外部相机工厂注册，本页未内置编辑字段。测试取图与保存仍可用（按现有配置创建）；如需修改高级参数，请直接编辑 appsettings.json 的 Cameras 节点后重启。" />
                    </StackPanel>
                </ui:Card>

                <!-- 已注册相机的运行时调光 -->
                <ui:Card Margin="0,0,0,8" Padding="12"
                         Visibility="{Binding HasLiveExposureControl, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="Subtitle" Text="运行时调光（作用于已注册相机）"
                                          VerticalAlignment="Center" />
                            <ui:Button Grid.Column="2" Content="读取当前值"
                                       Command="{Binding ReadLiveParamsCommand}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="曝光" VerticalAlignment="Center" Width="40" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1000"
                                    Value="{Binding ExposureSlider}"
                                    IsMoveToPointEnabled="True" SmallChange="1" LargeChange="50"
                                    TickFrequency="100" TickPlacement="BottomRight"
                                    AutoToolTipPlacement="TopLeft" Margin="8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding ExposureText}" Width="80"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="增益" VerticalAlignment="Center" Width="40" />
                            <Slider Grid.Column="1" Minimum="{Binding GainMin}" Maximum="{Binding GainMax}"
                                    Value="{Binding Gain}"
                                    IsMoveToPointEnabled="True" SmallChange="0.1" LargeChange="1"
                                    TickFrequency="2" TickPlacement="BottomRight"
                                    AutoToolTipPlacement="TopLeft" Margin="8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding GainText}" Width="80"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Content="应用并取图预览" Appearance="Primary"
                                       Command="{Binding ApplyAndGrabCommand}" />
                            <ui:Button Grid.Column="1" Content="填入编辑框（保存后生效）" Margin="8,0,0,0"
                                       Command="{Binding SaveLiveParamsCommand}" />
                        </Grid>
                        <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Margin="0,6,0,0"
                                      Text="曝光为对数刻度滑块；下发后立即对产线触发生效。确认亮度合适后点&quot;填入编辑框&quot;，再点&quot;保存&quot;持久化到配置" />
                    </StackPanel>
                </ui:Card>

                <!-- 测试取图 -->
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="Subtitle" Text="测试取图" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1" Content="取一帧（按当前编辑内容）" Margin="16,0,0,0"
                                       Command="{Binding TestGrabCommand}" />
                            <ui:Button Grid.Column="3" Content="打开目录"
                                       Command="{Binding OpenFolderCommand}" />
                        </Grid>
                        <Border Background="#1E1E1E" CornerRadius="3" MinHeight="220" MaxHeight="420"
                                Padding="4">
                            <Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                <Border Background="#66000000" CornerRadius="3" Padding="6,2" Margin="4"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding PreviewVisible,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding PreviewCaption}" FontSize="11"
                                               Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- 操作与状态 -->
                <ui:Card Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="保存" Appearance="Primary"
                                   Command="{Binding SaveCommand}" />
                        <ScrollViewer Grid.Column="1" MaxHeight="72" Margin="16,0,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding Message}" VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </ScrollViewer>
                        <ui:Button Grid.Column="2" Content="复制为新相机" Margin="8,0,0,0"
                                   Command="{Binding CopyCommand}" />
                        <ui:Button Grid.Column="3" Content="删除" Margin="8,0,0,0"
                                   Command="{Binding DeleteCommand}" />
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
