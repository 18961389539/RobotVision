<Page x:Class="RobotVision.UI.Pages.CalibrationWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:RobotVision.UI"
      Title="标定向导"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="PanelIntrinsic" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:WizardMode.Intrinsic}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelExtrinsic" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:WizardMode.Extrinsic}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelRotation" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:WizardMode.Rotation}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="标定类型" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding Mode}" />
                    <TextBlock Grid.Column="2" Text="相机" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding CameraIds}" SelectedItem="{Binding SelectedCamera}" />
                    <TextBlock Grid.Column="4" Text="工位 Id" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <TextBox Grid.Column="5" Text="{Binding StationId, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="7" Content="取图" Appearance="Primary"
                               Command="{Binding GrabCommand}" />
                    <ui:Button Grid.Column="8" Content="清空点" Margin="8,0,0,0"
                               Command="{Binding ClearPointsCommand}" />
                </Grid>
                <TextBlock Text="{Binding Message}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <!-- 左：图像与点选 -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="4" ClipToBounds="True">
                    <Grid x:Name="ImageHost" MouseLeftButtonDown="OnImageMouseDown">
                        <Image x:Name="FrameDisplay" Source="{Binding FrameImage}" Stretch="Uniform" />
                        <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock Text="{Binding FrameInfo}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="外参/旋转中心模式：在图上点击选取标定点（旋转中心每换一个角度取一次图并点一个点）"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 右：参数 / 点表 / 结果 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 内参参数 -->
                    <ui:Card Margin="0,0,0,8" Padding="12">
                        <Grid>
                            <StackPanel Style="{StaticResource PanelIntrinsic}">
                            <ui:TextBlock FontTypography="Subtitle" Text="棋盘格参数" Margin="0,0,0,10" />
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="内角点列数" Margin="0,0,0,4" />
                                    <ui:NumberBox Value="{Binding Cols}" Minimum="3" Maximum="30"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="内角点行数" Margin="0,0,0,4" />
                                    <ui:NumberBox Value="{Binding Rows}" Minimum="3" Maximum="30"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="方格边长(mm)" Margin="0,0,0,4" />
                                    <ui:NumberBox Value="{Binding SquareMm}" Minimum="0.1" Maximum="100"
                                                  SmallChange="0.5" SpinButtonPlacementMode="Inline" />
                                </StackPanel>
                            </UniformGrid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="已采集帧数" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:TextBlock Grid.Column="1" Text="{Binding CollectedFrames}" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="2" Content="清空采集" Command="{Binding ClearIntrinsicCommand}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Content="加入当前帧" Appearance="Primary"
                                           Command="{Binding CaptureFrameCommand}" />
                                <ui:TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Text="拍摄建议 15~25 张，覆盖四角、姿态多样" />
                            </Grid>
                        </StackPanel>

                        <!-- 外参提示 -->
                        <StackPanel Style="{StaticResource PanelExtrinsic}">
                            <ui:TextBlock FontTypography="Subtitle" Text="九点标定点对" Margin="0,0,0,6" />
                            <ui:TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          TextWrapping="Wrap" Margin="0,0,0,8"
                                          Text="在图上依次点 9 个点（建议覆盖视场四角与中心），随后把示教器上的机器人坐标逐行抄入右两列。" />
                        </StackPanel>

                        <!-- 旋转中心提示 -->
                        <StackPanel Style="{StaticResource PanelRotation}">
                            <ui:TextBlock FontTypography="Subtitle" Text="多角度标记点" Margin="0,0,0,6" />
                            <ui:TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          TextWrapping="Wrap" Margin="0,0,0,8"
                                          Text="机器人第 4 轴每转一个角度取一次图并点选标记点；建议 5~9 个等间隔角度（如每 45°）。" />
                        </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- 点表（外参/旋转中心） -->
                    <Border Margin="0,0,0,8" Padding="6" MinHeight="150" MaxHeight="300"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding Clickable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Bottom" Margin="4,6,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="像素坐标不可编辑；外参模式的机器人坐标可编辑" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="删除末点" Command="{Binding RemoveLastPointCommand}" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding Points}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="34" />
                                    <DataGridTextColumn Header="像素X" Binding="{Binding PixelX, StringFormat=0.0}" IsReadOnly="True" Width="70" />
                                    <DataGridTextColumn Header="像素Y" Binding="{Binding PixelY, StringFormat=0.0}" IsReadOnly="True" Width="70" />
                                    <DataGridTextColumn Header="机器人X" Binding="{Binding RobotX, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                    <DataGridTextColumn Header="机器人Y" Binding="{Binding RobotY, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- 计算与保存 -->
                    <ui:Card Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Content="计算" Appearance="Primary" Command="{Binding ComputeCommand}" />
                                <TextBlock Grid.Column="1" Text="{Binding Result}" Margin="16,0,0,0"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Grid.Column="2" Content="保存档案" Command="{Binding SaveCommand}" />
                            </Grid>
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap"
                                          Text="保存写回 data/calibration 并立即加载进运行中的服务（无需重启）；覆盖已有档案前会确认。外参/旋转中心取图必须先完成内参标定。" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
