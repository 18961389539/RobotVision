<Page x:Class="RobotVision.UI.Pages.LightingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="光源管理"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：光源控制器列表 -->
        <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="光源控制器" FontTypography="BodyStrong" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="删除" Margin="8,0,0,0"
                               Command="{Binding DeleteCommand}" />
                    <ui:Button Grid.Column="2" Content="刷新" Margin="4,0,0,0"
                               Command="{Binding RefreshCommand}" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewId, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="新控制器 Id（字母/数字/_/-）" VerticalContentAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="110" Margin="6,0,0,0"
                                  ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding NewType}"
                                  VerticalContentAlignment="Center"
                                  ToolTip="控制器类型（来自工厂注册表，未注册类型不可添加）" />
                        <ui:Button Grid.Column="2" Content="添加" Margin="6,0,0,0"
                                   Command="{Binding AddCommand}" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2" Width="220">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Text="{Binding Id}" FontTypography="BodyStrong"
                                                      TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="3"
                                                Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type}" FontSize="10" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Registered}" Value="True">
                                                            <Setter Property="Foreground" Value="#4CC38A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding Status}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <ui:TextBlock Grid.Row="2" FontSize="11" Margin="4,8,4,4" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              Text="None = 无操作虚拟控制器（调试兜底，添加后写入 appsettings 的 LightControllers 段）；真实控制器类型由工厂注册表提供" />
            </Grid>
        </ui:Card>

        <!-- 右：手动调光 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="手动调光（作用于运行中的服务）" Margin="0,0,0,10" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="通道号（≥1）" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Channel}" Minimum="1" Maximum="64"
                                              SmallChange="1" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="亮度（0-255）" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Brightness}" Minimum="0" Maximum="255"
                                              SmallChange="5" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </UniformGrid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="亮度" VerticalAlignment="Center" Width="40" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="255"
                                    Value="{Binding Brightness}"
                                    IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"
                                    TickFrequency="32" TickPlacement="BottomRight"
                                    AutoToolTipPlacement="TopLeft" Margin="8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" Width="48"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Content="开灯" Appearance="Primary" Command="{Binding TurnOnCommand}" />
                            <ui:Button Grid.Column="1" Content="关灯" Margin="8,0,0,0"
                                       Command="{Binding TurnOffCommand}" />
                            <ui:TextBlock Grid.Column="2" FontSize="11" Margin="16,0,0,0"
                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          TextWrapping="Wrap" VerticalAlignment="Center"
                                          Text="开灯保持常亮，直到手动关灯或下一次取图周期点亮；调参确认后到配方编辑器把亮度写回配方" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 操作与状态 -->
                <ui:Card Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
