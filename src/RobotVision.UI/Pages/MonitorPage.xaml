<Page x:Class="RobotVision.UI.Pages.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ivc="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
      Title="运行监控"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <!-- 画面区：统一使用 ImageViewer 控件（缩放/平移/像素信息/测量） -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
            <Border Background="#1E1E1E" CornerRadius="4" ClipToBounds="True">
                <ivc:ImageViewer x:Name="Viewer" ImageSource="{Binding DisplayImage}" />
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#B0000000" CornerRadius="3" Padding="8,4" Margin="8"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding StatusText}" Foreground="White" />
            </Border>
        </Grid>

        <!-- 右侧控制面板 -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel>
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="相机" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Cameras}"
                                  SelectedItem="{Binding SelectedCamera}" />
                        <CheckBox Content="实时预览（0.5s/帧）"
                                  IsChecked="{Binding PreviewEnabled}" Margin="0,10,0,0" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="配方" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Recipes}"
                                      SelectedItem="{Binding SelectedRecipe}" />
                            <ui:Button Grid.Column="1" Content="刷新" Margin="8,0,0,0"
                                       Command="{Binding RefreshRecipesCommand}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="触发" Margin="0,0,0,8" />
                        <ui:Button Appearance="Primary"
                                   Content="手动触发（与机器人 TRIGGER 同链路）"
                                   FontSize="14"
                                   Command="{Binding TriggerCommand}" />
                        <ui:Button Appearance="Secondary" Content="恢复预览"
                                   Margin="0,8,0,0"
                                   Command="{Binding ResumePreviewCommand}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="结果（机器人坐标）" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Poses}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  MinHeight="120"
                                  EnableRowVirtualization="False"
                                  EnableColumnVirtualization="False"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="32" />
                                <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat=F3}" Width="*" />
                                <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat=F3}" Width="*" />
                                <DataGridTextColumn Header="角度 (°)" Binding="{Binding AngleDeg, StringFormat=F3}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部日志 -->
        <ui:Card Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" FontFamily="Consolas"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Time}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Run Text="{Binding Level}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Run Text="{Binding Message}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,4,0">
                    <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}"
                              VerticalAlignment="Center" />
                    <ui:Button Content="清空" Margin="12,0,0,0"
                               Command="{Binding ClearLogCommand}" />
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
