<Page x:Class="RobotVision.UI.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="关于"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="720">
            <ui:TextBlock FontTypography="Title" Text="RobotVision 视觉调试台" Margin="0,0,0,4" />
            <ui:TextBlock FontTypography="Body"
                          Text="机器人引导视觉系统 · C# / .NET 8 / OpenCvSharp / YoloDotNet"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

            <ui:Card Margin="0,0,0,8" Padding="12">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="功能" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" LineHeight="24"
                               Text="TCP 行协议服务（TRIGGER/PING）· 相机管理与实时预览 · 内参去畸变 · 三种角度策略（分割外接矩形/双模型中心连线/关键点连线）· 九点外参与旋转中心补偿 · 失败现场留存 · 滚动文件日志" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8" Padding="12">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="运行中的服务" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" LineHeight="24"
                               Text="本 UI 与控制台宿主共用同一套管线（RobotVision.Hosting）：TCP 端口、模型会话、标定档案实时生效。机器人/PLC 可直接通过 TCP:9999 连接本机触发。&#10;提示：同一端口仅允许一个宿主实例，UI 运行时请勿再启动控制台宿主。" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
