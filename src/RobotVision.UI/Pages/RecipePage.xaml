<Page x:Class="RobotVision.UI.Pages.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="配方管理"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：配方列表（可搜索） -->
        <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong" Text="配方" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="新建" Margin="8,0,0,0"
                               Command="{Binding NewCommand}" />
                    <ui:Button Grid.Column="2" Content="刷新" Margin="4,0,0,0"
                               Command="{Binding RefreshCommand}" />
                </Grid>
                <TextBox Grid.Row="1" Margin="4,0,4,6" Padding="6,4" FontSize="12"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="按名称或描述过滤" />
                <ListBox Grid.Row="2" ItemsSource="{Binding VisibleRecipes}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <!-- 已停用徽标 -->
                                    <Border Margin="6,2,0,0" Padding="4,1" CornerRadius="3"
                                            Background="{DynamicResource SystemFillColorCautionBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="已停用" FontSize="9" Foreground="Black" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Summary}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="4,8,4,4">
                    <TextBlock Text="{Binding UnsavedHint}" FontSize="11" TextWrapping="Wrap"
                               Foreground="#E8A33D" Margin="0,0,0,6"
                               Visibility="{Binding HasUnsavedChanges,
                                   Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ui:Button Content="打开配方目录" Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 右：编辑表单 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="基本信息" Margin="0,0,0,10" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="名称（字母/数字/_/-）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNew}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="相机" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding CameraIds}"
                                          SelectedItem="{Binding Editor.CameraId}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="工位 Id（外参档案，下拉选择）" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding StationIds}"
                                          SelectedItem="{Binding Editor.StationId, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom">
                                <CheckBox Content="台架调试直通（无外参时返回像素坐标）"
                                          IsChecked="{Binding Editor.DebugPassthrough}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="描述（备注，不参与推理）" Margin="0,4,0,4" />
                        <TextBox Text="{Binding Editor.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" MinHeight="52" TextWrapping="Wrap" />
                        <CheckBox Content="启用该配方（取消后触发返回 1001，文件保留）" Margin="0,10,0,0"
                                  IsChecked="{Binding Editor.Enabled}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="推理与角度" Margin="0,0,0,10" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="角度模式" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AngleModeOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Editor.AngleMode}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="旋转中心补偿" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding RotationOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Editor.RotationCompensation}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="主模型文件（models 目录 .onnx）" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ModelFiles}"
                                          SelectedItem="{Binding PrimaryModel, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="次模型（仅双模型模式）" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ModelFiles}"
                                          SelectedItem="{Binding SecondaryModel, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" />
                            </StackPanel>
                        </UniformGrid>

                        <Separator Margin="0,4,0,10" />

                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="检测置信度" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Editor.Confidence}"
                                              Minimum="0" Maximum="1" SmallChange="0.05"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="IoU 阈值" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Editor.Iou}"
                                              Minimum="0" Maximum="1" SmallChange="0.05"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="掩码像素置信度" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Editor.PixelConfidence}"
                                              Minimum="0" Maximum="1" SmallChange="0.05"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="关键点最低置信度" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Editor.KeypointMinConfidence}"
                                              Minimum="0" Maximum="1" SmallChange="0.05"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="关键点 A 索引" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Editor.KeypointIndexA}"
                                              Minimum="0" Maximum="64" SmallChange="1"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="关键点 B 索引" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Editor.KeypointIndexB}"
                                              Minimum="0" Maximum="64" SmallChange="1"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,8">
                                <TextBlock Text="双模型配对最大距离 (px)" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Editor.PairingMaxDistancePx}"
                                              Minimum="1" Maximum="100000" SmallChange="50"
                                              SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ui:Card>

                <!-- 光源（取图前点亮，可选） -->
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="Subtitle" Text="检测区域（ROI）" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Content="启用检测区域（缺省全图推理）"
                                      IsChecked="{Binding UseRoi}" Margin="16,0,0,0"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Border Padding="12,10" CornerRadius="6" Margin="0,6,0,0"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Visibility="{Binding UseRoi, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="X（左上角，0~1 相对比例）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding RoiX}" Minimum="0" Maximum="1"
                                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="Y（左上角，0~1 相对比例）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding RoiY}" Minimum="0" Maximum="1"
                                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="宽度（0~1 相对比例）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding RoiWidth}" Minimum="0.01" Maximum="1"
                                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="高度（0~1 相对比例）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding RoiHeight}" Minimum="0.01" Maximum="1"
                                                      SmallChange="0.01" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </UniformGrid>
                                <ui:TextBlock FontSize="11"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Margin="0,6,0,0"
                                              Text="相对比例随分辨率自适应；仅在区域内推理，大图上局部检测可显著降低 CPU 耗时，结果坐标自动偏移回全图" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="Subtitle" Text="光源" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Content="启用光源（取图前点亮，缺省不亮灯）"
                                      IsChecked="{Binding UseLighting}" Margin="16,0,0,0"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Border Padding="12,10" CornerRadius="6" Margin="0,6,0,0"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Visibility="{Binding UseLighting, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="光源控制器" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding LightControllerIds}"
                                                  SelectedItem="{Binding SelectedLightControllerId,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="通道号（≥1）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding LightChannel}"
                                                      Minimum="1" Maximum="64" SmallChange="1"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="亮度（0-255）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding LightBrightness}"
                                                      Minimum="0" Maximum="255" SmallChange="5"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="稳定延时（ms）" Margin="0,0,0,4" />
                                        <ui:NumberBox Value="{Binding LightStabilizeDelayMs}"
                                                      Minimum="0" Maximum="10000" SmallChange="5"
                                                      SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Content="取图完成后熄灯（常亮场景可取消勾选，减少每帧开关灯抖动）"
                                          IsChecked="{Binding LightTurnOffAfterGrab}" Margin="0,4,0,0" />
                                <ui:TextBlock FontSize="11"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Margin="0,6,0,0"
                                              Text="时序：TRIGGER → 点亮 → 稳定延时 → 取图 → 按配置熄灯；延时计入超时预算。未配置任何控制器时选 None 类型兜底。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- 操作与状态 -->
                <ui:Card Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="保存" Appearance="Primary"
                                   Command="{Binding SaveCommand}" />
                        <ui:Button Grid.Column="1" Content="测试触发" Margin="8,0,0,0"
                                   Command="{Binding TestTriggerCommand}"
                                   ToolTip="用磁盘上的配方跑一次完整链路（取图→去畸变→推理→外参）" />
                        <ui:Button Grid.Column="2" Content="复制为新配方" Margin="8,0,0,0"
                                   Command="{Binding CopyCommand}" />
                        <ui:Button Grid.Column="3" Content="删除" Margin="8,0,0,0"
                                   Command="{Binding DeleteCommand}" />
                        <TextBlock Grid.Column="4" Text="{Binding Message}" Margin="16,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
