<Page x:Class="RobotVision.UI.Pages.ModelsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="模型管理"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="380" />
            <ColumnDefinition Width="1.6*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- 左：模型文件列表 -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong" Text="ONNX 模型" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="16,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" />
                    <ui:Button Grid.Column="3" Content="打开模型目录" Margin="8,0,0,0"
                               Command="{Binding OpenFolderCommand}" />
                </Grid>
            </ui:Card>

            <!-- Wpf.Ui Card 模板将内容垂直居中，表格改用 Border 以填满剩余空间 -->
            <Border Grid.Row="1" Padding="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4">
                <DataGrid ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="80" />
                        <DataGridTextColumn Header="推理会话" Binding="{Binding LoadedText}" Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- 右：测试推理 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Text="测试推理" Margin="0,0,0,10" />
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="模型" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedFile.Name, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="推理任务" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding TaskOptions}" SelectedItem="{Binding SelectedTask}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="IoU 阈值" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Iou}" Minimum="0.01" Maximum="0.99"
                                              SmallChange="0.05" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="置信度阈值" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding Confidence}" Minimum="0.01" Maximum="0.99"
                                              SmallChange="0.05" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="像素阈值（分割）" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding PixelConfidence}" Minimum="0.01" Maximum="0.99"
                                              SmallChange="0.05" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="测试图片" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding TestImagePath, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0"
                                           Command="{Binding BrowseTestImageCommand}" />
                            </Grid>
                            <ui:TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Margin="0,6,0,0"
                                          Text="不经过配方/相机/标定链路，直接验证模型输出；与产线共享会话缓存，互不并发" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Content="开始推理" Appearance="Primary"
                                       Command="{Binding RunTestCommand}" />
                            <ui:Button Grid.Column="1" Content="取消" Margin="8,0,0,0"
                                       Command="{Binding CancelTestCommand}"
                                       Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="12">
                    <StackPanel>
                        <ui:TextBlock Text="{Binding TestResult}" FontTypography="BodyStrong"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Border Background="#1E1E1E" CornerRadius="3" MinHeight="260" MaxHeight="520"
                                Padding="4">
                            <Image Source="{Binding ResultImage}" Stretch="Uniform" />
                        </Border>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
