<Page x:Class="RobotVision.UI.Pages.SystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="系统信息"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <ui:Card Margin="0,0,0,8" Padding="12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="运行状态" Margin="0,0,0,10" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,10,4">
                            <TextBlock Text="TCP 服务" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding TcpStatus}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,4">
                            <TextBlock Text="推理管线" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding QueueStatus}" />
                            <TextBlock Text="{Binding HealthStatus}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="资产" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding RecipeStatus}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8" Padding="12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="数据目录（点击行末按钮打开）" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Directories}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Key}" Width="120" />
                            <DataGridTextColumn Header="路径" Binding="{Binding Value}" Width="*" />
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="打开" FontSize="12"
                                                   CommandParameter="{Binding}"
                                                   Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8" Padding="12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="配置摘要（可修改项见「服务设置」页）"
                                  Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Settings}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项" Binding="{Binding Key}" Width="160" />
                            <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="相机资产（配置全部相机，未注册项橙色标出）"
                                  Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding CameraBadges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,3" Margin="0,0,8,4"
                                        Background="#33FFFFFF" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="未注册" FontSize="10" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Foreground="#E8A33D">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Registered}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
