<?xml version="1.0" encoding="utf-8"?>
<!--
  可选本地串行配置（CI 已改用 [Collection("Serial")]，无需再全局串行）。
  本地若仍遇偶发竞态，可：dotnet test --settings tests/serial.runsettings
-->
<RunSettings>
  <xUnit>
    <MaxParallelThreads>1</MaxParallelThreads>
    <ParallelizeTestCollections>false</ParallelizeTestCollections>
  </xUnit>
</RunSettings>
