<Project>
  <!--
    Central Package Management（CPM）：所有包版本在此集中声明，项目 csproj 只写 PackageReference。
    升级依赖只改本文件一处。开启方式：根 Directory.Packages.props 存在即自动启用。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- 视觉与推理 -->
    <PackageVersion Include="OpenCvSharp4" Version="4.10.0.20240615" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240615" />
    <PackageVersion Include="YoloDotNet" Version="4.2.0" />
    <PackageVersion Include="YoloDotNet.ExecutionProvider.OpenVino" Version="1.1.0" />
    <PackageVersion Include="Intel.ML.OnnxRuntime.OpenVino" Version="1.22.0" />
    <PackageVersion Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />

    <!-- 相机硬件 -->
    <PackageVersion Include="Basler.Pylon.NET.x64" Version="10.3.2.636" />
    <PackageVersion Include="GigEVision.Net" Version="1.0.0" />
    <PackageVersion Include="LDVisionCamera.Net" Version="1.0.0-rc.37" />

    <!-- Microsoft.Extensions（net10 统一 10.0.x 线；GigEVision.Net 要求的 Abstractions>=10.0.5 亦满足） -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />

    <!-- 日志 -->
    <PackageVersion Include="Serilog" Version="4.0.2" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- UI -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageVersion Include="WPF-UI" Version="3.1.1" />
    <PackageVersion Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />

    <!-- 对话 markdown 渲染（纯解析，MIT） -->
    <PackageVersion Include="Markdig" Version="0.38.0" />

    <!-- 硬件：串口 -->
    <PackageVersion Include="System.IO.Ports" Version="8.0.0" />
    <!-- FlaUI 等传递依赖会拉到 5.0.2（GHSA-rxg9-xrhp-64gj）；测试项目显式引用以覆盖。 -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.11" />

    <!-- 本机结果库（分析/追溯；不引入 EF） -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />

    <!-- 测试 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="NSubstitute" Version="5.1.0" />
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />

    <!-- 基准测试 -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />

    <!-- UI 自动化 -->
    <PackageVersion Include="FlaUI.Core" Version="4.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.4.13" />

    <!-- JLVisionLib 发布混淆（仅 Release 目标使用） -->
    <PackageVersion Include="Obfuscar" Version="2.2.49" />
  </ItemGroup>
</Project>
