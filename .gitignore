bin/
obj/
*.user
.vs/
TestResults/
[Ll]ogs/
# 注意:上方模式会吞掉任意深度的 Logs/logs 目录(曾误杀 src/.../Features/Logs 导致克隆编译失败)
# 源码中的 Logs 功能目录必须入库,以下规则显式放行
!src/**/Logs/
!tests/**/Logs/

# AI 会话草稿（UI 截图、评审记录、方案提案）
artifacts/

# WorkBuddy 项目记忆/状态目录（本地工具数据，不入库）
.workbuddy/

# 运行数据：回放图片与失败现场不入库；标定档案是产线正确性资产，入库跟踪
data/*
!data/calibration/
!data/calibration/**
models/*.onnx

# OpenVINO 编译缓存（exe 旁 ovcache/）
ovcache/

# CodeGraph 本地索引数据库（工具数据，不入库）
.codegraph/

# 本地构建输出（--artifacts-path 重定向目录）与测试诊断日志，不入库
.build-*/
crash_diag*.txt

# BenchmarkDotNet 产物（基准测试结果/日志，自动生成，不入库）
BenchmarkDotNet.Artifacts/

# 根目录恢复/补丁脚本（工具临时产物，不入库）
/_*.js
/_*.txt
/_recovered/
/_recovered_full/
/_recovered_maskcaliper/
/build-*.txt

# 本机开发覆盖（从 appsettings.Development.json.example 复制）
appsettings.Development.json

